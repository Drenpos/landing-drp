---
export const prerender = true;
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import ClientLogosStrip from "@/partials/ClientLogosStrip.astro";
import DemoForm from "@/partials/DemoForm.astro";
import LandingMeta from "@/partials/LandingMeta.astro";
import { existsSync } from "node:fs";
import { join } from "node:path";

const hasImg = (p: string) => existsSync(join(process.cwd(), "public", p));

// ════════════════════════════════════════════════════════════════════════
//  DeCA · documento electrónico de control administrativo del transporte
//  Landing de cumplimiento legal (misma estructura que /software-verifactu)
//  Intención de búsqueda objetivo:
//    - "DeCA transporte" / "documento electrónico de control administrativo"
//    - "documento de control digital transporte" / "documento de control 5 octubre 2026"
//    - "generar DeCA desde albarán" / "DeCA ERP" / "software DeCA"
//  Ángulo propio: el cargador contractual (la empresa que vende y contrata
//  el porte) que ya emite albaranes en su ERP.
//  Fuentes: notas de investigación del 28/09/2026 (BOE, transportes.gob.es).
//  Producto: products_modules.md, sección DeCA del módulo Financiero.
//  Capturas pendientes (se muestran solas cuando existan en /public):
//    images/funcionalidades/deca/01-albaran-activar-deca.png (1280×800)
//    images/funcionalidades/deca/02-pdf-control-qr.png (1280×800)
// ════════════════════════════════════════════════════════════════════════

const CANONICAL = "https://www.drenpos.com/documento-control-transporte-deca";

const IMG_ALBARAN = "/images/funcionalidades/deca/01-albaran-activar-deca.png";
const IMG_PDF = "/images/funcionalidades/deca/02-pdf-control-qr.png";
const showAlbaranImg = hasImg(IMG_ALBARAN);
const showPdfImg = hasImg(IMG_PDF);
const OG_FALLBACK = "/images/blog/etiqueta-sscc-gs1-palets/cover.jpg";
const OG_IMG = showPdfImg ? IMG_PDF : OG_FALLBACK;

// Fuentes oficiales
const ORDEN_URL = "https://www.boe.es/buscar/act.php?id=BOE-A-2013-154";
const LEY_URL = "https://www.boe.es/buscar/act.php?id=BOE-A-2025-24545&tn=1&p=20251204#dt-8";
const RES_URL = "https://www.boe.es/diario_boe/txt.php?id=BOE-A-2026-12784";
const LOTT_URL = "https://www.boe.es/buscar/act.php?id=BOE-A-1987-17803";
const MIN_URL =
  "https://www.transportes.gob.es/transporte-terrestre/profesionales-transporte/servicios-transportista/documento-electronico-control-administrativo-deca";
const FAQ_MIN_URL =
  "https://www.transportes.gob.es/transporte-terrestre/profesionales-transporte/servicios-transportista/documento-electronico-control-administrativo-deca/preguntas-frecuentes-faq-deca";
const EMPRESAS_URL =
  "https://www.cadenadesuministro.es/transporte-carretera/transporte-mercancias-por-carretera-gana-casi-1300-empresas-en-agosto-2026_1518197_102.html";
const OBSERVATORIO_URL =
  "https://cdn.transportes.gob.es/portal-web-transportes/transporte-terrestre/servicios_transportista/observatorio-mercacnias-carretera/observatorio-mercancias-oferta-y-demanda_2026-01_vaccv2.pdf";
const TARIFA_DOC_URL = "https://www.controldigitaltransporte.es/";
const TARIFA_MES_URL = "https://pretiumgestion.com/documento-control-digital/";
const FENADISMER_PRECIOS_URL =
  "https://transporte3.com/noticia/24424-nuevo-documento-electronico-de-control-administrativo-deca-ojo-con-las-ofertas-claramente-abusivas/";

// Requisitos de la Resolución de 5 de junio de 2026 (solo lo verificado en el BOE)
const requisitos = [
  {
    icon: "📄",
    title: "PDF generado desde los datos",
    body: "El fichero tiene que salir de los datos del programa, no de escanear un papel ni de una foto. Formato PDF de 5 MB como máximo, con la fecha y hora de creación y de modificación guardadas como metadatos del propio PDF.",
  },
  {
    icon: "🔳",
    title: "QR con una dirección web única",
    body: "Dentro del PDF va un código QR con la URL de ese documento. Tiene que empezar por https:// y descargar el PDF directamente: sin usuario, sin contraseña y sin botones que pulsar.",
  },
  {
    icon: "⏱️",
    title: "Creado antes de salir",
    body: "El documento se crea antes del inicio efectivo del servicio. Para demostrarlo, el programa registra la fecha y hora de creación del fichero, y también la de cada modificación.",
  },
  {
    icon: "📱",
    title: "Copia al conductor antes de arrancar",
    body: "El conductor lleva una copia en el móvil o en papel, siempre con el QR. En un control puede enseñar el documento o solo el QR. Lo que se escriba a mano en la copia impresa no cuenta.",
  },
  {
    icon: "🔁",
    title: "Cambios sin borrar lo anterior",
    body: "Si algo cambia en ruta, se añaden los datos nuevos y el motivo conservando los antiguos marcados como no válidos (misma URL), o se genera un PDF nuevo con otra URL guardando el original. En los dos casos, el conductor recibe el PDF actualizado.",
  },
  {
    icon: "🗄️",
    title: "Un año guardado",
    body: "Cargador contractual y transportista efectivo conservan los ficheros al menos un año. Si uno de los dos lo generó, basta con que el otro pueda descargarlo durante ese año.",
  },
  {
    icon: "🧾",
    title: "Los ocho datos del artículo 6",
    body: "El contenido mínimo es el de siempre, el del artículo 6 de la Orden FOM/2861/2012: cargador, transportista, origen y destino, mercancía y peso, autorización especial, fecha, matrículas y observaciones.",
  },
  {
    icon: "🏷️",
    title: "Cargador y transportista bien separados",
    body: "Vale cualquier formato de documento de transporte (albarán, carta de porte…) si lleva todos esos datos y deja identificados de forma expresa y diferenciada al cargador contractual y al transportista efectivo.",
  },
];

// Artículo 6 de la Orden FOM/2861/2012 y quién responde de cada dato (art. 7)
const apartados = [
  { l: "a", dato: "Nombre o razón social, NIF y domicilio del cargador contractual", responde: "Cargador contractual" },
  { l: "b", dato: "Nombre o razón social y NIF del transportista efectivo", responde: "Cargador contractual" },
  { l: "c", dato: "Lugar de origen y de destino del envío", responde: "Cargador contractual" },
  { l: "d", dato: "Naturaleza y peso de la mercancía (si el peso exacto es difícil de saber, otra magnitud)", responde: "Cargador contractual" },
  { l: "e", dato: "Autorización especial de circulación, cuando el vehículo la necesite", responde: "Transportista efectivo" },
  { l: "f", dato: "Fecha de realización del transporte", responde: "Transportista efectivo" },
  { l: "g", dato: "Matrícula del vehículo; en un conjunto articulado, la del tractor y la del semirremolque o remolque", responde: "Transportista efectivo" },
  { l: "h", dato: "Observaciones, reservas o indicaciones que pidan las partes", responde: "Quien las incluya" },
];

// Cómo se genera en Drenpos (products_modules.md, sección DeCA)
const pasos = [
  {
    n: "1",
    title: "Haces el albarán como siempre",
    body: "Con tu cliente, sus direcciones y sus líneas. Si el cliente tiene transportista por defecto (compañía, conductor y vehículo), entra solo, y el peso del documento se calcula con el de cada artículo.",
  },
  {
    n: "2",
    title: "Pulsas «Activar DeCA»",
    body: "Un botón en el albarán de venta. Activarlo pide un permiso específico y es irreversible: una vez activado, el documento de control ya no se quita.",
  },
  {
    n: "3",
    title: "El sistema te dice qué falta",
    body: "Comprueba los datos que exige la norma (cargador con NIF y domicilio, transportista con NIF, origen, destino, mercancía y peso, fecha, matrícula y remolque, autorización especial si la hay) y te avisa de lo que falta para completarlo ahí mismo.",
  },
  {
    n: "4",
    title: "Sale el PDF oficial con su QR",
    body: "Una página de control con los ocho apartados rotulados y, detrás, el albarán con el formato de siempre. El QR lleva a una dirección web única desde la que se descarga el PDF sin usuario ni contraseña.",
  },
  {
    n: "5",
    title: "El conductor se lleva la copia",
    body: "El QR sale también en todos los formatos de albarán y en el modelo de carta de porte, así que la copia en papel ya vale. Desde el albarán ves el PDF, copias la dirección, descargas el QR suelto o lo imprimes.",
  },
  {
    n: "6",
    title: "Si algo cambia, versión nueva",
    body: "Otra matrícula u otro peso generan una versión nueva con la misma dirección web y el historial de cambios con su motivo. Si anulas el albarán, el documento lo indica. Nada se borra y todo se conserva el año que exige la ley.",
  },
];

// Qué incluye, en formato ficha (AEO)
const ficha = [
  { k: "Dónde", v: "En el albarán de venta, con el botón «Activar DeCA». Sin plataforma externa ni programa aparte" },
  { k: "Comprobación", v: "Revisa los datos del artículo 6 de la Orden FOM/2861/2012 y avisa de lo que falta antes de generar" },
  { k: "Documento", v: "PDF con la página de control (los ocho apartados rotulados) seguida del albarán con su formato habitual" },
  { k: "QR", v: "Dirección web única de descarga directa, sin usuario ni contraseña. También sale en los formatos de albarán y en la carta de porte" },
  { k: "Cambios", v: "Versión nueva con la misma dirección web e historial de cambios con su motivo. El albarán anulado queda indicado" },
  { k: "Control", v: "Activarlo requiere un permiso específico y no se puede deshacer" },
  { k: "Conservación", v: "Nada se borra: se conserva el tiempo que exige la ley, al menos un año" },
  { k: "Precio", v: "Incluido en el módulo Financiero sin coste extra. Todos los planes, desde 19 €/mes sin IVA" },
];

const obligados = [
  {
    title: "Transportista efectivo",
    body: "La empresa o el autónomo titular de la autorización con la que se hace el transporte. Responde de la autorización especial, la fecha y las matrículas.",
  },
  {
    title: "Cargador contractual",
    body: "Quien contrata directamente el porte con el transportista: la empresa que vende y envía su mercancía, pero también una cooperativa, un almacenista distribuidor, un operador logístico, una agencia o un transitario. Responde de sus datos, los del transportista, origen, destino, mercancía y peso.",
  },
  {
    title: "El transportista que subcontrata",
    body: "Si un transportista pasa el servicio a otro, el que subcontrata se convierte en cargador contractual y el que lo hace, en transportista efectivo.",
  },
];

const excluidos = [
  "Transporte privado complementario: repartes tu mercancía con tus propios vehículos y tu actividad no es el transporte.",
  "Paquetería y envíos de pocos bultos que una persona manipula sola.",
  "Mudanzas.",
  "Vehículos accidentados o averiados llevados en vehículos especiales.",
  "Transportes que no necesitan autorización.",
  "Transporte internacional: sigue con el CMR de los convenios. El cabotaje dentro de España sí entra.",
];

const sanciones = [
  {
    hecho: "No llevar el documento de control, llevarlo sin datos esenciales, ocultarlo o no conservarlo",
    tipo: "Grave (art. 141.17 LOTT)",
    multa: "401 a 600 € (art. 143.1.d)",
    href: `${LOTT_URL}#a141`,
  },
  {
    hecho: "Circular sin la documentación formal exigible, cuando no encaja como grave o muy grave",
    tipo: "Leve (art. 142.8 LOTT)",
    multa: "201 a 300 € (art. 143.1.b)",
    href: `${LOTT_URL}#a142`,
  },
  {
    hecho: "Varias expediciones sin documento",
    tipo: "Una infracción por expedición (art. 138.3 LOTT)",
    multa: "Cada envío se sanciona aparte",
    href: `${LOTT_URL}#a138`,
  },
];

// Comparativa de decisión (AEO), sin marcas
const comparativa = [
  {
    opcion: "Albarán en papel o PDF escaneado",
    vale: "No: la Resolución exige un PDF generado desde los datos y con QR",
    datos: "Los que tenga el papel",
    coste: "Sin coste, con riesgo de 401 a 600 € por expedición",
  },
  {
    opcion: "Plataforma externa de DeCA",
    vale: "Sí, si cumple la Resolución",
    datos: "Vuelves a teclear lo que ya está en el albarán, o pagas una integración",
    coste: "Pago por documento o cuota mensual (ver fuentes debajo)",
  },
  {
    opcion: "Desde el albarán en Drenpos",
    vale: "Sí, con el PDF oficial y su QR",
    datos: "Los del albarán: cliente, direcciones, líneas, peso y transportista",
    coste: "Incluido en el módulo Financiero, sin coste extra",
    destacado: true,
  },
];

const casos = [
  {
    tag: "Distribución de alimentación",
    icon: "🚚",
    title: "Vendes a tiendas y contratas los portes",
    body: "Tus albaranes ya llevan cliente, dirección de entrega y líneas con peso. Asignas a cada cliente su transportista por defecto, activas el DeCA en los albaranes que viajan con él y el conductor se lleva el albarán impreso con su QR. Los repartos que haces con tu propia furgoneta siguen igual, sin DeCA.",
  },
  {
    tag: "Cooperativa o almacén agrícola",
    icon: "🌾",
    title: "Palets que salen con un conductor distinto cada día",
    body: "La Orden cita expresamente a las cooperativas entre los cargadores contractuales. Escaneas los palets con su SSCC en el albarán, el peso del documento se calcula con el de los artículos, identificas al conductor y la matrícula del día y el QR va impreso también en la carta de porte.",
  },
  {
    tag: "Frigorífico con depósito",
    icon: "❄️",
    title: "Salidas de mercancía de tus depositantes",
    body: "Si el porte lo contrata tu cliente, el DeCA le toca a él y a su transportista, no a ti. Si el transporte lo contratas tú, lo generas desde el albarán de venta, con el peso ya calculado y la matrícula del camión que carga en tu muelle.",
  },
];

const faqs = [
  {
    q: "¿Qué es el DeCA?",
    a: "El DeCA es el documento electrónico de control administrativo que acompaña cada envío de transporte público de mercancías por carretera dentro de España. Es el documento de control de la Orden FOM/2861/2012 en formato digital: un PDF generado desde los datos, con un código QR que lleva a una dirección web única desde la que la inspección lo descarga. Es obligatorio desde el 5 de octubre de 2026 y los requisitos técnicos están en la Resolución de 5 de junio de 2026.",
  },
  {
    q: "¿Desde cuándo es obligatorio el documento de control digital?",
    a: "Desde el 5 de octubre de 2026. La disposición transitoria octava de la Ley 9/2025 de Movilidad Sostenible dice que el documento de control será necesariamente digital a los diez meses de su entrada en vigor, que fue el 5 de diciembre de 2025. El Ministerio de Transportes confirma en su página de preguntas frecuentes que no hay un periodo transitorio adicional sin sanciones.",
  },
  {
    q: "¿Me afecta si reparto con mis propias furgonetas?",
    a: "No, si es transporte privado complementario: repartes tu propia mercancía con vehículos de tu empresa y tu actividad principal no es el transporte. El DeCA se exige en el transporte público, cuando contratas a un transportista con autorización. Eso sí, en el privado complementario hay que llevar la documentación que acredita que la mercancía es tuya y que el vehículo y el conductor están vinculados a la empresa.",
  },
  {
    q: "¿Vale mi albarán como documento de control?",
    a: "Sí, si lleva los ocho datos del artículo 6 de la Orden FOM/2861/2012, identifica de forma expresa y diferenciada al cargador contractual y al transportista efectivo, y desde el 5 de octubre de 2026 se genera como PDF desde los datos con un QR de descarga directa. Un albarán en papel o un PDF escaneado ya no sirve. En Drenpos, el albarán con el DeCA activado sale con la página de control y el QR.",
  },
  {
    q: "¿Qué pasa si cambia la matrícula en ruta?",
    a: "Hay que dejarlo reflejado y hacer llegar el PDF actualizado al conductor. La Resolución admite dos vías: añadir los datos nuevos y el motivo en el mismo PDF, conservando los antiguos marcados como no válidos, o generar un PDF nuevo con otra URL guardando el original. En Drenpos se genera una versión nueva con la misma dirección web y el historial de cambios con su motivo, así que el QR que ya lleva el conductor sigue valiendo.",
  },
  {
    q: "¿Hay que firmar el DeCA?",
    a: "No. La propia Resolución de 5 de junio de 2026 explica que la firma no es obligatoria, porque ni la Orden FOM/2861/2012 ni la de transporte de viajeros la exigen. Solo si el documento se usa además como contrato entre las partes tiene que llevar, como mínimo, firma electrónica avanzada.",
  },
  {
    q: "¿Cuánto tiempo hay que guardar el documento de control?",
    a: "Al menos un año, tanto el cargador contractual como el transportista efectivo. Si lo generó uno de los dos, basta con que el otro pueda descargarlo durante ese año. La descarga desde el QR para la inspección se puede desactivar a los siete días naturales de terminar el servicio, pero el fichero se sigue conservando. En Drenpos no se borra nada.",
  },
  {
    q: "¿Cuánto cuesta el DeCA en Drenpos?",
    a: "Nada aparte. Va incluido en el módulo Financiero, que está en todos los planes: Esencial desde 19 €/mes sin IVA, Pro 29 €/mes y Full 39 €/mes, sin permanencia. No hay pago por documento ni cuota de una plataforma externa.",
  },
  {
    q: "¿Necesito una aplicación o un registro del Ministerio?",
    a: "No. El Ministerio de Transportes no ofrece una aplicación propia de DeCA ni certifica aplicaciones, y la Resolución de 2026 eliminó la comunicación previa del dominio donde se guardan los documentos. Cualquier programa que cumpla los requisitos técnicos sirve, también tu ERP si genera el PDF con su QR.",
  },
  {
    q: "¿Sirve para transporte internacional?",
    a: "No hace falta. El transporte internacional sigue usando los documentos de los convenios que ha firmado España, es decir, el CMR, y el Ministerio aclara que el eCMR no es obligatorio. El DeCA es para el transporte interior, incluido el cabotaje que hace un transportista extranjero dentro de España.",
  },
];

// ── Datos estructurados (JSON-LD) ──────────────────────────────────────
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: "https://www.drenpos.com/" },
    { "@type": "ListItem", position: 2, name: "Funcionalidades", item: "https://www.drenpos.com/funcionalidades" },
    { "@type": "ListItem", position: 3, name: "Documento de control del transporte (DeCA)", item: CANONICAL },
  ],
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Drenpos · DeCA desde el albarán",
  url: CANONICAL,
  applicationCategory: "BusinessApplication",
  applicationSubCategory: "Documento electrónico de control administrativo del transporte",
  operatingSystem: "Web (navegador)",
  image: [`https://www.drenpos.com${OG_IMG}`],
  description:
    "Generación del documento electrónico de control administrativo (DeCA) del transporte de mercancías por carretera desde el albarán de venta, obligatorio en España desde el 5 de octubre de 2026: comprobación de los datos del artículo 6 de la Orden FOM/2861/2012, PDF con página de control y código QR de descarga directa en una dirección web única, QR también en los formatos de albarán y carta de porte, versiones con historial y motivo, y conservación. Incluido en el módulo Financiero sin coste extra.",
  publisher: { "@type": "Organization", name: "Drenpos Tech SL", url: "https://www.drenpos.com" },
  inLanguage: "es-ES",
  featureList: [
    "Botón «Activar DeCA» en el albarán de venta",
    "Comprobación de los datos del artículo 6 de la Orden FOM/2861/2012",
    "PDF con página de control de ocho apartados y el albarán",
    "Código QR con dirección web única de descarga directa",
    "QR en los formatos de albarán y en la carta de porte",
    "Versiones con historial de cambios y motivo",
    "Albarán anulado indicado en el documento",
    "Activación con permiso específico e irreversible",
  ],
  offers: {
    "@type": "Offer",
    price: "19.00",
    priceCurrency: "EUR",
    priceValidUntil: "2027-12-31",
    availability: "https://schema.org/InStock",
    url: "https://www.drenpos.com/pricing",
    valueAddedTaxIncluded: false,
    description: "DeCA incluido sin coste extra en el módulo Financiero, presente en todos los planes. Plan Esencial desde 19 €/mes sin IVA, sin permanencia.",
    seller: { "@type": "Organization", name: "Drenpos Tech SL" },
  },
};


// Fechas visibles (LandingMeta) y del JSON-LD (WebPage.datePublished / dateModified).
// Publicación = primer commit de la página; actualización = último cambio de contenido.
const PAGE_PUBLISHED = "2026-09-28";
const PAGE_UPDATED = "2026-10-07";
---

<Base
  title="Documento de control del transporte (DeCA) · Drenpos"
  meta_title="DeCA: documento de control del transporte digital | Drenpos"
  description="Genera el DeCA desde el albarán de venta: PDF con QR de descarga directa, versiones con historial y copia para el conductor. Obligatorio el 5/10/2026."
  canonical={CANONICAL}
  image={OG_IMG}
  published_date={PAGE_PUBLISHED}
  modified_date={PAGE_UPDATED}
  author={{ name: "Alonso Bermejo Pérez", url: "/about", jobTitle: "CEO & Founder" }}
>
  <!-- Datos estructurados -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ═══════════════════════════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section-sm pb-0 relative z-10 overflow-hidden">
    <div class="absolute inset-0 z-0 pointer-events-none">
      <img src="/images/grainy.svg" alt="" width="1440" height="900" class="w-full h-full object-cover opacity-[.08]" />
    </div>

    <div class="container relative z-10">
      <nav aria-label="Migas de pan" class="mb-6 text-sm" style="color: rgba(16,25,40,0.55);">
        <a href="/" class="hover:text-primary">Inicio</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <a href="/funcionalidades" class="hover:text-primary">Funcionalidades</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-primary font-medium">Documento de control (DeCA)</span>
      </nav>

      <div class="row gx-0 gy-12 lg:gy-0 items-center">
        <div class="lg:col-6" data-aos="fade-up-sm">
          <span class="text-primary bg-primary/10 px-4 py-1.5 inline-flex items-center gap-2 rounded-full uppercase text-sm font-medium mb-6">
