---
export const prerender = true;
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";

// ════════════════════════════════════════════════════════════════════════
//  Software de gestión de almacén · landing dedicada (SEO/AEO/GEO 2026)
//  Intención de búsqueda objetivo:
//    - "software de gestión de almacén" / "programa gestión almacén y stock"
//    - "SGA para pymes" (hueco: SGA enterprise vs. inventario básico pyme)
//    - long-tail: trazabilidad de lotes, FEFO caducidades, multialmacén,
//      pistola lectora, control de stock, roturas de stock
//  Diferenciación con /software-almacen-tienda: esa ataca retail+TPV;
//  esta ataca almacén puro / distribución / SGA.
//  Imágenes UI: /public/images/funcionalidades/almacen-tienda/
// ════════════════════════════════════════════════════════════════════════

const CANONICAL = "https://www.drenpos.com/software-gestion-almacen";

// Síntomas (dolores que busca el usuario — long-tail AEO)
const sintomas = [
  {
    icon: "📉",
    title: "El stock del sistema no cuadra con el de la estantería",
    body: "Vendes lo que no tienes o pides lo que ya tenías. Cada descuadre es una venta perdida o capital inmovilizado.",
  },
  {
    icon: "🔍",
    title: "Encontrar una referencia depende de la memoria de alguien",
    body: "Si la persona que 'sabe dónde está todo' falta un día, el almacén se para. El conocimiento está en cabezas, no en el sistema.",
  },
  {
    icon: "🗓️",
    title: "Productos caducados en la estantería",
    body: "Sin control de caducidades por lote, la merma se descubre cuando ya es pérdida — o peor, cuando el producto ya está vendido.",
  },
  {
    icon: "⏸️",
    title: "Inventariar significa parar el negocio",
    body: "Cierras un día entero (o un fin de semana) para contar. Y a los dos meses, el descuadre ha vuelto.",
  },
];

// Capacidades (mapeadas 1:1 a producto real)
const capacidades = [
  {
    img: "/images/funcionalidades/almacen-tienda/01-almacen-ubicaciones.png",
    alt: "Pantalla de Drenpos con almacenes, ubicaciones y stock por estantería",
    title: "Multialmacén y ubicaciones con QR",
    body: "Divide cada almacén en zonas, pasillos y estanterías con etiqueta QR. Cualquier persona del equipo localiza una referencia en segundos: el sistema le dice exactamente dónde está y cuántas unidades quedan en cada ubicación.",
    bullets: [
      "Almacenes ilimitados con stock independiente y consolidado",
      "Ubicaciones con etiquetas QR imprimibles",
      "Búsqueda instantánea: referencia → ubicación exacta",
    ],
  },
  {
    img: "/images/funcionalidades/almacen-tienda/02-lotes-caducidad.png",
    alt: "Control de lotes y fechas de caducidad en Drenpos con criterio FEFO",
    title: "Lotes, caducidades y FEFO automático",
    body: "Cada entrada registra su lote y su fecha de caducidad. El sistema propone salidas por FEFO (primero lo que antes caduca) o FIFO/LIFO según tu criterio, te avisa antes de que un lote caduque y te permite localizar y retirar un lote completo en minutos.",
    bullets: [
      "Trazabilidad completa por lote: origen, movimientos y destino",
      "Alertas de caducidad configurables",
      "Retirada de lote inmediata (Reglamento CE 178/2002)",
    ],
  },
  {
    img: "/images/funcionalidades/almacen-tienda/04-pistola-traslados.png",
    alt: "Operario usando pistola lectora para traslados de stock en Drenpos",
    title: "Pistola lectora: entradas, traslados e inventario sin parar",
    body: "Recepciona mercancía, traslada entre ubicaciones y haz inventarios escaneando con pistola lectora o con la cámara del móvil. El stock se actualiza en tiempo real y el inventario deja de ser 'el día que cerramos': se hace por zonas, sin parar la operativa.",
    bullets: [
      "Recepción de pedidos de compra escaneando",
      "Traslados entre almacenes y ubicaciones con lector",
      "Inventarios parciales por zona, sin cerrar el negocio",
    ],
  },
];

// Comparativa (tabla AEO — decisión de compra)
const comparativa = [
  {
    opcion: "Excel / papel",
    stock: "Manual, siempre desfasado",
    lotes: "—",
    ubicaciones: "—",
    integracion: "—",
    precio: "«Gratis» (te cuesta en horas y errores)",
  },
  {
    opcion: "Facturación con inventario básico",
    stock: "Unidades totales, sin detalle",
    lotes: "No o muy limitado",
    ubicaciones: "No",
    integracion: "Solo facturación",
    precio: "10–30 €/mes",
  },
  {
    opcion: "SGA enterprise",
    stock: "Tiempo real",
    lotes: "Sí",
    ubicaciones: "Sí",
    integracion: "Requiere integrarlo con tu ERP",
    precio: "Miles de € + proyecto de meses",
  },
  {
    opcion: "Drenpos",
    stock: "Tiempo real",
    lotes: "Sí, con FEFO y alertas",
    ubicaciones: "Sí, con QR",
    integracion: "Nativa: compras, ventas, TPV y facturación",
    precio: "Desde 19,90 €/mes",
    destacado: true,
  },
];

// Casos de uso (long-tail sectorial)
const casos = [
  {
    tag: "Distribución y mayoristas",
    icon: "🚚",
    title: "Multialmacén con traslados controlados",
    body: "Stock independiente por nave o delegación, traslados entre almacenes con pistola y visión consolidada para compras. Los pedidos se preparan contra la ubicación real, no contra la memoria del encargado.",
  },
  {
    tag: "Alimentación y perecederos",
    icon: "🥫",
    title: "Lotes y caducidades bajo control",
    body: "Cada palet entra con su lote y su fecha. Las salidas se proponen por FEFO, las alertas avisan antes de que caduque nada y, ante una incidencia sanitaria, localizas y retiras el lote completo en minutos con su trazabilidad documentada.",
  },
  {
    tag: "Ferretería y recambios",
    icon: "🔩",
    title: "Miles de referencias pequeñas, localizables",
    body: "Ubicaciones con QR por cajón y estantería: cualquier persona encuentra la pieza aunque lleve una semana en la empresa. Inventarios por zonas para no cerrar nunca por recuento.",
  },
];

const faqs = [
  {
    q: "¿Qué es un software de gestión de almacén (SGA)?",
    a: "Es el sistema que controla todo lo que entra, se mueve y sale de tu almacén: stock en tiempo real, ubicación exacta de cada referencia, lotes con caducidad y trazabilidad de cada movimiento. A diferencia de un inventario básico, un SGA sabe no solo cuánto tienes, sino dónde está y de qué lote es.",
  },
  {
    q: "¿Qué debe tener un buen programa de gestión de almacén para una pyme?",
    a: "Cinco cosas: stock en tiempo real conectado a compras y ventas, ubicaciones para localizar referencias sin depender de la memoria, control de lotes y caducidades si trabajas con perecederos, lectura por pistola o móvil para operar sin teclear, e integración nativa con facturación y TPV para no duplicar datos.",
  },
  {
    q: "¿Cuánto cuesta un software de gestión de almacén?",
    a: "Los SGA enterprise cuestan miles de euros más un proyecto de implantación de meses. Las herramientas de facturación con inventario básico rondan 10–30 €/mes pero no tienen ubicaciones ni lotes. El módulo de almacén de Drenpos cuesta desde 19,90 €/mes con multialmacén, ubicaciones QR, lotes con FEFO y pistola, sin coste por uso ni permanencia.",
  },
  {
    q: "¿Puedo controlar el stock de varios almacenes a la vez?",
    a: "Sí. Drenpos es multialmacén: cada nave, tienda o delegación tiene su stock independiente, con traslados controlados entre ellas y una visión consolidada para tomar decisiones de compra. Los traslados pueden hacerse con pistola lectora para eliminar errores de tecleo.",
  },
  {
    q: "¿Cómo funciona la trazabilidad por lotes? ¿Es obligatoria?",
    a: "Cada entrada de mercancía registra su lote y caducidad, y cada salida queda vinculada al lote que se sirvió. Si trabajas con alimentación, el Reglamento CE 178/2002 te obliga a poder identificar origen y destino de cada lote: con Drenpos localizas y retiras un lote completo en minutos, con el histórico documentado.",
  },
  {
    q: "¿Puedo hacer inventario sin cerrar el negocio?",
    a: "Sí. Con inventarios parciales por zona o ubicación: escaneas una estantería con la pistola o el móvil, el sistema compara con el stock teórico y ajusta las diferencias. Repartido en sesiones cortas, el recuento anual con cierre desaparece.",
  },
  {
    q: "¿Se integra con mis ventas, compras y facturación?",
    a: "Es que no es una integración: es el mismo sistema. Cada venta, compra, albarán o ticket de TPV mueve el stock automáticamente. Sin exportaciones, sin sincronizaciones que fallan y sin descuadres entre programas.",
  },
  {
    q: "¿Cuánto se tarda en ponerlo en marcha?",
    a: "La implantación estándar se hace en días: importamos tus artículos desde Excel o desde tu sistema anterior, definimos almacenes y ubicaciones, cargamos el stock inicial y formamos al equipo. Acompañamos la puesta en marcha en persona, con soporte humano incluido.",
  },
];

// Enlaces internos (clúster almacén + puente a retail y ayudas)
const articulos = [
  { t: "Cómo organizar el almacén de una pyme: guía práctica", s: "como-organizar-almacen-pyme" },
  { t: "Control de stock sin roturas: guía práctica", s: "control-de-stock-sin-roturas" },
  { t: "ERP para pymes: cuándo dejar Excel", s: "erp-para-pymes-vs-excel" },
  { t: "Cómo enviar albaranes y facturas por WhatsApp", s: "enviar-facturas-por-whatsapp-automaticamente" },
];

// ── Datos estructurados (JSON-LD) ──────────────────────────────────────
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: "https://www.drenpos.com/" },
    { "@type": "ListItem", position: 2, name: "Funcionalidades", item: "https://www.drenpos.com/funcionalidades" },
    { "@type": "ListItem", position: 3, name: "Software de gestión de almacén", item: CANONICAL },
  ],
};

const productSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Drenpos · Gestión de Almacén",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: CANONICAL,
  description:
    "Software de gestión de almacén (SGA) para pymes: multialmacén, ubicaciones con QR, lotes con caducidad y FEFO, trazabilidad completa, pistola lectora e inventarios sin cerrar. Integrado con compras, ventas, TPV y facturación.",
  offers: {
    "@type": "Offer",
    price: "19.90",
    priceCurrency: "EUR",
    description: "Módulo Almacén desde 19,90 €/mes (sin IVA). Sin coste por uso ni permanencia.",
    url: "https://www.drenpos.com/pricing",
  },
  featureList: [
    "Stock en tiempo real multialmacén",
    "Ubicaciones con etiquetas QR",
    "Control de lotes, caducidades y FEFO",
    "Trazabilidad completa por lote",
    "Recepción, traslados e inventario con pistola lectora",
    "Inventarios parciales sin cerrar el negocio",
    "Integración nativa con compras, ventas, TPV y facturación",
  ],
  provider: { "@type": "Organization", name: "Drenpos", url: "https://www.drenpos.com" },
};
---

<Base
  title="Software de Gestión de Almacén · Drenpos"
  meta_title="Software de Gestión de Almacén para Pymes | SGA Drenpos"
  description="Software de gestión de almacén con potencia de SGA a precio de pyme: multialmacén, ubicaciones QR, lotes con caducidad FEFO, trazabilidad y pistola lectora. Desde 19,90 €/mes. Demo gratis."
  canonical={CANONICAL}
  image="/images/funcionalidades/almacen-tienda/01-almacen-ubicaciones.png"
>
  <!-- Datos estructurados -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ═══════════════════════════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section-sm pb-0 relative z-10 overflow-hidden">
    <div class="absolute inset-0 z-0 pointer-events-none">
      <img src="/images/grainy.svg" alt="" width="1440" height="900" class="w-full h-full object-cover opacity-[.08]" />
    </div>

    <div class="container relative z-10">
      <nav aria-label="Migas de pan" class="mb-6 text-sm" style="color: rgba(16,25,40,0.55);">
        <a href="/" class="hover:text-primary">Inicio</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <a href="/funcionalidades" class="hover:text-primary">Funcionalidades</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-primary font-medium">Gestión de Almacén</span>
      </nav>

      <div class="row gx-0 gy-12 lg:gy-0 items-center">
        <div class="lg:col-6" data-aos="fade-up-sm">
          <span class="text-primary bg-primary/10 px-4 py-1.5 inline-flex items-center gap-2 rounded-full uppercase text-sm font-medium mb-6">
            <span class="w-2 h-2 rounded-full" style="background: #16a34a;" aria-hidden="true"></span>
            Nuestra especialidad
          </span>

          <h1 class="mb-5 text-h3 lg:text-h1 font-bold leading-tight">
            Software de <span class="text-primary">gestión de almacén</span> con potencia de SGA a precio de pyme
          </h1>
          <p class="text-lg mb-8 max-w-xl" style="color: rgba(16,25,40,0.72);">
            Stock en tiempo real, ubicaciones con QR, lotes con caducidad y
            FEFO, trazabilidad completa y pistola lectora. Todo integrado con
            tus compras, ventas y facturación — sin proyectos de meses ni
            precios de gran empresa.
          </p>

          <ul class="flex flex-wrap gap-4 mb-10">
            <li data-aos="fade-up-sm" data-aos-delay="100">
              <a href="/contact" class="btn btn-dark">
                Pedir demo gratuita
                <span class="icon-wrapper">
                  <span class="icon">
                    <svg width="19" height="12" viewBox="0 0 19 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12.5 1L17.5 6L12.5 11M1.5 6H17.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                  <span class="icon" aria-hidden="true">
                    <svg width="19" height="12" viewBox="0 0 19 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12.5 1L17.5 6L12.5 11M1.5 6H17.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                </span>
              </a>
            </li>
            <li data-aos="fade-up-sm" data-aos-delay="150">
              <a href="/pricing" class="btn btn-light">Ver precios</a>
            </li>
          </ul>

          <div class="flex flex-wrap gap-x-8 gap-y-3 text-sm" style="color: rgba(16,25,40,0.62);">
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 text-white text-[10px] font-bold" style="background: #16a34a;">✓</span>
              Multialmacén y ubicaciones QR
            </div>
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 text-white text-[10px] font-bold" style="background: #16a34a;">✓</span>
              Lotes, caducidad y FEFO
            </div>
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 text-white text-[10px] font-bold" style="background: #16a34a;">✓</span>
              Sin permanencia
            </div>
          </div>
        </div>

        <div class="lg:col-6" data-aos="fade-up-sm" data-aos-delay="200">
          <div class="relative px-4 lg:px-0 pt-10 pb-10">
            <div class="absolute -top-10 -right-10 w-80 h-80 rounded-full blur-3xl -z-10 pointer-events-none" style="background: rgba(121,27,70,0.10);"></div>
            <div class="absolute bottom-0 left-0 w-56 h-56 rounded-full blur-2xl -z-10 pointer-events-none" style="background: rgba(211,167,118,0.12);"></div>

            <div class="rounded-2xl overflow-hidden relative z-10" style="box-shadow: 0 30px 80px rgba(0,0,0,0.18), 0 6px 20px rgba(0,0,0,0.08); border: 1px solid rgba(16,25,40,0.08);">
              <img
                src="/images/funcionalidades/almacen-tienda/01-almacen-ubicaciones.png"
                alt="Panel de gestión de almacén de Drenpos con ubicaciones y stock en tiempo real"
                width="720"
                height="480"
                class="w-full h-auto block"
                fetchpriority="high"
              />
            </div>

            <div class="absolute -bottom-5 -left-2 lg:-left-8 rounded-2xl px-4 py-3 flex items-center gap-3" style="background: white; box-shadow: 0 8px 32px rgba(0,0,0,0.13); border: 1px solid rgba(16,25,40,0.07);" data-aos="zoom-in-up-sm" data-aos-delay="500">
              <div class="w-9 h-9 rounded-full flex items-center justify-center text-base flex-shrink-0 font-bold" style="background: #dcfce7; color: #16a34a;">✓</div>
              <div>
                <p class="text-xs font-bold text-dark">Stock cuadrado</p>
                <p class="text-xs" style="color: #9ca3af;">Pasillo 3 · Estantería B</p>
              </div>
            </div>

            <div class="absolute -top-5 -right-2 lg:-right-6 rounded-2xl px-4 py-3 flex items-center gap-2.5" style="background: white; box-shadow: 0 8px 32px rgba(0,0,0,0.13); border: 1px solid rgba(16,25,40,0.07);" data-aos="fade-up-sm" data-aos-delay="450">
              <div class="w-8 h-8 rounded-xl flex items-center justify-center text-lg flex-shrink-0" style="background: #fef3c7;">🗓️</div>
              <div>
                <p class="text-xs font-bold text-dark">Lote L-2409</p>
                <p class="text-xs" style="color: #9ca3af;">Caduca en 12 días · FEFO</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       DEFINICIÓN CITABLE (AEO / featured snippet)
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section-sm pb-0">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-9 text-center" data-aos="fade-up-sm">
          <h2 class="h4 font-bold mb-4">¿Qué es un software de gestión de almacén?</h2>
          <p class="text-lg leading-relaxed" style="color: rgba(16,25,40,0.72);">
            Un <strong>software de gestión de almacén (SGA)</strong> es el
            sistema que controla todo lo que entra, se mueve y sale de tu
            almacén: <strong>stock en tiempo real</strong>, la
            <strong>ubicación exacta</strong> de cada referencia, los
            <strong>lotes con su caducidad</strong> y la trazabilidad de cada
            movimiento. La diferencia con un inventario básico es simple: un
            inventario sabe <em>cuánto</em> tienes; un SGA sabe además
            <em>dónde está y de qué lote es</em>. Drenpos pone esa capacidad
            — hasta ahora reservada a sistemas de gran empresa — al alcance de
            cualquier pyme, integrada con sus compras, ventas y facturación.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       SÍNTOMAS (dolores de búsqueda)
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section-sm">
    <div class="container">
      <div class="text-center mb-12" data-aos="fade-up-sm">
        <h2 class="h3 font-bold mb-4">¿Te suena alguna de estas cuatro?</h2>
        <p class="text-lg" style="color: rgba(16,25,40,0.65);">
          Son los cuatro síntomas por los que las pymes acaban buscando un sistema de gestión de almacén.
        </p>
      </div>
      <div class="row g-4 justify-center">
        {
          sintomas.map((s, i) => (
            <div class="md:col-6 lg:col-3" data-aos="fade-up-sm" data-aos-delay={i * 100}>
              <div class="h-full rounded-3xl border border-dark/10 bg-body p-6 hover:shadow-xl transition-shadow duration-300">
                <div class="text-3xl mb-4">{s.icon}</div>
                <h3 class="h6 font-bold mb-3 leading-snug">{s.title}</h3>
                <p class="text-sm" style="color: rgba(16,25,40,0.65);">{s.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       CAPACIDADES (features con imagen real)
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section pt-0 overflow-hidden">
    <div class="container">
      {
        capacidades.map((c, i) => (
          <div class={`row gy-8 items-center ${i > 0 ? "mt-16 lg:mt-24" : ""}`}>
            <div class={`lg:col-6 ${i % 2 === 1 ? "lg:order-2" : ""}`} data-aos="fade-up-sm">
              <div class="rounded-2xl overflow-hidden" style="box-shadow: 0 20px 60px rgba(0,0,0,0.14); border: 1px solid rgba(16,25,40,0.08);">
                <img src={c.img} alt={c.alt} width="640" height="420" class="w-full h-auto block" loading="lazy" />
              </div>
            </div>
            <div class={`lg:col-6 ${i % 2 === 1 ? "lg:order-1" : ""}`} data-aos="fade-up-sm" data-aos-delay="150">
              <h2 class="h4 mb-4 font-bold leading-tight">{c.title}</h2>
              <p class="mb-6" style="color: rgba(16,25,40,0.72);">{c.body}</p>
              <ul class="space-y-3">
                {c.bullets.map((b) => (
                  <li class="flex items-start gap-3">
                    <span class="w-5 h-5 mt-0.5 rounded-full flex items-center justify-center flex-shrink-0 text-white text-[10px] font-bold" style="background: #16a34a;">✓</span>
                    <span class="text-sm" style="color: rgba(16,25,40,0.75);">{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       COMPARATIVA (tabla de decisión — AEO)
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section pt-0 overflow-hidden">
