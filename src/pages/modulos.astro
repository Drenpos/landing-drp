---
export const prerender = true;
import Base from "@/layouts/Base.astro";
import PageHeader from "@/partials/PageHeader.astro";
import ModulesTableCollapsible from "@/partials/ModulesTableCollapsible.astro";
import PlansComparison from "@/partials/PlansComparison.astro";
import CallToAction from "@/partials/CallToAction.astro";
---

<Base
  title="Módulos Drenpos"
  meta_title="Módulos de Drenpos: almacén, TPV, facturación y fichajes"
  description="Todos los módulos de Drenpos con su precio sin IVA: facturación, TPV, inventario, producción, fichajes, órdenes de servicio y extras, y qué trae cada plan."
>
  <PageHeader
    title="Módulos y Planes Drenpos"
    description="Qué hace cada módulo, en qué plan viene y cuánto cuesta lo que se añade aparte. Precios sin IVA y sin permanencia."
  />

  {/* Tabla colapsable de módulos con precios */}
  <div class="section-up pb-0">
    <ModulesTableCollapsible isSection={false} showPricing={true} />
  </div>

  {/* Tabla de comparación de planes */}
  <PlansComparison isSection={true} />

  <CallToAction />
</Base>
