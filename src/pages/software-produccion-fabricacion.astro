---
import { abs, AUTOR } from "@/lib/site";
import { breadcrumb, faqPage, oferta, softwareApp } from "@/lib/schema";
import JsonLd from "@/components/JsonLd.astro";
export const prerender = true;
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import ClientLogosStrip from "@/partials/ClientLogosStrip.astro";
import DemoForm from "@/partials/DemoForm.astro";
import LandingMeta from "@/partials/LandingMeta.astro";

// ════════════════════════════════════════════════════════════════════════
//  Landing · Software de producción y fabricación (SEO + GEO + AEO)
//  Clúster: hermana de /software-gestion-almacen y del resto de landings.
//  Diferenciación: esta ataca FABRICAR (órdenes de trabajo, fases, tiempos,
//  coste real). El almacén ataca ALMACENAR. No canibalizan.
//  Todo lo afirmado aquí sale del módulo DRP_PRODUCTION_MODULE y de los
//  módulos que el plan Producción incluye. Nada inventado.
//  Capturas pendientes (cuando existan, sustituir los reutilizados):
//    funcionalidades/produccion/01-orden-trabajo.png
//    funcionalidades/produccion/02-coste-real.png
// ════════════════════════════════════════════════════════════════════════

const PATH = "/software-produccion-fabricacion";
const CANONICAL = abs(PATH);

// Capacidades del módulo de Producción (features reales del módulo)
const capacidades = [
  {
    icon: "🧾",
    title: "Órdenes de trabajo",
    body: "Cada fabricación es una orden de trabajo con su producto final, su cantidad y su estado. Sabes en todo momento qué se está fabricando, qué falta y qué ya está terminado, sin listas en papel ni hojas de cálculo paralelas.",
  },
  {
    icon: "🪜",
    title: "Fases de fabricación",
    body: "Divide la orden en las fases reales de tu proceso (corte, montaje, acabado, envasado…). Cada fase avanza por separado, así que ves dónde está parado el trabajo en lugar de enterarte al final.",
  },
  {
    icon: "🔫",
    title: "Consumo de materiales por lectura",
    body: "El operario escanea el código del material que consume y el stock se descuenta del almacén en ese momento, con su lote. Se acabó el «apúntalo y ya lo meto luego»: el inventario refleja la realidad de la nave.",
  },
  {
    icon: "⏱️",
    title: "Imputación de tiempos",
    body: "Cada operario imputa el tiempo que dedica a una fase concreta. El tiempo deja de ser una estimación de memoria y pasa a ser un dato con nombre, fase y fecha.",
  },
  {
    icon: "💶",
    title: "Coste real de fabricación",
    body: "Materiales realmente consumidos más tiempos realmente imputados. Ese es el coste de la orden: el real, no el que calculaste al presupuestar. Ahí es donde aparecen los productos que creías rentables y no lo son.",
  },
  {
    icon: "🏷️",
    title: "Trazabilidad materia prima → producto acabado",
    body: "Como Producción se apoya en el módulo de Inventario, el lote del producto acabado queda enlazado con los lotes de materia prima que lo formaron. Ante una incidencia, el rastreo va en las dos direcciones.",
  },
  {
    icon: "📒",
    title: "Recetas y semielaborados",
    body: "Cada trabajo tipo guarda sus materiales con cantidad y unidad, las horas previstas por fase y centro de trabajo y el orden de las fases. Si un material también se fabrica (una masa, un subconjunto), la orden propone su suborden y fabrica solo lo que falta en stock.",
  },
  {
    icon: "🛒",
    title: "Necesidades de material",
    body: "Una pantalla suma lo que piden todas las órdenes abiertas frente a lo libre en almacén y lo que viene de compras, con semáforo verde, ámbar o rojo. Desde las filas con falta se genera el pedido al proveedor en un clic.",
  },
  {
    icon: "🎁",
    title: "Packs y kits montables",
    body: "Un pack es un artículo con su propia lista de materiales. Un botón monta N packs de una vez: comprueba que hay de todo, descuenta los componentes con su lote y da entrada al pack con lote propio y el coste de sus componentes.",
  },
];

// Síntomas / dolores (long-tail AEO: cómo lo busca la gente de verdad)
const sintomas = [
  {
    icon: "❓",
    title: "No sabes cuánto te cuesta de verdad fabricar cada producto",
    body: "Presupuestas con un coste calculado hace dos años. Si el material subió o la pieza lleva más horas de las previstas, el margen se lo come el taller sin que nadie lo vea en ningún sitio.",
  },
  {
    icon: "📋",
    title: "La producción vive en partes de papel y en la cabeza del encargado",
    body: "Cuando el encargado libra, nadie sabe por qué fase va cada trabajo. La información existe, pero no está en ningún sistema donde puedas consultarla.",
  },
  {
    icon: "📉",
    title: "El stock nunca cuadra porque el consumo se apunta tarde",
    body: "Los materiales salen del almacén a la nave y se descuentan días después, o no se descuentan. El inventario del sistema y el de la estantería llevan vidas separadas.",
  },
  {
    icon: "⏳",
    title: "Sabes las horas que se pagan, no en qué se han ido",
    body: "El fichaje te dice que un operario hizo 8 horas. No te dice cuántas fueron a la orden que se te fue de presupuesto ni cuántas a la que sí era rentable.",
  },
];

// Flujo de una orden de trabajo (numerado → elegible para list snippet)
const flujo = [
  {
    n: 1,
    t: "Se abre la orden de trabajo",
    d: "Producto a fabricar, cantidad y fases del proceso.",
  },
  {
    n: 2,
    t: "El operario consume material escaneando",
    d: "El stock se descuenta del almacén en ese momento, con su lote.",
  },
  {
    n: 3,
    t: "Se imputan los tiempos por fase",
    d: "Quién, en qué fase y cuánto tiempo.",
  },
  {
    n: 4,
    t: "La orden se cierra con su coste real",
    d: "Materiales consumidos + tiempos imputados = lo que te ha costado de verdad.",
  },
];

// Casos de uso
const casos = [
  {
    tag: "Taller metalúrgico a medida",
    icon: "⚙️",
    body: "Cada pedido es una pieza distinta, así que el coste teórico no sirve de nada. Con la orden de trabajo por fases (corte, soldadura, acabado) y los tiempos imputados, al cerrar el trabajo se ve el coste real y se puede comparar con lo presupuestado antes de presupuestar el siguiente.",
  },
  {
    tag: "Obrador y transformación de alimentos",
    icon: "🥖",
    body: "El consumo por lectura descuenta la materia prima con su lote, y el producto acabado nace con lote propio. Si hay una alerta sanitaria, el rastreo va del producto final a los lotes de origen y de un lote de origen a todo lo que se fabricó con él.",
  },
  {
    tag: "Pequeña fábrica con varios operarios",
    icon: "🏭",
    body: "Las [[n:produccion_fichajes]] personas que fichan incluidas en el plan cubren la plantilla del taller: cada operario ficha su jornada y además imputa a qué fase de qué orden fue su tiempo. Registro horario y coste de producción con el mismo dato.",
  },
];

// Preguntas reales (AEO): H3 + respuesta de 50 a 80 palabras + guía enlazada
const preguntas = [
  {
    id: "que-es-software-produccion-pyme",
    q: "¿Qué es un software de producción para una pyme y cuándo compensa?",
    a: "Es el programa que sustituye la libreta y el Excel del taller: cada fabricación es una orden con su receta, sus fases, el material que se consume y las horas que lleva. Compensa cuando ya no sabes por qué fase va cada trabajo, cuando el stock de materia prima no cuadra o cuando presupuestas con costes de hace dos años. Con tres o cuatro operarios ya se nota.",
    link: { url: "/blog/ordenes-de-fabricacion-pyme-sin-excel", t: "Órdenes de fabricación sin Excel" },
  },
  {
    id: "como-calcular-coste-fabricacion",
    q: "¿Cómo se calcula el coste de fabricación de un producto?",
    a: "Material consumido más horas de personas y de máquinas por su coste hora, dividido entre las unidades buenas. En Drenpos cada orden enseña el coste previsto frente al real, separado en material, personas y máquinas, y por fase. Si hay piezas defectuosas, el coste unitario se reparte solo entre las buenas, y el informe de costes compara el resultado con el precio de tarifa.",
    link: { url: "/blog/escandallo-lista-materiales-coste-fabricacion", t: "Escandallo y coste de fabricación con mermas" },
  },
  {
    id: "trazar-lotes-materia-prima-producto",
    q: "¿Cómo se traza un lote de materia prima hasta el producto terminado?",
    a: "Registrando en la orden qué lote de cada materia prima se consumió y dando al producto terminado un lote propio al cerrarla. En Drenpos el consumo se hace escaneando producto, lote o palet, y el lote de salida nace con el número de la orden y la fecha. La pantalla de trazabilidad enseña el árbol en los dos sentidos: de qué se hizo y a qué clientes se vendió.",
    link: { url: "/blog/trazabilidad-lotes-produccion", t: "Trazabilidad de lotes en producción" },
  },
  {
    id: "packs-kits-montables",
    q: "¿Cómo se gestionan los packs y kits con stock de componentes?",
    a: "El pack se da de alta como un artículo normal, con precio y stock, y lleva su lista de materiales en la ficha. Al montar N packs, Drenpos comprueba antes que hay todos los componentes, los descuenta con su lote y da entrada al pack con lote propio. También dice cuántos packs se pueden montar con el stock libre y permite montarlos desde la preparación del pedido.",
    link: { url: "/blog/kits-packs-montables-stock-componentes", t: "Kits y packs montables" },
  },
  {
    id: "produccion-obrador-alimentaria",
    q: "¿Sirve para un obrador o una pequeña industria alimentaria?",
    a: "Sí. La orden consume la materia prima por lote y nunca usa un lote caducado sin confirmación expresa. El producto terminado sale con lote automático y una caducidad calculada con los días de vida útil del artículo, y al cerrar se imprimen sus etiquetas. Ante una alerta de un proveedor, la trazabilidad dice en qué lotes de producto acabó la materia prima y a qué clientes se vendieron.",
    link: { url: "/blog/produccion-obrador-industria-alimentaria", t: "Producción en obrador e industria alimentaria" },
  },
  {
    id: "precio-software-produccion",
    q: "¿Cuánto cuesta el software de producción de Drenpos?",
    a: "El plan Producción cuesta [[p:produccion]] al mes sin IVA e incluye los módulos de Producción, Inventario, Financiero, Informes y Fichajes, más el envío de documentos por correo y WhatsApp. Cada operario que ficha tiempo en las órdenes necesita su usuario y su licencia de fichaje; si la plantilla supera lo incluido, cada usuario adicional cuesta [[p:usuario]] y cada fichaje [[p:fichaje]] al mes. Sin permanencia.",
    link: { url: "/pricing", t: "Planes y precios" },
  },
];

// Guías del blog del pilar Producción
const guias = [
  { url: "/blog/ordenes-de-fabricacion-pyme-sin-excel", t: "Órdenes de fabricación en una pyme: cómo llevarlas sin Excel", d: "Qué datos lleva una orden, cómo se mueve por la nave y qué cambia al dejar la hoja de cálculo." },
  { url: "/blog/escandallo-lista-materiales-coste-fabricacion", t: "Escandallo y lista de materiales: cómo calcular el coste de fabricación", d: "Un ejemplo completo con mermas, horas y coste por unidad buena." },
  { url: "/blog/trazabilidad-lotes-produccion", t: "Trazabilidad de lotes en producción", d: "Del lote de materia prima al lote de producto terminado, hacia atrás y hacia delante." },
  { url: "/blog/kits-packs-montables-stock-componentes", t: "Kits y packs montables: stock de componentes", d: "Cuándo montar por adelantado, cuándo bajo pedido y cómo sale el coste del pack." },
  { url: "/blog/produccion-obrador-industria-alimentaria", t: "Producción en obrador e industria alimentaria", d: "Lotes, caducidad, mermas y alertas de proveedor en un obrador de 8 personas." },
];

// Qué incluye el plan Producción (tabla → elegible para table snippet)
const incluyePlan = [
  { m: "Módulo Producción", d: "Órdenes de trabajo, fases, consumo por lectura, tiempos y coste real", s: "Incluido" },
  { m: "Módulo Inventario", d: "Artículos, almacenes, ubicaciones, stock, lotes y trazabilidad", s: "Incluido" },
  { m: "Módulo Financiero", d: "Ofertas, pedidos, albaranes, facturación Verifactu, clientes y proveedores", s: "Incluido" },
  { m: "Módulo Informes", d: "Informes y análisis de tus datos", s: "Incluido" },
  { m: "[[n:produccion_usuarios]] usuarios del sistema", d: "Con permisos granulares y sesiones simultáneas ilimitadas; cada uno más, [[p:usuario]]/mes", s: "Incluidos" },
  { m: "[[n:produccion_fichajes]] personas que fichan", d: "Registro de jornada por web, app PWA, QR o llavero RFID; cada persona más, [[p:fichaje]]/mes", s: "Incluidos" },
  { m: "Envío por correo y WhatsApp", d: "Manda documentos al cliente sin salir del sistema", s: "Incluido" },
];

// FAQ: preguntas tal y como se buscan (AEO), respuestas de 50 a 80 palabras
const faqs = [
  {
    q: "¿Qué es un software de producción?",
    a: "Un software de producción controla qué se fabrica, en qué fase está, qué materiales consume y cuánto tiempo lleva. En Drenpos cada fabricación es una orden de trabajo dividida en fases: el operario escanea los materiales que consume e imputa sus tiempos, y al cerrar la orden el sistema calcula el coste real de esa fabricación.",
  },
  {
    q: "¿Cuánto cuesta el software de producción de Drenpos?",
    a: "El plan Producción cuesta [[p:produccion]]/mes sin IVA e incluye los módulos de Producción, Inventario, Financiero e Informes, [[n:produccion_usuarios]] usuarios del sistema, [[n:produccion_fichajes]] usuarios de fichaje y el envío de documentos por correo y WhatsApp. Si ya tienes otro plan: no se vende suelto. Sin permanencia ni coste de instalación.",
  },
  {
    q: "¿Cómo se calcula el coste real de fabricación?",
    a: "Sumando lo que realmente ha pasado en la orden: los materiales que el operario ha consumido escaneándolos y los tiempos que ha imputado a cada fase. No es una estimación previa ni un reparto de costes al cierre del mes, es el consumo y el tiempo de esa orden concreta, así que puedes compararlo con lo que presupuestaste.",
  },
  {
    q: "¿Se descuenta el stock automáticamente al fabricar?",
    a: "Sí. El consumo de materiales se registra por lectura de código: el operario escanea lo que va a consumir y el stock se descuenta del almacén en ese momento, con su lote. El inventario refleja lo que hay en la nave sin que nadie tenga que pasar partes de consumo a mano después.",
  },
  {
    q: "¿Hay trazabilidad entre la materia prima y el producto acabado?",
    a: "Sí. El módulo de Producción trabaja sobre el módulo de Inventario, que gestiona lotes con fecha de fabricación y caducidad. El lote del producto acabado queda enlazado con los lotes de materia prima consumidos, de modo que puedes rastrear en ambos sentidos ante una incidencia o una inspección, y sacar el informe en PDF para Sanidad o para el cliente.",
  },
  {
    q: "¿Sirve para un taller pequeño o solo para fábricas grandes?",
    a: "Está pensado para talleres y fabricantes pequeños y medianos. El plan Producción incluye [[n:produccion_usuarios]] usuarios y [[n:produccion_fichajes]] personas que fichan, que cubre la plantilla habitual de un taller, y no requiere proyecto de implantación ni consultores. Drenpos está enfocado deliberadamente en pymes y autónomos, no en corporaciones que necesitan un ERP tipo SAP. La implantación se mide en días o semanas, no en meses.",
  },
  {
    q: "¿Se integra con el control horario y la facturación?",
    a: "Sí, es el mismo sistema. El plan Producción incluye [[n:produccion_fichajes]] usuarios de fichaje para el registro de jornada obligatorio y el módulo Financiero con facturación Verifactu. El tiempo que un operario imputa a una fase y la factura que sale de ese trabajo viven en la misma base de datos, sin exportaciones ni duplicar datos.",
  },
  {
    q: "¿Tiene escandallo o lista de materiales?",
    a: "Sí. Cada trabajo tipo funciona como receta: materiales con cantidad y unidad de medida, horas previstas por centro de trabajo y por fase, y el orden de las fases. Al crear una orden desde la receta se copia, así que cambiarla después no altera las órdenes ya lanzadas. Si un material también se fabrica, la orden lo marca como fabricable y propone su suborden, hasta tres niveles.",
  },
  {
    q: "¿Se puede lanzar la orden desde un pedido de venta?",
    a: "Sí. Desde el pedido se crea una orden por cada línea que se fabrica, con el cliente, la fecha del pedido y la cantidad que falta: lo pedido, menos lo servido, menos lo que ya está en órdenes y menos el stock libre. Si la orden va tarde, le falta material o está parada, el cuadro de producción marca ese pedido como en riesgo.",
  },
  {
    q: "¿Cómo ficha el operario el tiempo de cada fase?",
    a: "Desde su tablet, en la pantalla «Mi trabajo» o escaneando el QR de la hoja de la orden. Pulsa empezar en la fase y, al parar, las horas caen solas en la mano de obra de esa fase con su nombre. Este fichaje de tarea es independiente del registro de jornada: fichar en una orden no toca la entrada y la salida del día.",
  },
  {
    q: "¿Qué no hace el módulo de producción?",
    a: "No es un MRP completo: no planifica solo con capacidad finita ni dibuja un diagrama de Gantt, aunque enseña la carga de cada centro frente a su capacidad. No admite cierres parciales: el producto entra en stock al cerrar la orden entera. El puesto de trabajo necesita conexión, no lee sensores de máquina y no factura solo: deja el albarán relleno para que alguien lo revise.",
  },
];

// Landings hermanas del clúster
const hermanas = [
  {
    url: "/software-gestion-almacen",
    title: "Gestión de almacén y stock",
    body: "La base sobre la que se apoya Producción: multialmacén, ubicaciones, lotes y trazabilidad.",
  },
  {
    url: "/software-preparacion-pedidos-picking",
    title: "Preparación de pedidos y picking",
    body: "Cuando lo fabricado hay que servirlo: oleadas, asistente móvil y expedición con escaneo.",
  },
  {
    url: "/control-horario",
    title: "Control horario y fichajes",
    body: "Los mismos operarios que imputan tiempos, fichando por web, app, QR o llavero RFID.",
  },
  {
    url: "/software-almacen-tienda",
    title: "Almacén y TPV para tienda",
    body: "Si además vendes en mostrador lo que fabricas, con el stock descontado en cada ticket.",
  },
  {
    url: "/software-control-stock",
    title: "Control de stock e inventario",
    body: "Que no falte materia prima: mínimos con alertas, propuesta de compra y lotes con caducidad.",
  },
];

// Enlazado interno local
const ciudades = [
  { n: "Mérida", s: "sistema-facturacion-erp-merida" },
  { n: "Badajoz", s: "sistema-facturacion-erp-badajoz" },
  { n: "Cáceres", s: "sistema-facturacion-erp-caceres" },
  { n: "Don Benito", s: "sistema-facturacion-erp-don-benito" },
  { n: "Almendralejo", s: "sistema-facturacion-erp-almendralejo" },
  { n: "Villanueva de la Serena", s: "sistema-facturacion-erp-villanueva" },
];

// ── Datos estructurados ──────────────────────────────────────────────────
const breadcrumbSchema = breadcrumb([
  { name: "Funcionalidades", path: "/funcionalidades" },
  { name: "Software de producción y fabricación", path: PATH },
]);

const productSchema = {
  ...softwareApp({
    name: "Drenpos · Módulo de Producción",
    path: PATH,
    description:
      "Software de producción para talleres y fabricantes: órdenes de trabajo divididas en fases, consumo de materiales por lectura de código con descuento de stock, imputación de tiempos por operario y coste real de fabricación.",
    featureList: [
      "Órdenes de trabajo con fases de fabricación",
      "Consumo de materiales por lectura de código de barras",
      "Descuento automático de stock por lote",
      "Imputación de tiempos por operario y fase",
      "Coste real de fabricación",
      "Trazabilidad entre lote de materia prima y lote de producto acabado",
      "Recetas con materiales, horas por fase y subórdenes de semielaborados",
      "Necesidades de material con pedido de compra en un clic",
      "Packs y kits con lista de materiales y montaje de N unidades",
      "Coste previsto frente a real por material, personas y máquinas",
    ],
  }),
  operatingSystem: "Web, iOS, Android (PWA)",
  applicationSubCategory: "Manufacturing Execution Software",
  inLanguage: "es-ES",
  offers: [
    {
      ...oferta(
        "produccion",
        "Plan Producción: módulos de Producción, Inventario, Financiero e Informes, [[n:produccion_usuarios]] usuarios del sistema, [[n:produccion_fichajes]] usuarios de fichaje y envío por correo y WhatsApp. Precio mensual sin IVA.",
      ),
      name: "Plan Producción",
      availability: "https://schema.org/InStock",
    },
  ],
};

const faqSchema = faqPage(faqs);

// Fechas visibles (LandingMeta) y del JSON-LD (WebPage.datePublished / dateModified).
// Publicación = primer commit de la página; actualización = último cambio de contenido.
const PAGE_PUBLISHED = "2026-08-16";
const PAGE_UPDATED = "2026-10-22";
---

<Base
  title="Software de Producción y Fabricación · Drenpos"
  meta_title="Software de Producción para Pymes | Coste Real de Fabricación"
  description="Software de producción para talleres y fabricantes: órdenes de trabajo por fases, materiales por escaneo, tiempos por operario y coste real de fabricación."
  canonical={CANONICAL}
  image="/images/power/stock.png"
  published_date={PAGE_PUBLISHED}
  modified_date={PAGE_UPDATED}
  author={AUTOR}
>
  <JsonLd data={[breadcrumbSchema, productSchema, faqSchema]} />

  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="section-sm pb-0 relative z-10 overflow-hidden">
    <div class="absolute inset-0 z-0 pointer-events-none">
      <img src="/images/grainy.svg" width="1440" height="900" alt="" aria-hidden="true" class="w-full h-full object-cover opacity-[.08]" />
    </div>

    <div class="container relative z-10">
      <nav aria-label="Migas de pan" class="mb-6 text-sm" style="color: rgba(16,25,40,0.55);">
        <a href="/" class="hover:text-primary">Inicio</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <a href="/funcionalidades" class="hover:text-primary">Funcionalidades</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-primary font-medium">Producción y fabricación</span>
      </nav>

      <div class="row gx-0 gy-12 lg:gy-0 items-center">
        <div class="lg:col-6" data-aos="fade-up-sm">
          <span class="text-primary bg-primary/10 px-4 py-1.5 inline-flex items-center gap-2 rounded-full uppercase text-sm font-medium mb-6">
            <span class="w-2 h-2 rounded-full" style="background: #16a34a;" aria-hidden="true"></span>
            Nuevo módulo
          </span>

          <h1 class="mb-5 text-h3 lg:text-h1 font-bold leading-tight">
            Software de <span class="text-primary">producción</span> que te dice cuánto cuesta fabricar de verdad
          </h1>
