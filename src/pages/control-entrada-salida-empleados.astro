---
export const prerender = true;
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import ClientLogosStrip from "@/partials/ClientLogosStrip.astro";
import DemoForm from "@/partials/DemoForm.astro";
import LandingMeta from "@/partials/LandingMeta.astro";
import { existsSync } from "node:fs";
import { join } from "node:path";

const hasImg = (p: string) => existsSync(join(process.cwd(), "public", p));

// ════════════════════════════════════════════════════════════════════════
//  Control de entrada y salida de empleados · landing dedicada (SEO/AEO 2026)
//  Tarea 1.3 del plan SEO/AEO de 7/10/2026 (clúster "gestión de equipo").
//  Intención de búsqueda objetivo:
//    - "control de entrada y salida de empleados"
//    - "retrasos de empleados" / "empleado llega tarde" / "llegar tarde al trabajo"
//    - "incidencias de fichaje" / "tolerancia de minutos" / "exceso de horas"
//    - "puntualidad" solo como palabra secundaria
//  Diferenciación con /blog/control-entrada-salida-retrasos-empleados: el post
//  explica qué dice la ley ante los retrasos; esta landing vende la función.
//  Diferenciación con /control-horario#entrada-salida: el hub resume, esta
//  página desarrolla (responsable, empleado, terminal sin conexión, tabla).
//  Captura pendiente: /images/funcionalidades/control-horario/11-incidencias-entrada-salida.png
//  (1280×800). Se muestra solo si existe (existsSync).
// ════════════════════════════════════════════════════════════════════════

const CANONICAL = "https://www.drenpos.com/control-entrada-salida-empleados";

const HERO_IMG = "/images/funcionalidades/control-horario/02-gestion-manager.png";
const INC_IMG = "/images/funcionalidades/control-horario/11-incidencias-entrada-salida.png";
const incImg = hasImg(INC_IMG);

// Fuentes legales
const ET_URL = "https://www.boe.es/buscar/act.php?id=BOE-A-2015-11430";
const RDL8_URL = "https://www.boe.es/buscar/act.php?id=BOE-A-2019-3481";
const ABSENTISMO_URL =
  "https://www.elespanol.com/invertia/economia/empleo/20260611/cifras-absentismo-empresa-deja-euros-ano-trabajador-ausencias-sin-justificar/1003744281355_0.html";

// Cápsulas citables (50 a 80 palabras, sin enlaces)
const capsulas = {
  definicion:
    "El control de entrada y salida de empleados compara la hora a la que ficha cada persona con el horario que le tocaba ese día y avisa cuando algo no cuadra: llega tarde, se va antes, no ficha o se pasa de horas. No sustituye al registro de jornada, trabaja encima de él. En Drenpos es una opción del módulo de fichajes que viene apagada y que enciendes cuando quieras, con la tolerancia que tú decidas.",
  sintomas:
    "Casi siempre te enteras por el equipo. Que un compañero llega tarde todos los lunes, que otro se va diez minutos antes, que en la nómina aparecen horas que nadie esperaba. Los fichajes están ahí, pero nadie los compara con el horario de cada persona porque hacerlo a mano lleva una tarde entera. Estas son las cuatro situaciones que más se repiten en una pyme.",
  registro:
    "No. El registro de jornada es la obligación legal: la hora de inicio y de fin de cada persona, cada día. El control de entrada y salida trabaja encima de esos fichajes, los compara con el horario y crea incidencias para que alguien las revise. Es una ayuda de gestión. Lo que vale ante la Inspección de Trabajo siguen siendo los fichajes, con su hora sellada y la traza de cada cambio.",
  funcionamiento:
    "Cada vez que alguien ficha, el sistema mira el horario de su calendario laboral para ese día, sus festivos y sus ausencias. Si la entrada llega después de la hora más la tolerancia, o la salida antes de la hora menos la tolerancia, crea una incidencia. Además, una revisión automática diaria y otra semanal encuentran lo que no se ve al fichar: quien no ha fichado y quien se ha pasado de horas.",
  horasExtra:
    "Todo sale de la misma cuenta. Las horas esperadas de cada día vienen del calendario de la persona, descontando sus festivos y sus ausencias. Lo trabajado por encima es hora extra, día a día, y la semana o el mes son la suma de los días. Las incidencias de exceso de horas usan esa misma cifra, así que la pantalla, los avisos y el informe PDF nunca te dan dos números distintos.",
  comparativa:
    "Hay cuatro formas de saber quién llega tarde, y las cuatro funcionan con dos personas. La diferencia aparece con quince: revisar a mano deja de hacerse, el Excel depende de quien mantiene las fórmulas y una app de recursos humanos lo resuelve según el plan que contrates. Esta tabla compara lo que de verdad importa en el día a día de un encargado, con el coste de cada opción.",
  precio:
    "Nada aparte. Va incluido en la licencia de fichaje de Drenpos, que cuesta 1 € por usuario y mes sin IVA, junto con las vacaciones y permisos, los calendarios rotativos y la planificación anual del equipo. Un matiz: quien revisa incidencias necesita licencia de fichaje aunque no fiche. El terminal es opcional y parte de 140 € sin IVA; también se ficha desde el móvil o el ordenador.",
};

// Síntomas (cómo se busca "control de entrada y salida" en la práctica)
const sintomas = [
  {
    icon: "⏰",
    title: "Los retrasos los descubren los compañeros",
    body: "El encargado no lo ve porque entra a otra hora. Se entera cuando el turno de mañana protesta porque siempre abren los mismos, y para entonces ya nadie recuerda qué días fueron.",
  },
  {
    icon: "🗂️",
    title: "Revisar fichajes uno a uno no cabe en la semana",
    body: "Con 15 personas y cuatro fichajes al día salen más de 1.300 líneas al mes. Nadie las compara con el horario de cada uno, así que los retrasos pasan sin que nadie los vea.",
  },
  {
    icon: "🌙",
    title: "Las horas de más aparecen en la nómina",
    body: "Alguien se queda una hora cada tarde y no lo sabe nadie hasta que la gestoría pregunta por qué hay tantas extra. O hasta que esa persona las reclama todas juntas.",
  },
  {
    icon: "💬",
    title: "Cada conversación acaba en «no es para tanto»",
    body: "Sin datos, el responsable queda como el que tiene manía a alguien. Con la fecha, la hora y el horario delante, se habla de hechos y la conversación dura dos minutos.",
  },
];

// Qué detecta (chips)
const incidenciasTipos = [
  "Entrada tarde",
  "Salida anticipada",
  "Sin fichar la entrada o la salida",
  "Exceso de horas al día",
  "Exceso de horas a la semana",
  "Trabajo en festivo",
  "Trabajo en vacaciones",
];

// Cómo funciona (tarjetas)
const funcionamiento = [
  {
    icon: "⏱️",
    title: "Tolerancia y límites a tu medida",
    body: "Pones los minutos de margen y el límite de horas al día y a la semana. Con 5 minutos y horario a las 8:00, entrar a las 8:04 no genera nada y entrar a las 8:14 genera «Entrada tarde +14 min».",
  },
  {
    icon: "🔎",
    title: "Al fichar y en la revisión diaria y semanal",
    body: "Las incidencias salen en el momento del fichaje. La revisión automática, a la hora que configures, detecta además lo que no se ve al fichar: quien no ha pasado el llavero o quien acumula horas de más en la semana.",
  },
  {
    icon: "🔔",
    title: "Aviso al empleado y a sus responsables",
    body: "Cada incidencia llega a la persona y a quien la supervisa. A quién avisar se decide en la configuración del módulo, así nadie se entera por terceros ni a fin de mes.",
  },
  {
    icon: "✍️",
    title: "Justificar o descartar con una nota",
    body: "Si hubo médico o un atasco en la autovía, el responsable la justifica con una nota. Si no procede, la descarta. La nota queda guardada con la incidencia y sale en el informe.",
  },
];

// Bloques: H2 en pregunta + cápsula + detalles
const bloques = [
  {
    id: "responsable",
    icon: "🧑‍💼",
    h2: "¿Qué ve el responsable cada mañana?",
    capsula:
      "Una lista de lo que hay que mirar, no un listado de fichajes. En la ficha del equipo cada fichaje lleva su etiqueta y un resumen del periodo. La pantalla de Incidencias se filtra por persona, tipo y estado, enseña un resumen por persona y tiene un botón «Revisar hoy» que deja delante solo lo del día. Lo de ayer no se queda para fin de mes, cuando ya nadie se acuerda.",
    bullets: [
      "Etiquetas en cada fichaje: «Tarde +12 min», «Salió 20 min antes», «Festivo», «En vacaciones»",
      "Pantalla de Incidencias con filtros por persona, tipo y estado",
      "Resumen por persona para ver quién acumula incidencias y de qué tipo",
      "Widget «Incidencias abiertas» en el panel: cuántas, de quién y de qué tipo en los últimos 7 días",
      "Fichajes activos de todo el equipo en tiempo real, sin tocar los registros",
    ],
    img: incImg ? INC_IMG : undefined,
    alt: "Pantalla de Incidencias de Drenpos con entradas tarde, salidas anticipadas y fichajes olvidados filtrados por persona, tipo y estado",
  },
  {
    id: "empleado",
    icon: "🙋",
    h2: "¿Y qué ve el empleado?",
    capsula:
      "Sus propias incidencias, a tiempo. Cada incidencia que le afecta le llega como aviso, igual que a su responsable, así se entera el mismo día y no cuando ya hay que hablar en serio. En su panel de inicio tiene el widget «Hoy en el trabajo», con el horario del día y las incidencias abiertas del mes. Si ficha desde el móvil, la app le avisa cuando se ha olvidado de cerrar la jornada.",
    bullets: [
      "Aviso de cada incidencia que le afecta",
      "Widget «Hoy en el trabajo»: horario de hoy e incidencias abiertas del mes",
      "App del móvil con aviso si olvidó cerrar la jornada",
      "Sus fichajes en «Mis fichajes», con la hora de cada uno",
    ],
  },
  {
    id: "sin-conexion",
    icon: "📡",
    h2: "¿Qué pasa si el terminal de fichaje estaba sin internet?",
    capsula:
      "Nadie sale perjudicado. El terminal de Drenpos lleva su propio reloj: si se cae la línea o el router, guarda cada fichaje en el aparato y lo sube cuando vuelve la red, con la hora a la que se hizo de verdad. Esos fichajes con hora reconstruida nunca generan «tarde» ni «salida anticipada», para que un corte de internet no acabe en una incidencia injusta contra alguien que llegó puntual.",
    bullets: [
      "El terminal sigue fichando con llavero RFID o QR aunque no haya red",
      "Cada fichaje sube con su hora real, no con la hora de la reconexión",
      "Desde el sistema ves qué ha subido cada terminal y qué le ha pasado a su reloj",
      "Terminal opcional desde 140 € sin IVA, con tu logo en la carcasa",
    ],
    nota: true,
  },
];

// Tabla de decisión
const comparativa = [
  {
    opcion: "Revisar los fichajes a mano",
    retrasos: "Solo si alguien se pone a mirar",
    sinFichar: "Cuando se nota la ausencia",
    exceso: "Al cerrar la nómina",
    justificacion: "De palabra",
    sinRed: "Depende del sistema de fichaje",
    precio: "Sin licencia, se paga en horas de encargado",
  },
  {
    opcion: "Excel con los fichajes exportados",
