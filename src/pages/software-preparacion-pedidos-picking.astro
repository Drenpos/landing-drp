  offers: {
    "@type": "Offer",
    price: "19.90",
    priceCurrency: "EUR",
    description: "Módulo Almacén desde 19,90 €/mes (sin IVA). Sin coste por uso ni permanencia.",
    url: "https://www.drenpos.com/pricing",
  },
  featureList: [
    "Semáforo de preparabilidad: pedidos completos, con faltas y de camino",
