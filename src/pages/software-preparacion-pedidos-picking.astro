---
export const prerender = true;
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";

// ════════════════════════════════════════════════════════════════════════
//  Software de preparación de pedidos (picking) · landing dedicada
//  Intención de búsqueda objetivo:
//    - "software de preparación de pedidos" (principal)
//    - "software de picking para almacén" / "picking móvil"
//    - "sistema de picking por oleadas" / "software de expedición"
//    - long-tail: preparación de pedidos con pistola lectora,
//      reducir errores de picking, pick-to-box, zona de preparados
//  Diferenciación con /software-gestion-almacen: aquella cubre el SGA
//  completo; esta ataca solo el flujo pedido → picking → expedición.
//  Imágenes UI: /public/images/funcionalidades/almacen-tienda/
// ════════════════════════════════════════════════════════════════════════

const CANONICAL = "https://www.drenpos.com/software-preparacion-pedidos-picking";

// Síntomas (dolores de búsqueda — long-tail AEO)
const sintomas = [
  {
    icon: "🛑",
    title: "Empiezas un pedido y a mitad descubres que falta género",
    body: "El preparador ya ha recorrido medio almacén cuando aparece la falta. Hay que deshacer, avisar a comercial y volver a empezar con otro pedido.",
  },
  {
    icon: "📄",
    title: "Listas en papel que alguien transcribe después",
    body: "Se imprime la lista, se marca a boli y por la tarde alguien la pasa al ordenador. Cada transcripción es una oportunidad de equivocarse — y el stock va siempre con horas de retraso.",
  },
  {
    icon: "🔎",
    title: "Pedidos preparados que nadie encuentra en el muelle",
    body: "Las cajas están hechas, pero están «por ahí». El chófer espera mientras dos personas buscan qué palé o qué caja es la del cliente que se va ahora.",
  },
  {
    icon: "❓",
    title: "No puedes demostrar quién preparó qué ni qué lote se sirvió",
    body: "Llega una reclamación y no hay forma de saber quién montó el pedido, qué lote salió ni si la caja se verificó antes de cargarla.",
  },
];

// El flujo real en 6 pasos (todo mapeado 1:1 a producto)
const flujo = [
  {
    n: "01",
    icon: "🚦",
    tag: "Antes de mover un pie",
    title: "Semáforo de preparabilidad",
    body: "El listado de preparación dice de un vistazo qué pedidos se pueden servir completos con el stock actual, cuáles tienen faltas y qué está de camino en pedidos de compra. Se decide qué se prepara hoy antes de que nadie coja una caja.",
  },
  {
    n: "02",
    icon: "🏷️",
    tag: "Arranque",
    title: "Etiqueta QR por pedido",
    body: "Cada pedido lleva su etiqueta QR imprimible. Escanearla abre la sesión de picking — o la crea si aún no existe. Sin buscar el pedido en una lista ni teclear referencias en el móvil.",
  },
  {
    n: "03",
    icon: "📱",
    tag: "En el almacén",
    title: "Asistente móvil paso a paso",
    body: "El asistente guía línea a línea: qué producto, en qué ubicación, qué lote sugerido según FIFO, LIFO o FEFO, y cuántas unidades. Si algo no cuadra, se registra la incidencia en esa línea y el pedido sigue avanzando.",
  },
  {
    n: "04",
    icon: "🌊",
    tag: "Productividad",
    title: "Oleadas: varios pedidos en una sola vuelta",
    body: "Se lanza una oleada con los pedidos que interesan y el sistema consolida una única ruta por el almacén (pick-to-box). Se recorre el almacén una vez y salen varios pedidos, no uno.",
  },
  {
    n: "05",
    icon: "📦",
    tag: "Dónde está cada pedido",
    title: "Zona de preparados o palet directo",
    body: "Los pedidos listos se aparcan en baldas con QR: se escanea la balda y se sabe exactamente dónde está cada pedido. Como alternativa, el pedido se prepara directamente sobre un palet con su etiqueta SSCC y al expedir sale el palet completo con su trazabilidad.",
  },
  {
    n: "06",
    icon: "🚚",
    tag: "Salida",
    title: "Verificación y expedición con escaneo",
    body: "Verificación configurable antes de expedir (recuento de control) y, al escanear el pedido preparado, el sistema genera el albarán o la factura automáticamente, con trazabilidad documental completa. Nadie vuelve a teclear el pedido.",
  },
];

// Métodos de picking (conceptos logísticos estándar — tabla AEO)
const metodos = [
  {
    metodo: "Por pedido (discreto)",
    como: "Un preparador recorre el almacén para un único pedido, de principio a fin.",
    cuando: "Pocos pedidos al día, pedidos grandes o muy urgentes, y equipos pequeños donde la trazabilidad de «quién preparó qué» es lo prioritario.",
    cuandoNo: "Cuando hay muchos pedidos pequeños: se repite el mismo recorrido una vez por pedido y casi todo el tiempo se va en andar.",
  },
  {
    metodo: "Por lotes (batch)",
    como: "Se agrupan varios pedidos y se recoge la cantidad total de cada producto en una sola pasada; después se reparte entre los pedidos.",
    cuando: "Muchos pedidos que comparten las mismas referencias, con una mesa o zona donde separar después.",
    cuandoNo: "Si no hay espacio ni tiempo para la separación posterior, o si los pedidos comparten pocas referencias entre sí.",
  },
  {
    metodo: "Por oleadas (wave)",
    como: "Se lanzan tandas de pedidos agrupados por un criterio (urgencia, ruta de reparto, hora de salida) y se recorre el almacén una vez por oleada.",
    cuando: "Cuando las salidas tienen horarios: la oleada se organiza alrededor del camión o de la recogida de la agencia.",
    cuandoNo: "Si los pedidos llegan de forma continua durante todo el día y hay que servirlos según entran, sin ventanas de salida.",
  },
  {
    metodo: "Por zonas",
    como: "Cada preparador cubre una zona fija del almacén y solo prepara las líneas que caen en ella; el pedido se completa con las aportaciones de cada zona.",
    cuando: "Almacenes grandes, con zonas de condiciones distintas (seco, refrigerado, congelado) o con equipos especializados por área.",
    cuandoNo: "En almacenes pequeños, donde partir el pedido añade coordinación y consolidación sin ganar nada.",
  },
  {
    metodo: "Pick-to-box",
    como: "Se recoge directamente dentro de la caja o el contenedor final de cada pedido, así que al terminar la ruta el pedido ya está montado.",
    cuando: "Pedidos de pocas líneas y volumen manejable, cuando se quiere evitar por completo la fase de separación posterior.",
    cuandoNo: "Con pedidos voluminosos o pesados, donde llevar varias cajas abiertas por el almacén no es práctico.",
  },
];

// Capacidades complementarias (todo real, products_modules.md)
const capacidades = [
  {
    icon: "🔒",
    tag: "Reservas de stock",
    title: "Stock físico y stock disponible, siempre separados",
    body: "Al confirmar un pedido, el stock queda comprometido para ese cliente y en todo el sistema se distingue físico de disponible (físico − reservado), también al elegir lotes y series. Las reservas se consumen solas al servir, incluso en servicios parciales.",
  },
  {
    icon: "📥",
    tag: "Recepción de mercancía",
    title: "Recibir contra pedido de compra con ruta guiada",
    body: "El operario recibe con pistola y el sistema compara lo esperado con lo recibido, siguiendo una ruta guiada por ubicación de destino para no dar vueltas. Incidencias por línea (faltas, roturas, mercancía no pedida), etiquetas GS1 con lote o serie desde la propia sesión y albarán de compra al cerrar.",
  },
  {
    icon: "⚡",
    tag: "Cross-docking",
    title: "Lo que sale sin llegar a tocar la estantería",
    body: "Si hay pedidos de venta esperando ese producto, la línea de recepción lo avisa en el momento para que la mercancía salga directa hacia preparación sin pasar por estantería.",
  },
  {
    icon: "🖨️",
    tag: "Impresión",
    title: "Hoja de etiquetas, lista de picking y etiqueta de envío",
    body: "Desde la misma pantalla se imprime la hoja de etiquetas de pedidos, la lista de picking para quien prefiere apoyo en papel y la etiqueta de envío del bulto preparado.",
  },
  {
    icon: "👤",
    tag: "Responsables",
    title: "Quién preparó y quién recibió, sesión a sesión",
    body: "Cada sesión lleva su preparador y su receptor asignados, con seguimiento de quién hizo qué. Ante una reclamación no hace falta reconstruir la mañana de memoria.",
  },
  {
    icon: "🛡️",
    tag: "Permisos",
    title: "Roles de almacén con plantillas listas",
    body: "Permisos por rol con plantillas preparadas para aplicar (mozo, responsable, supervisor), usuarios en varios grupos a la vez y explorador inverso para auditar quién tiene acceso a qué.",
  },
];

// Comparativa de soluciones (tabla de decisión — AEO)
const comparativa = [
  {
    opcion: "Papel y hoja de cálculo",
    servible: "A ojo, preguntando al almacén",
    guiado: "No: lista impresa",
    oleadas: "Manual, en la cabeza del responsable",
    expedicion: "Se teclea el albarán después",
    precio: "«Gratis» (te cuesta en horas y errores)",
  },
  {
    opcion: "Facturación con inventario básico",
    servible: "Solo unidades totales, sin reservas",
    guiado: "No",
    oleadas: "No",
    expedicion: "Albarán manual desde el pedido",
    precio: "10–30 €/mes",
  },
  {
    opcion: "WMS enterprise",
    servible: "Sí",
    guiado: "Sí, avanzado",
    oleadas: "Sí",
    expedicion: "Sí, pero factura tu ERP aparte",
    precio: "Miles de € + proyecto de meses",
  },
  {
    opcion: "Drenpos",
    servible: "Semáforo de preparabilidad, con faltas y lo que viene de camino",
    guiado: "Asistente móvil con ubicación y lote FIFO/LIFO/FEFO",
    oleadas: "Sí, pick-to-box en una ruta consolidada",
    expedicion: "Escanear genera el albarán o la factura",
    precio: "Desde 19,90 €/mes",
    destacado: true,
  },
];

// Casos de uso (long-tail sectorial, todos apoyados en producto real)
const casos = [
  {
    tag: "Distribución B2B",
    icon: "🚚",
    title: "20 pedidos por la mañana, una oleada con los 8 urgentes",
    body: "El responsable mira el semáforo, ve cuáles se pueden servir completos y lanza una oleada con los ocho que salen en la primera furgoneta. El mozo los prepara en una sola vuelta con el móvil, cada pedido se aparca en su balda con QR y al cargar se escanea y sale el albarán solo. Lo que no había stock para servir ya está en la propuesta de compra.",
  },
  {
    tag: "E-commerce y multicanal",
    icon: "🛒",
    title: "Picking por olas y etiqueta de envío en la misma sesión",
    body: "Muchos pedidos de pocas líneas: se agrupan en oleadas por hora de recogida de la agencia y se recogen pick-to-box. Al cerrar el pedido se imprime su etiqueta de envío y la expedición con escaneo genera el documento de salida sin volver a teclear nada.",
  },
  {
    tag: "Palet completo",
    icon: "🏗️",
    title: "Preparar sobre el palet y expedir el palet con su SSCC",
    body: "Para pedidos grandes, el pedido se prepara directamente sobre un palet que nace con su etiqueta SSCC estándar GS1. Al expedir sale el palet completo con su trazabilidad, y escanear ese SSCC dentro del albarán o la factura arrastra sus líneas agrupadas y blindadas.",
  },
];

const faqs = [
  {
    q: "¿Qué es la preparación de pedidos y en qué se diferencia del picking?",
    a: "La preparación de pedidos es el proceso completo que va desde que un pedido se confirma hasta que la mercancía sale por el muelle: decidir qué pedidos son servibles, recogerlos, dejarlos identificados y expedirlos. El picking es solo una parte de ese proceso — el acto de recoger físicamente el producto de su ubicación. Y la expedición es la parte final: verificar lo preparado, cargarlo y generar el documento de salida. En Drenpos los tres pasos viven en el mismo flujo: semáforo de preparabilidad, asistente de picking móvil y expedición con escaneo que genera el albarán o la factura.",
  },
  {
    q: "¿Qué es el picking por oleadas y cuándo conviene?",
    a: "El picking por oleadas consiste en lanzar varios pedidos a la vez agrupados por un criterio común (urgencia, ruta de reparto u hora de salida) para recorrer el almacén una sola vez en lugar de una vez por pedido. Conviene cuando hay muchos pedidos de pocas líneas y las salidas tienen horario, porque la oleada se organiza alrededor del camión o de la recogida de la agencia. No conviene si los pedidos llegan de forma continua y hay que servirlos según entran, sin ventanas de salida. En Drenpos la oleada consolida una única ruta por el almacén con recogida pick-to-box.",
  },
  {
    q: "¿Cómo sé qué pedidos puedo servir completos hoy?",
    a: "Con el semáforo de preparabilidad del listado de preparación. Muestra qué pedidos se pueden servir completos con el stock actual, cuáles tienen faltas y qué está de camino en pedidos de compra, de modo que se decide qué se prepara antes de que nadie recorra el almacén. Además, las alertas de pedidos cruzan la demanda pendiente con el stock físico y avisan de cuántas unidades faltan por comprar para servirlo todo, y la propuesta de compra asistida deja el pedido de compra listo en un clic.",
  },
  {
    q: "¿El preparador necesita una pistola lectora o vale el móvil?",
    a: "Valen las dos cosas. El asistente de picking está pensado para móvil y para pistola lectora: se puede escanear con un lector dedicado o con la cámara del móvil, y todas las pantallas funcionan en móvil y tablet para trabajar a pie de estantería. Muchos almacenes empiezan con el móvil que ya tiene el equipo y añaden pistolas después, sin cambiar de sistema ni de forma de trabajar.",
  },
  {
    q: "¿Cómo evito servir el lote equivocado?",
    a: "El asistente de picking sugiere el lote en cada línea según el criterio configurado: FIFO (primero en entrar, primero en salir), LIFO (último en entrar, primero en salir) o FEFO (primero en caducar, primero en salir). Cuando está configurado, el sistema selecciona el lote automáticamente sin intervención manual, y la validación de lotes y series se aplica con las mismas reglas que en el resto de documentos. Cada salida queda vinculada al lote que se sirvió, así que la trazabilidad muestra después a qué cliente fue cada lote.",
  },
  {
    q: "¿Se genera el albarán solo al expedir?",
    a: "Sí. Al escanear el pedido preparado, la expedición genera el albarán o la factura automáticamente, con trazabilidad documental completa entre el pedido y el documento resultante. Antes de eso se puede exigir una verificación configurable (recuento de control), y si el pedido se preparó sobre un palet sale el palet completo con su etiqueta SSCC y su trazabilidad. Nadie vuelve a teclear las líneas del pedido en un documento de salida.",
  },
  {
    q: "¿Puedo preparar el pedido directamente sobre un palet?",
    a: "Sí. El pedido se puede preparar sobre un palet que nace con su etiqueta SSCC estándar GS1 imprimible en rollo o A4, y al expedir sale el palet completo con su trazabilidad. Dentro del palet cabe cualquier mezcla de productos, lotes y series, y escanear ese SSCC dentro de un albarán o una factura arrastra el palet entero con sus líneas agrupadas y blindadas. La alternativa es la zona de preparados: baldas con QR donde se aparcan los pedidos listos y que se escanean para saber dónde está cada uno.",
  },
  {
    q: "¿Cuánto cuesta y cuánto se tarda en implantarlo?",
    a: "La preparación de pedidos forma parte del módulo de Almacén de Drenpos, desde 19,90 €/mes sin IVA, sin coste por uso ni permanencia y con soporte humano incluido; existe también despliegue on-premise en el servidor del cliente, a presupuesto. La implantación estándar se hace en días: importamos los artículos, definimos almacenes y ubicaciones, imprimimos las etiquetas QR de ubicaciones y baldas, cargamos el stock inicial y formamos al equipo.",
  },
];

// Landings hermanas del clúster de almacén
const hermanas = [
  {
    url: "/software-gestion-almacen",
    title: "Software de gestión de almacén (SGA)",
    body: "El módulo completo: ubicaciones con QR, lotes con FEFO, trazabilidad, palets con SSCC e inventarios.",
  },
  {
    url: "/software-alquiler-huecos-palet",
    title: "Depósito de terceros y alquiler de huecos",
    body: "Custodia de mercancía ajena con tarifario por palet/día, posición en vivo y liquidación.",
  },
  {
    url: "/software-almacen-frigorifico",
    title: "Almacén frigorífico y de congelados",
    body: "Cadena de frío, FEFO, palets a pie de cámara y operativa en móvil dentro de la cámara.",
  },
  {
    url: "/software-almacen-tienda",
    title: "Almacén y TPV para tienda",
    body: "Si además vendes en mostrador: stock descontado en cada ticket, sin dobles capturas.",
  },
];

const articulos = [
  { t: "Preparación de pedidos y picking: guía práctica", s: "preparacion-de-pedidos-picking-almacen" },
  { t: "Etiqueta SSCC: qué es y cómo se genera", s: "etiqueta-sscc-gs1-palets" },
  { t: "WMS, SGA y ERP: en qué se diferencian y cuál necesitas", s: "wms-sga-erp-diferencias" },
