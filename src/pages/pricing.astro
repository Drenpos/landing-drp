---
import { decimal, valor } from "@/lib/precios";
import { abs } from "@/lib/site";
import { breadcrumb, faqPage, softwareApp } from "@/lib/schema";
import JsonLd from "@/components/JsonLd.astro";
export const prerender = true;
import Base from "@/layouts/Base.astro";
import PageHeader from "@/partials/PageHeader.astro";
import PricingSection from "@/partials/PricingSection.astro";
import { getEntry, type CollectionEntry } from "astro:content";
import PlansComparison from "@/partials/PlansComparison.astro";
import ModulesTableCollapsible from "@/partials/ModulesTableCollapsible.astro";

const PATH = "/pricing";
const CANONICAL = abs(PATH);

const pricingIndex = (await getEntry(
  "pricing",
  "-index",
)) as CollectionEntry<"pricing">;

const { title, description, meta_title, image, hero } = pricingIndex.data;

// ── Precios (sin IVA) ────────────────────────────────────────────────────
// Precios desde src/config/precios.json (ver src/lib/precios.ts).
const planes = [
  {
    nombre: "Facturación",
    precio: decimal(valor("facturacion")),
    para: "Autónomos y pequeñas empresas que necesitan facturar y llevar los cobros.",
    incluye:
      "[[n:facturacion_usuarios]] usuarios y [[n:facturacion_fichajes]] personas que fichan, facturación con Verifactu, DeCA, OCR de facturas de proveedor, remesas SEPA, informes y envío por email y WhatsApp.",
  },
  {
    nombre: "Tienda y Hostelería",
    precio: decimal(valor("tienda")),
    para: "Tiendas, bares y restaurantes que cobran en caja.",
    incluye:
      "[[n:tienda_usuarios]] usuarios y [[n:tienda_fichajes]] personas que fichan, todo lo del plan Facturación y el TPV de tienda y de hostelería con mapa de sala, comanderos, pantallas de cocina y QR en las mesas.",
  },
  {
    nombre: "Almacén",
    precio: decimal(valor("almacen")),
    para: "Distribuidores y negocios con almacén.",
    incluye:
      "[[n:almacen_usuarios]] usuarios y [[n:almacen_fichajes]] personas que fichan, todo lo del plan Facturación y el inventario completo: lotes, caducidades, ubicaciones, plano, picking con pistola, propuesta de compra y palets SSCC.",
  },
  {
    nombre: "Producción",
    precio: decimal(valor("produccion")),
    para: "Talleres, obradores y fábricas pequeñas.",
    incluye:
      "[[n:produccion_usuarios]] usuarios y [[n:produccion_fichajes]] personas que fichan, todo lo del plan Almacén y órdenes de trabajo por fases, escandallos, horas por operario y coste real de cada orden.",
  },
];

// ── Preguntas frecuentes de precios ───────────────────────────────────────
const faqs = [
  {
    q: "¿Cuánto cuesta Drenpos?",
    a: "Hay cuatro planes, sin IVA: Facturación a [[p:facturacion]] al mes, Tienda y Hostelería a [[p:tienda]], Almacén a [[p:almacen]] y Producción a [[p:produccion]]. Cada uno trae sus usuarios y las personas que pueden fichar. Si pagas el año, te regalamos dos meses. No hay permanencia.",
  },
  {
    q: "¿Qué plan me conviene?",
    a: "Si solo facturas, Facturación. Si cobras en caja, en una tienda o en un bar, Tienda y Hostelería. Si tienes almacén y necesitas lotes, caducidades o ubicaciones, Almacén, y si además vendes en mostrador le añades el TPV. Si fabricas, Producción. Si no lo tienes claro, escríbenos y lo vemos contigo.",
  },
  {
    q: "¿Qué puedo añadir a mi plan?",
    a: "Usuarios de más a [[p:usuario]] al mes, personas de más que fichan a [[p:fichaje]], otra caja o comandero a [[p:caja]], el TPV en Almacén o Producción a [[p:tpv]], comerciales con sus comisiones a [[p:comerciales]], el conector con ChatGPT o Claude a [[p:mcp]] y soporte prioritario a [[p:soporte]]. Las agencias de transporte y los conectores con Holded, WooCommerce y Faire no tienen coste: los activas si los necesitas.",
  },
  {
    q: "¿Solo quiero el control horario, sin facturar. ¿Se puede?",
    a: "Sí. Drenpos Equipo es el mismo módulo de fichajes sin el resto del programa: [[p:equipo10]] al mes hasta 10 personas, [[p:equipo25]] hasta 25 y [[p:equipo50]] hasta 50. Lleva vacaciones, turnos rotativos, calendarios, avisos de retrasos y el terminal si lo quieres. Si un día quieres facturar, pasas a un plan sin perder nada.",
  },
  {
    q: "¿Los precios llevan IVA?",
    a: "No. Todos los precios de la web son sin IVA. En la factura verás el 21 % aparte.",
  },
  {
    q: "¿Cómo se pone en marcha?",
    a: "Depende de cada negocio. Hay quien se da de alta y empieza a facturar esa misma tarde, y quien necesita que le carguemos el catálogo, los clientes y el stock, o que le configuremos la cocina y las impresoras. Lo hablamos antes de empezar y te decimos qué hace falta en tu caso.",
  },
  {
    q: "¿Puedo tenerlo en mi propio servidor?",
    a: "Sí. Drenpos funciona entero en el servidor de la empresa, con las mismas actualizaciones que la nube, copias diarias fuera y supervisión. Cada instalación es distinta, así que la estudiamos y te pasamos una propuesta.",
  },
  {
    q: "¿Hay descuento si mi empresa es nueva?",
    a: "Sí. Si eres una startup de menos de [[n:nuevas_antiguedad_startup]] años, o tu empresa o tu alta de autónomo tiene menos de [[n:nuevas_antiguedad]] años, y facturas menos de [[p:nuevas_facturacion_max]] al año, tienes la mitad de la cuota durante tres meses. Si en ese tiempo usas el programa ([[n:nuevas_documentos]] documentos de venta o [[n:nuevas_dias_fichaje]] días de fichajes) y sigues por debajo de [[p:nuevas_facturacion_prorroga_max]], se alarga otros tres. Lo comprobamos con tus propios datos.",
  },
  {
    q: "¿Hay permanencia?",
    a: "No. Cambias de plan, añades o quitas módulos y te das de baja cuando quieras.",
  },
  {
    q: "¿Las actualizaciones se pagan aparte?",
    a: "No. Todos los clientes están en la misma versión y las mejoras llegan solas, también las que obliga la ley como Verifactu o el DeCA.",
  },
  {
    q: "¿El soporte está incluido?",
    a: "Sí, por email en todos los planes, y también por teléfono y WhatsApp a partir de Tienda y Hostelería. Si necesitas que te respondamos en menos de 4 horas, existe el soporte prioritario.",
  },
  {
    q: "¿Puedo verlo antes de contratar?",
    a: "Sí. Te enseñamos el programa en una videollamada de unos 20 minutos con ejemplos de tu negocio. Se pide desde la página de contacto.",
  },
];

// ── Datos estructurados ──────────────────────────────────────────────────
const breadcrumbSchema = breadcrumb([{ name: "Precios", path: PATH }]);

const offersSchema = {
  ...softwareApp({
    name: "Drenpos ERP",
    path: PATH,
    description:
      "Programa de gestión para pymes y autónomos en España: facturación con Verifactu y DeCA, TPV para tienda y hostelería, almacén con lotes y ubicaciones, producción y control horario. Cuatro planes y módulos opcionales, sin permanencia.",
  }),
  operatingSystem: "Web, iOS, Android (PWA)",
  inLanguage: "es-ES",
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "EUR",
    lowPrice: decimal(valor("desde")),
    highPrice: decimal(valor("hasta")),
    offerCount: planes.length,
    url: CANONICAL,
    offers: planes.map((p) => ({
      "@type": "Offer",
      name: `Plan ${p.nombre}`,
      price: p.precio,
      priceCurrency: "EUR",
      description: `${p.para} Incluye ${p.incluye} Precio mensual sin IVA.`,
      url: CANONICAL,
      availability: "https://schema.org/InStock",
      priceSpecification: {
        "@type": "UnitPriceSpecification",
        price: p.precio,
        priceCurrency: "EUR",
        valueAddedTaxIncluded: false,
        unitCode: "MON",
        referenceQuantity: {
          "@type": "QuantitativeValue",
          value: 1,
          unitCode: "MON",
        },
      },
    })),
  },
};

const faqSchema = faqPage(faqs);
---

<Base
  title={title}
  meta_title={meta_title}
  image={image}
  description={description}
  canonical={CANONICAL}
>
  <JsonLd data={[breadcrumbSchema, offersSchema, faqSchema]} />

  <PageHeader title={hero.title} description={hero.description} />

  <!-- ═══════════ RESPUESTA DIRECTA (front-loading GEO/AEO) ═══════════ -->
  <section class="section-up pb-0">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-9 mb-8" data-aos="fade-up-sm">
          <a
            href="/empresas-nuevas"
            class="group flex flex-col items-center gap-3 rounded-2xl px-6 py-5 text-center no-underline sm:flex-row sm:justify-center sm:gap-4 sm:text-left"
            style="background: rgba(121,27,70,0.08); border: 1px solid rgba(121,27,70,0.18);"
          >
            <span class="flex-shrink-0 rounded-full px-3 py-1 text-sm font-semibold uppercase text-white" style="background: #791b46;">
              Empresas nuevas
            </span>
            <span class="text-base lg:text-lg" style="color: #101928;">
              <strong>[[n:nuevas_descuento]] % de descuento durante [[n:nuevas_meses]] meses</strong>
              para startups de menos de [[n:nuevas_antiguedad_startup]] años y empresas o autónomos de menos de [[n:nuevas_antiguedad]] años.
              <span class="font-semibold underline underline-offset-4 whitespace-nowrap" style="color: #791b46;">Ver condiciones</span>
            </span>
          </a>
        </div>
        <div class="lg:col-9 text-center" data-aos="fade-up-sm">
          <p class="text-lg leading-relaxed mb-10" style="color: rgba(16,25,40,0.72);">
            Hay un plan para cada tipo de negocio: <strong>Facturación</strong>,
            <strong>Tienda y Hostelería</strong>, <strong>Almacén</strong> y
            <strong>Producción</strong>. Cada uno trae los usuarios y las personas
            que fichan, y lo que no necesites no lo pagas. Comerciales, agencias de
            transporte, conectores o el asistente de IA se añaden aparte si te hacen
            falta. Si solo quieres el control horario, tienes
            <a href="/control-horario#equipo" class="text-primary font-medium underline">Drenpos Equipo</a>,
            y si tu empresa acaba de empezar, mira el
            <a href="/empresas-nuevas" class="text-primary font-medium underline">programa para empresas nuevas</a>.
            Cualquier plan se puede instalar también en el servidor de tu empresa.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- relative z-20: la cabecera (PageHeader, z-10 y alto fijo) se solapa
       con esta zona según el ancho de pantalla y tapaba el selector
       mensual/anual. -->
  <div class="relative z-20 pb-0">
    <PricingSection isSection={true} />
    <PlansComparison isSection={true} />
    <ModulesTableCollapsible isSection={true} />
  </div>

  <!-- ═══════════════ FAQ DE PRECIOS ═══════════════ -->
  <section class="section">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-10 text-center mb-12" data-aos="fade-up-sm">
          <span class="text-primary bg-primary/10 px-3 py-1 inline-block rounded-full uppercase text-sm font-medium mb-4">Preguntas frecuentes</span>
          <h2 class="h3 font-bold mb-3">Precios: lo que más nos preguntan</h2>
          <p class="text-lg" style="color: rgba(16,25,40,0.65);">
            Si tu duda no está aquí, <a href="/contact" class="text-primary font-semibold underline">escríbenos</a> y te ayudamos a elegir.
          </p>
        </div>
        <div class="lg:col-10">
          <div class="flex flex-col gap-3">
            {faqs.map((f, i) => (
              <details class="group rounded-2xl border bg-white" style="border-color: rgba(16,25,40,0.1);" data-aos="fade-up-sm" data-aos-delay={i * 40}>
                <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none">
                  <h3 class="font-semibold text-base lg:text-lg mb-0">{f.q}</h3>
                  <span class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 transition-transform duration-200 group-open:rotate-45 text-xl leading-none" style="background: rgba(121,27,70,0.10); color: #791b46;" aria-hidden="true">+</span>
                </summary>
                <div class="px-6 pb-6 -mt-2">
                  <p class="text-base leading-relaxed mb-0" style="color: rgba(16,25,40,0.72);">{f.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
