  <ClientLogosStrip />

  <!-- ═══════════════════════════════════════════════════════════════════
       DEFINICIÓN CITABLE (AEO / featured snippet)
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section-sm pb-0">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-9 text-center" data-aos="fade-up-sm">
          <h2 class="h4 font-bold mb-4">¿Qué es un dispositivo de fichaje?</h2>
          <p class="text-lg leading-relaxed text-dark/72">
            Un <strong>dispositivo de fichaje</strong> es un terminal físico
            que registra la entrada y la salida de cada trabajador cuando este
            se identifica ante él con un llavero, una tarjeta, un código QR o
            un dato biométrico. El terminal de Drenpos lee
            <strong>llaveros RFID y códigos QR personales</strong>, muestra en
            pantalla el nombre y la foto del empleado, y envía cada fichaje al
            software de control horario con <strong>sellado temporal
            inalterable</strong>, que es lo que la Inspección de Trabajo pide
            ver. Como identifica con llavero o QR, no trata datos
            biométricos.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       CÓMO FUNCIONA (3 pasos)
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section-sm">
    <div class="container">
      <div class="text-center mb-12" data-aos="fade-up-sm">
        <h2 class="h3 font-bold mb-4">Cómo funciona el terminal de fichaje</h2>
        <p class="text-lg text-dark/65">
          Tres pasos y ninguno necesita un técnico.
        </p>
      </div>
      <div class="row g-4 justify-center">
        {
          pasos.map((p, i) => (
            <div class="md:col-6 lg:col-4" data-aos="fade-up-sm" data-aos-delay={i * 100}>
              <div class="h-full rounded-3xl border border-dark/10 bg-body p-7 hover:shadow-xl transition-shadow duration-300">
                <div class="w-11 h-11 rounded-2xl flex items-center justify-center text-lg font-bold text-white mb-4 bg-primary">{p.n}</div>
                <h3 class="h6 font-bold mb-3 leading-snug">{p.title}</h3>
                <p class="text-sm text-dark/65">{p.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       GESTIÓN DE EQUIPO (AEO): lo que hay detrás del terminal
  ═══════════════════════════════════════════════════════════════════ -->
  <section id="gestion-equipo" class="section pt-0 overflow-hidden scroll-mt-24">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-12" data-aos="fade-up-sm">
