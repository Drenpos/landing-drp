    { "@type": "PropertyValue", name: "Identificación", value: "Llavero RFID, tarjeta o QR" },
    { "@type": "PropertyValue", name: "Personalización", value: "Logo del cliente en carcasa y llaveros" },
  ],
  offers: {
    "@type": "Offer",
    price: decimal(valor("terminal")),
    priceCurrency: "EUR",
    priceValidUntil: "2027-12-31",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
    url: CANONICAL,
    valueAddedTaxIncluded: false,
    description: "Terminal desde [[p:terminal]] sin IVA con llaveros personalizados. Fichajes incluidos en el plan; [[p:fichaje]]/usuario/mes cada persona adicional.",
    seller: { "@id": ORG_ID },
  },
};

const jsonLd = [
  breadcrumb([
    { name: "Control horario", path: "/control-horario" },
    { name: "Dispositivo de fichaje", path: PATH },
  ]),
  productSchema,
  faqPage(faqs),
];
