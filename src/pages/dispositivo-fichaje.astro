                  <div class="absolute bottom-0 inset-x-0 p-5" style="background: linear-gradient(to top, color-mix(in oklab, var(--color-dark) 85%, transparent), transparent);">
                    <p class="text-white font-bold mb-0.5">Placa propia, revisión v2</p>
                    <p class="text-xs text-white/75">Diseñada por Drenpos: lector, pantalla y alimentación a 12 V en una sola placa.</p>
                  </div>
                </div>
                <div class="rounded-2xl overflow-hidden relative flex-1 border border-white/10" data-aos="fade-up-sm" data-aos-delay="200">
                  <img src={`${IMG}/03-tarjetas-qr.png`} alt="Tarjeta de fichaje con foto del empleado y código QR personal, impresa desde Drenpos" width="789" height="610" class="w-full h-full object-cover block" loading="lazy" style="max-height: 260px;" />
                  <div class="absolute bottom-0 inset-x-0 p-5" style="background: linear-gradient(to top, color-mix(in oklab, var(--color-dark) 85%, transparent), transparent);">
                    <p class="text-white font-bold mb-0.5">Tarjeta con QR</p>
                    <p class="text-xs text-white/75">Se imprime desde la ficha del empleado. Sirve como alternativa al llavero.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="row g-4">
            {
              ventajas.map((v, i) => (
                <div class="md:col-6 lg:col-3" data-aos="fade-up-sm" data-aos-delay={(i % 4) * 100}>
                  <div class="rounded-2xl p-6 h-full bg-white/5 border border-white/8">
                    <div class="text-2xl mb-3">{v.icon}</div>
                    <p class="text-white font-semibold mb-1.5">{v.title}</p>
                    <p class="text-sm text-white/72">{v.body}</p>
                    {v.href && (
                      <a href={v.href} target="_blank" rel="noopener" class="text-xs underline mt-2 inline-block text-accent">{v.hrefText}</a>
