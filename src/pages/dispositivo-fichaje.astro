                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       FICHA TÉCNICA (tabla AEO)
  ═══════════════════════════════════════════════════════════════════ -->
  <section id="ficha-tecnica" class="section pt-0 overflow-hidden scroll-mt-24">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-9">
          <div class="text-center mb-10" data-aos="fade-up-sm">
            <h2 class="h3 font-bold mb-4">Ficha técnica del terminal de fichaje</h2>
            <p class="text-lg text-dark/65">
              Lo que hay dentro de la caja, sin adornos.
            </p>
          </div>
          <div class="overflow-x-auto rounded-3xl border border-dark/10" data-aos="fade-up-sm">
            <table class="w-full text-sm border-collapse">
              <tbody>
                {
                  ficha.map((f, i) => (
                    <tr class={i % 2 === 0 ? "bg-primary/5" : ""}>
                      <th scope="row" class="text-left p-4 font-bold align-top w-40">{f.k}</th>
                      <td class="p-4 text-dark/75">{f.v}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="text-xs mt-4 text-dark/55" data-aos="fade-up-sm">
            Consumo máximo 36 W. Para exteriores a la intemperie o zonas con
            agua consúltanos: el terminal está pensado para interior y para
            vehículos.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       COMPARATIVA (tabla de decisión, AEO)
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section pt-0 overflow-hidden">
    <div class="container">
      <div class="text-center mb-10" data-aos="fade-up-sm">
        <h2 class="h3 font-bold mb-4">¿Qué sistema de fichaje te conviene?</h2>
        <p class="text-lg text-dark/65">
          Las cuatro opciones que se plantea una pyme, comparadas con honestidad.
        </p>
      </div>
      <div class="overflow-x-auto" data-aos="fade-up-sm">
        <table class="w-full text-sm border-collapse min-w-[1040px]">
          <thead>
            <tr class="bg-dark text-white">
              <th class="text-left p-4 rounded-tl-2xl">Opción</th>
              <th class="text-left p-4">Cómo se ficha</th>
              <th class="text-left p-4">Datos biométricos</th>
              <th class="text-left p-4">Tu logo</th>
              <th class="text-left p-4">Válido ante Inspección</th>
              <th class="text-left p-4">Sin internet</th>
              <th class="text-left p-4 rounded-tr-2xl">Coste</th>
            </tr>
          </thead>
          <tbody>
            {
              comparativa.map((r) => (
                <tr class={r.destacado ? "bg-primary/5 font-medium" : "border-b border-dark/5"}>
