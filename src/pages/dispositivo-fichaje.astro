---
export const prerender = true;
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import ClientLogosStrip from "@/partials/ClientLogosStrip.astro";
import DemoForm from "@/partials/DemoForm.astro";
import { existsSync } from "node:fs";
import { join } from "node:path";

// ════════════════════════════════════════════════════════════════════════
//  Dispositivo de fichaje · landing de producto (hardware propio)
//  Intención de búsqueda objetivo:
//    - "dispositivo de fichaje" / "terminal de fichaje" (principal)
//    - "lector de fichaje RFID" / "reloj de fichar para empresas"
//    - "fichaje con llavero" / "fichaje con tarjeta" / "fichaje por QR"
//    - "terminal de control de presencia sin huella" (sin biometría)
//    - long-tail: fichaje en obra / furgoneta / 12V, terminal con logo
//    - long-tail: fichaje sin internet / terminal de fichaje offline /
//      fichar en obra sin cobertura (sección #sin-conexion)
//  Diferenciación con /control-horario: aquella vende el software y todos
//  los métodos de fichaje; esta vende el hardware físico (ficha técnica,
//  personalización con la marca del cliente, precio y compra suelta).
//  Fotos: /public/images/funcionalidades/control-horario/hardware/
// ════════════════════════════════════════════════════════════════════════

const CANONICAL = "https://www.drenpos.com/dispositivo-fichaje";
const IMG = "/images/funcionalidades/control-horario/hardware";

// Imágenes opcionales: solo se renderizan si el fichero existe en /public
const hasImg = (p: string) => existsSync(join(process.cwd(), "public", p));
const OFFLINE_IMG = `${IMG}/v2-terminal-furgoneta.webp`;
const showOfflineImg = hasImg(OFFLINE_IMG);

// Modo sin conexión (sección #sin-conexion)
const offline = [
  {
    n: "1",
    title: "La cuadrilla ficha en el tajo",
    body: "Cada persona pasa su llavero RFID o su QR como cualquier día. El terminal va alimentado a 12 V desde el mechero de la furgoneta o una batería auxiliar.",
  },
  {
    n: "2",
    title: "El terminal guarda cada fichaje con su hora",
    body: "Sin red, cada entrada y salida se queda en la memoria local del terminal con la hora exacta de su reloj integrado.",
  },
  {
    n: "3",
    title: "Al volver, se sincroniza solo",
    body: "En cuanto coge la WiFi de la oficina o de la nave, vuelca a Drenpos todos los fichajes pendientes con su hora original. Nadie tiene que hacer nada. Si quieres sincronizar antes, comparte datos desde un móvil.",
  },
];

// Ficha técnica (solo datos reales del terminal v2)
const ficha = [
  { k: "Lectura", v: "Llavero o tarjeta RFID y código QR personal de cada empleado" },
  { k: "Pantallas", v: "Pantalla de estado (nombre y foto del empleado, fichaje o desfichaje) y ventana de lectura iluminada" },
  { k: "Alimentación", v: "12 V y 3 A. Fuente de red, batería auxiliar o toma de mechero del vehículo" },
  { k: "Conectividad", v: "WiFi con antena externa. Con red, cada fichaje se sincroniza al momento con Drenpos con sellado temporal; sin red, lo guarda y lo envía después" },
  { k: "Sin conexión", v: "Sigue fichando: guarda cada fichaje en su memoria local con la hora de su reloj integrado y lo vuelca a Drenpos, con su hora original, al recuperar la red" },
  { k: "Electrónica", v: "Placa propia diseñada por Drenpos (revisión v2), con la versión de firmware visible en pantalla" },
  { k: "Carcasa", v: "Impresa en 3D en PETG, con el logo de tu empresa en el frontal si lo quieres" },
  { k: "Ubicación", v: "Interior: naves, almacenes, talleres, oficinas y hostelería. Portátil en obra o furgoneta" },
  { k: "Mantenimiento", v: "Actualizaciones de firmware desde su propio panel web, sin desmontarlo ni enviarlo" },
];

const pasos = [
  {
    n: "1",
    title: "Das de alta al equipo",
    body: "Cada empleado tiene su ficha en Drenpos con foto. Le asignas un llavero RFID o le imprimes su tarjeta QR desde la propia ficha.",
  },
  {
    n: "2",
    title: "Enchufas el terminal",
    body: "Lo alimentas a 12 V y lo conectas a tu WiFi desde su panel web. En pared, sobre un mostrador o en la cabina de la furgoneta. Si donde fichas no hay red, ficha igual y sincroniza al volver.",
  },
  {
    n: "3",
    title: "El equipo ficha en un gesto",
    body: "Acercar el llavero o mostrar el QR. La pantalla confirma con el nombre y la foto del empleado, y el fichaje queda guardado con su hora exacta: en Drenpos al momento si hay red, o en cuanto el terminal se reconecta.",
  },
];

const ventajas = [
  {
    icon: "🏷️",
    title: "Con tu logo, no con el nuestro",
    body: "La carcasa se imprime con la marca de tu empresa en el frontal. El terminal que ve tu plantilla cada mañana lleva tu nombre, y los llaveros también se personalizan.",
  },
  {
    icon: "🛠️",
    title: "Diseño y fabricación propios",
    body: "Placa electrónica, firmware y carcasa son nuestros. No revendemos un terminal genérico: si tu operativa necesita algo distinto, lo adaptamos nosotros.",
  },
  {
    icon: "🙅",
    title: "Sin huella ni reconocimiento facial",
    body: "Ficha con llavero o QR, sin tratar datos biométricos. Evitas el régimen reforzado que la AEPD aplica a la huella y a la cara, y el empleado no necesita móvil.",
  },
  {
    icon: "🔒",
    title: "Registro inalterable",
    body: "Cada fichaje llega a Drenpos con fecha y hora exactas. Las correcciones posteriores quedan trazadas con autor, momento y motivo, listas para la Inspección.",
  },
  {
    icon: "🔌",
    title: "Funciona a 12 V",
    body: "Se alimenta desde el mechero de cualquier coche o furgoneta o desde una batería auxiliar. Va a la obra o a la finca aunque allí no haya cobertura, y el mismo terminal sirve para la nave.",
  },
  {
    icon: "📶",
    title: "Ficha aunque no haya internet",
    body: "Si se cae la WiFi o no hay cobertura, el terminal guarda cada fichaje con la hora de su reloj integrado. Al recuperar la red los envía solo a Drenpos, con su hora original.",
  },
  {
    icon: "📦",
    title: "Se compra suelto",
    body: "Puedes adquirir solo el terminal con sus llaveros como control de presencia. Si después quieres el resto del sistema, se integra sin perder un fichaje.",
  },
  {
    icon: "🔄",
    title: "Se actualiza desde su panel web",
    body: "Las actualizaciones de firmware se aplican desde el panel web del propio terminal, sin desmontarlo ni enviarlo. La versión instalada se ve en la pantalla.",
  },
];

// Comparativa de decisión (AEO)
const comparativa = [
  {
    opcion: "Hoja de papel o Excel",
    metodo: "Firma o celda editable",
    biometria: "No",
    logo: "No",
    legal: "No es inalterable: infracción grave",
    sinRed: "Sí, pero sin validez legal",
    precio: "«Gratis» (hasta la primera inspección)",
  },
  {
    opcion: "Terminal biométrico genérico",
    metodo: "Huella o cara",
    biometria: "Sí, con evaluación de impacto",
    logo: "No",
    legal: "Depende del software al que se conecte",
    sinRed: "Depende del modelo",
    precio: "150 a 600 € + licencia aparte",
  },
  {
    opcion: "App en el móvil de cada empleado",
    metodo: "Botón en el teléfono personal",
    biometria: "No",
    logo: "No",
    legal: "Sí, si el software sella y traza",
    sinRed: "Depende de la app y de la cobertura",
    precio: "Licencia por usuario",
  },
  {
    opcion: "Terminal Drenpos",
    metodo: "Llavero RFID o QR, sin móvil",
    biometria: "No",
    logo: "Sí, en carcasa y llaveros",
    legal: "Sí: sellado, trazado y exportable",
    sinRed: "Sí, guarda y sincroniza al volver",
    precio: "Desde 140 € el terminal",
    destacado: true,
  },
];

const casos = [
  {
    tag: "Almacén y distribución",
    icon: "🏭",
    title: "Terminal en la entrada de la nave",
    body: "Los operarios fichan con el llavero al entrar y al salir, con guantes puestos y sin sacar el móvil. El encargado ve la plantilla en tiempo real desde su panel y exporta el reporte a fin de mes.",
  },
  {
    tag: "Taller y fábrica",
    icon: "🔧",
    title: "Tiempos por concepto sin teclado",
    body: "El mismo llavero inicia y detiene la jornada. Los conceptos de fichaje (producción, mantenimiento, formación) se configuran en Drenpos y los reportes reparten las horas donde toca.",
  },
  {
    tag: "Obra y equipos móviles",
    icon: "🚐",
    title: "El terminal viaja en la furgoneta",
    body: "Conectado al mechero, va a la obra aunque allí no haya cobertura. La cuadrilla ficha con su llavero antes de bajar la herramienta y el terminal guarda cada fichaje con su hora. Al volver a la nave coge la WiFi y lo sincroniza todo, sin repartir apps al personal de temporada.",
  },
  {
    tag: "Hostelería y retail",
    icon: "☕",
    title: "Junto a la caja, con la marca del local",
    body: "Un terminal con el logo del negocio al lado del TPV. El personal ficha con su tarjeta QR y el turno partido queda registrado con sus pausas, sin discusiones a final de mes.",
  },
];

const faqs = [
  {
    q: "¿Qué es un dispositivo de fichaje?",
    a: "Es un terminal físico que registra la entrada y la salida de cada trabajador cuando este se identifica ante él, normalmente con un llavero o tarjeta RFID, un código QR o un dato biométrico. El terminal de Drenpos lee llaveros RFID y códigos QR personales, muestra en pantalla el nombre y la foto del empleado al fichar y envía cada registro al software de control horario con sellado temporal, de modo que el fichaje queda conservado de forma inalterable durante los cuatro años que exige la ley.",
  },
  {
    q: "¿Puedo comprar solo el terminal sin contratar Drenpos?",
    a: "Sí. El terminal, los llaveros y las tarjetas QR se venden como control de presencia independiente, con acceso al panel de fichajes para consultar y exportar los registros. Si más adelante quieres facturación, almacén o TPV, el módulo de fichajes ya está dentro del mismo sistema y no hay que migrar nada.",
  },
  {
    q: "¿Cuánto cuesta el dispositivo de fichaje?",
    a: "El terminal parte de 140 € sin IVA, con llaveros personalizados incluidos para tu plantilla inicial, y la licencia de fichaje de Drenpos cuesta desde 1 € por usuario y mes. En las implantaciones acompañadas el terminal va incluido con las llaves. Pide presupuesto si necesitas varios terminales, tarjetas adicionales o una carcasa con acabado especial.",
  },
  {
    q: "¿Se puede poner el logo de mi empresa en el terminal?",
    a: "Sí. La carcasa se imprime en 3D con el logo de tu empresa en el frontal, y los llaveros RFID también se personalizan con tu marca. Es la misma pieza que fabricamos para nosotros, con tu identidad: no es una pegatina.",
  },
  {
    q: "¿El fichaje con llavero RFID o QR es legal?",
    a: "Sí. El artículo 34.9 del Estatuto de los Trabajadores exige registrar la hora concreta de inicio y fin de la jornada de cada persona, y el Real Decreto-ley 8/2019 obliga a conservar esos registros cuatro años. Un terminal que sella cada fichaje y lo traslada a un sistema con trazabilidad de las modificaciones cumple esos requisitos. Además, al no usar huella ni cara, no trata datos biométricos.",
  },
  {
    q: "¿Necesita instalación o un técnico?",
    a: "No. El terminal se alimenta a 12 V con la fuente incluida, con una batería auxiliar o con el mechero del coche, y se conecta a tu WiFi desde su panel web. Puede ir fijado a la pared, apoyado en un mostrador o dentro de una furgoneta. Las actualizaciones de firmware se aplican desde ese mismo panel, sin desmontarlo.",
  },
  {
    q: "¿Qué pasa si se va la conexión a internet?",
    a: "El terminal sigue fichando. Guarda cada fichaje en su memoria local con la hora exacta de su reloj integrado y, cuando vuelve la conexión, los envía solo a Drenpos con su hora original. El empleado ficha igual con su llavero o su QR y nadie tiene que hacer nada. Conviene conectarlo con regularidad (lo normal es a diario) para que el registro esté al día si llega una inspección.",
  },
  {
    q: "¿Se puede usar en una obra sin cobertura conectado al mechero del coche?",
    a: "Sí. El terminal se alimenta a 12 V desde el mechero del coche o de la furgoneta, o desde una batería auxiliar, y ficha aunque allí no haya internet. La cuadrilla pasa su llavero o su QR, el terminal guarda los fichajes con su hora y, al volver a la oficina o a la nave, se conecta a la WiFi y sincroniza todo. Si quieres adelantarlo, comparte datos desde un móvil.",
  },
  {
    q: "¿La hora de un fichaje hecho sin conexión es fiable?",
    a: "Sí. El terminal lleva un reloj propio integrado y guarda cada fichaje con la hora exacta en que se hizo, no con la hora a la que se sincroniza. Al recuperar la red, el fichaje llega a Drenpos con esa hora original y entra en el registro inalterable como cualquier otro. Las correcciones posteriores siguen quedando trazadas con autor, momento y motivo.",
  },
  {
    q: "¿Qué ve el empleado al fichar?",
    a: "La pantalla de estado muestra Disponible mientras espera y, al acercar el llavero o el QR, enseña el nombre y la foto del empleado con el texto de fichaje o desfichaje. El propio empleado puede consultar después su historial desde la web o la app, como exige la normativa.",
  },
];

const articulos = [
  { t: "Fichaje portátil 12V: cumple la ley de jornada en cualquier lugar", s: "dispositivo-fichaje-portatil-12v-ley-control-jornada" },
  { t: "Registro horario digital: obligación, requisitos y sanciones", s: "registro-horario-digital" },
  { t: "Los mejores programas de control horario para pymes", s: "mejores-programas-control-horario" },
  { t: "Multas del registro horario: lo que cuesta incumplir", s: "multas-registro-horario-2026-costo-incumplimiento" },
  { t: "Fichar desde el móvil de forma legal", s: "fichar-desde-el-movil-legal-2026" },
  { t: "Por qué Excel ya no sirve para el control horario", s: "por-que-excel-ya-no-sirve-control-horario-2026" },
];

// ── Datos estructurados (JSON-LD) ──────────────────────────────────────
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: "https://www.drenpos.com/" },
    { "@type": "ListItem", position: 2, name: "Control horario", item: "https://www.drenpos.com/control-horario" },
    { "@type": "ListItem", position: 3, name: "Dispositivo de fichaje", item: CANONICAL },
  ],
};

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Terminal de fichaje Drenpos (RFID y QR)",
  url: CANONICAL,
  image: [
    `https://www.drenpos.com${IMG}/v2-terminal-marca-cliente.webp`,
    `https://www.drenpos.com${IMG}/v2-terminal-en-mano.webp`,
    `https://www.drenpos.com${IMG}/01-dispositivo-lector-rfid.png`,
  ],
  description:
    "Dispositivo de fichaje para empresas con lectura de llavero RFID y código QR, pantalla de estado con nombre y foto del empleado, alimentación a 12 V, placa electrónica propia y carcasa impresa en 3D con el logo del cliente. Sin biometría. Sincroniza cada fichaje con el software de control horario de Drenpos con sellado inalterable y sigue fichando sin internet: guarda los fichajes con su reloj propio y los envía al recuperar la red.",
  brand: { "@type": "Brand", name: "Drenpos" },
  manufacturer: { "@type": "Organization", name: "Drenpos Tech SL", url: "https://www.drenpos.com" },
  category: "Terminal de control de presencia",
  additionalProperty: [
    { "@type": "PropertyValue", name: "Lectura", value: "RFID y QR" },
    { "@type": "PropertyValue", name: "Alimentación", value: "12 V, 3 A" },
    { "@type": "PropertyValue", name: "Conectividad", value: "WiFi con antena externa" },
    { "@type": "PropertyValue", name: "Funcionamiento sin conexión", value: "Sí. Guarda los fichajes en local con reloj propio y los sincroniza al recuperar la red" },
    { "@type": "PropertyValue", name: "Biometría", value: "No" },
    { "@type": "PropertyValue", name: "Personalización", value: "Logo del cliente en carcasa y llaveros" },
  ],
  offers: {
    "@type": "Offer",
    price: "140",
    priceCurrency: "EUR",
    priceValidUntil: "2027-12-31",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
    url: CANONICAL,
    valueAddedTaxIncluded: false,
    description: "Terminal desde 140 € sin IVA con llaveros personalizados. Licencia de fichaje desde 1 €/usuario/mes.",
    seller: { "@type": "Organization", name: "Drenpos Tech SL" },
  },
};
---

<Base
  title="Dispositivo de Fichaje con Llavero RFID y QR · Drenpos"
  meta_title="Dispositivo de Fichaje RFID y QR para Empresas | Drenpos"
  description="Terminal de fichaje de Drenpos con llavero RFID o QR, sin huella, a 12 V y con tu logo. Ficha sin internet y sincroniza al volver. Desde 140 €."
  canonical={CANONICAL}
  image={`${IMG}/v2-terminal-cover.jpg`}
>
  <!-- Datos estructurados -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ═══════════════════════════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section-sm pb-0 relative z-10 overflow-hidden">
    <div class="absolute inset-0 z-0 pointer-events-none">
      <img src="/images/grainy.svg" alt="" width="1440" height="900" class="w-full h-full object-cover opacity-[.08]" />
    </div>

    <div class="container relative z-10">
      <nav aria-label="Migas de pan" class="mb-6 text-sm" style="color: rgba(16,25,40,0.55);">
        <a href="/" class="hover:text-primary">Inicio</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <a href="/control-horario" class="hover:text-primary">Control horario</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-primary font-medium">Dispositivo de fichaje</span>
      </nav>

      <div class="row gx-0 gy-12 lg:gy-0 items-center">
        <div class="lg:col-6" data-aos="fade-up-sm">
          <span class="text-primary bg-primary/10 px-4 py-1.5 inline-flex items-center gap-2 rounded-full uppercase text-sm font-medium mb-6">
            <span class="w-2 h-2 rounded-full" style="background: #16a34a;" aria-hidden="true"></span>
            Hardware propio · diseñado y fabricado en Extremadura
          </span>

          <h1 class="mb-5 text-h3 lg:text-h1 font-bold leading-tight">
            <span class="text-primary">Dispositivo de fichaje</span> con llavero RFID y QR, con tu logo en la carcasa
          </h1>
          <p class="text-lg mb-8 max-w-xl" style="color: rgba(16,25,40,0.72);">
            Un terminal de fichaje que tu equipo usa sin móvil y sin huella:
            acerca el llavero, la pantalla enseña su nombre y su foto, y la
            jornada queda registrada en Drenpos con sellado inalterable.
            <strong>Placa electrónica y carcasa propias</strong>, alimentación
            a <strong>12 V</strong> y personalización con la
            <strong>marca de tu empresa</strong>. Se compra suelto o con el
            sistema completo.
          </p>

          <ul class="flex flex-wrap gap-4 mb-10">
            <li data-aos="fade-up-sm" data-aos-delay="100">
              <a href="#demo-form" class="btn btn-dark">
                Pedir presupuesto
                <span class="icon-wrapper">
                  <span class="icon">
                    <svg width="19" height="12" viewBox="0 0 19 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12.5 1L17.5 6L12.5 11M1.5 6H17.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                  <span class="icon" aria-hidden="true">
                    <svg width="19" height="12" viewBox="0 0 19 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12.5 1L17.5 6L12.5 11M1.5 6H17.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                </span>
              </a>
            </li>
            <li data-aos="fade-up-sm" data-aos-delay="150">
              <a href="#ficha-tecnica" class="btn btn-light">Ver ficha técnica</a>
            </li>
          </ul>

          <div class="flex flex-wrap gap-x-8 gap-y-3 text-sm" style="color: rgba(16,25,40,0.62);">
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 text-white text-[10px] font-bold" style="background: #16a34a;">✓</span>
              Sin biometría
            </div>
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 text-white text-[10px] font-bold" style="background: #16a34a;">✓</span>
              Desde 140 € sin IVA
            </div>
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 text-white text-[10px] font-bold" style="background: #16a34a;">✓</span>
              Tu logo en el frontal
            </div>
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 text-white text-[10px] font-bold" style="background: #16a34a;">✓</span>
              Ficha sin internet
            </div>
          </div>
        </div>

        <div class="lg:col-6" data-aos="fade-up-sm" data-aos-delay="200">
          <div class="relative px-4 lg:px-0 pt-10 pb-10">
