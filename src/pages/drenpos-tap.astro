---
export const prerender = true;
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import DemoForm from "@/partials/DemoForm.astro";
import LandingMeta from "@/partials/LandingMeta.astro";
import JsonLd from "@/components/JsonLd.astro";
import { abs, AUTOR, ORG_ID } from "@/lib/site";
import { breadcrumb, faqPage } from "@/lib/schema";
import { decimal, valor } from "@/lib/precios";

// ════════════════════════════════════════════════════════════════════════
//  Drenpos Tap · página de producto (escaparate)
//  Qué es: la marca del terminal de fichaje que fabrica Drenpos. Esta página
//  enseña el aparato (parallax, giro de 360°, vídeos reales) y manda a la
//  demo. La ficha técnica, la comparativa y el precio detallado siguen en
//  /dispositivo-fichaje, que es la landing de búsqueda ("terminal de
//  fichaje", "dispositivo de fichaje"). Aquí la intención es de marca:
//  "drenpos tap", "terminal de fichaje drenpos".
//  Material: /public/images/drenpos-tap (recortes con transparencia y giro
//  de 15 fotogramas) y /public/video/drenpos-tap (clips reales, sin audio).
// ════════════════════════════════════════════════════════════════════════

const PATH = "/drenpos-tap";
const CANONICAL = abs(PATH);
const IMG = "/images/drenpos-tap";
const VID = "/video/drenpos-tap";
const PAGE_PUBLISHED = "2026-11-14";
const PAGE_UPDATED = "2026-11-14";

const SPIN_FRAMES = 15;
const spinFrames = Array.from({ length: SPIN_FRAMES }, (_, i) => `${IMG}/spin/tap-${String(i).padStart(2, "0")}.webp`);

// Etiquetas que aparecen durante el giro (fracción del recorrido en la que se enseñan)
const etiquetas = [
  { desde: 0.0, hasta: 0.16, lado: "izq", titulo: "Pantalla de estado", texto: "Nombre y foto de quien ficha, entrada o salida, hora y versión del firmware." },
  { desde: 0.06, hasta: 0.22, lado: "der", titulo: "Lector RFID y QR", texto: "Ventana iluminada. Lee llaveros, tarjetas y el QR personal de cada empleado." },
  { desde: 0.26, hasta: 0.46, lado: "der", titulo: "Rejilla de ventilación", texto: "La placa trabaja fría en una nave en agosto o en una cámara." },
  { desde: 0.5, hasta: 0.7, lado: "izq", titulo: "Anclajes de pared", texto: "Dos puntos de fijación. También se apoya en un mostrador o va en la furgoneta." },
  { desde: 0.56, hasta: 0.76, lado: "der", titulo: "Alimentación a 12 V", texto: "Fuente de red, batería auxiliar o mechero del vehículo." },
  { desde: 0.84, hasta: 1.0, lado: "izq", titulo: "Carcasa impresa en 3D", texto: "PETG, con el logo de tu empresa en el frontal si lo quieres." },
];

const pasos = [
  { t: "0,0 s", titulo: "Acercas", texto: "Llavero, tarjeta o el QR del móvil. Con guantes, con las manos ocupadas, sin mirar." },
  { t: "0,8 s", titulo: "Te reconoce", texto: "La pantalla enseña tu nombre y tu foto. Si el llavero no está dado de alta, el fichaje queda en cuarentena." },
  { t: "2,0 s", titulo: "Registrado", texto: "Hora exacta, sellada e inalterable. En Drenpos al momento si hay red; si no, en cuanto vuelve." },
];

const videos = [
  { src: "tap-tarjeta", titulo: "Con la tarjeta", texto: "La acercas a la ventana y el lector la coge antes de que la apoyes. La pantalla pasa de Disponible a Fichaje iniciado." },
  { src: "tap-llavero", titulo: "Con el llavero", texto: "El llavero lleva el logo de tu empresa. Lo mismo: un gesto y queda registrado." },
  { src: "tap-cerca", titulo: "De cerca", texto: "Confirmación en pantalla con nombre, foto y hora. El empleado sabe que ha fichado sin preguntar a nadie." },
];

const ventajas = [
  { titulo: "Ficha sin internet", texto: "Reloj propio. Si cae la WiFi o la obra no tiene cobertura, guarda cada fichaje con su hora y lo sube al volver la red." },
  { titulo: "Sin huella ni cara", texto: "Llavero, tarjeta o QR. No tratas datos biométricos y te ahorras la evaluación de impacto del RGPD." },
  { titulo: "Placa, firmware y carcasa propios", texto: "Lo diseñamos y lo fabricamos nosotros en Extremadura. Si tu operativa pide algo distinto, lo hacemos." },
  { titulo: "Se actualiza solo", texto: "El firmware se actualiza desde su panel web. Sin desmontarlo, sin enviarlo." },
  { titulo: "Un lector por concepto", texto: "El de la puerta ficha Trabajo y el del comedor, Comida. Las pausas quedan separadas sin tocar una pantalla." },
  { titulo: "Con tu logo", texto: "Carcasa y llaveros con tu marca. El terminal que ve tu plantilla cada mañana lleva tu nombre." },
];

const equipo = [
  { titulo: "Vacaciones y permisos", texto: "El empleado pide desde el móvil viendo su saldo y el responsable aprueba o propone otras fechas.", href: "/software-vacaciones-ausencias" },
  { titulo: "Turnos rotativos", texto: "Ciclos 4x4, 5/2 o 6/3, con noches. Cada fichaje se compara con el turno que tocaba.", href: "/software-turnos-rotativos" },
  { titulo: "Entrada y salida", texto: "Retrasos, salidas antes de hora y fichajes olvidados como incidencias, con tolerancia en minutos.", href: "/control-entrada-salida-empleados" },
];

const faqs = [
  {
    q: "¿Qué es Drenpos Tap?",
    a: "Drenpos Tap es el terminal de fichaje que diseña y fabrica Drenpos para el control horario. Lee llaveros y tarjetas RFID y el código QR personal de cada empleado, enseña en pantalla el nombre y la foto de quien ficha y envía cada registro al software de Drenpos con sellado temporal. Placa electrónica, firmware y carcasa son propios. Funciona sin internet: guarda los fichajes con su reloj integrado y los sincroniza al recuperar la red.",
  },
  {
    q: "¿Cuánto tarda en fichar?",
    a: "Unos dos segundos desde que se acerca el llavero o la tarjeta hasta que la pantalla confirma el fichaje con el nombre y la foto del empleado. El tiempo está cronometrado en los vídeos de esta página, grabados con el terminal real.",
  },
  {
    q: "¿Qué diferencia hay entre Drenpos Tap y el dispositivo de fichaje de la otra página?",
    a: "Es el mismo terminal. Drenpos Tap es su nombre. Esta página enseña el aparato en vídeo y en 360 grados; la página de dispositivo de fichaje tiene la ficha técnica completa, la comparativa con otras opciones y el detalle de precio.",
  },
  {
    q: "¿Se puede fichar con huella?",
    a: "El Drenpos Tap de catálogo ficha con llavero, tarjeta o QR y no trata datos biométricos. Como la placa, el firmware y la carcasa son nuestros, para un cliente fabricamos una versión con lector de huella, que se ve en esta página. La huella es un dato de categoría especial: el artículo 9 del RGPD limita su tratamiento y el artículo 35 obliga a una evaluación de impacto previa, así que solo tiene sentido en casos concretos.",
  },
  {
    q: "¿Hace falta instalación?",
    a: "No. Se alimenta a 12 V con la fuente incluida, con una batería o con el mechero del vehículo, y se conecta a la WiFi desde su panel web. Se fija a la pared por sus dos anclajes, se apoya en un mostrador o viaja en la furgoneta.",
  },
  {
    q: "¿Cuánto cuesta Drenpos Tap?",
    a: "El terminal parte de [[p:terminal]] sin IVA con llaveros personalizados. El software de control horario va aparte: Drenpos Equipo desde [[p:equipo10]] al mes hasta [[n:equipo10_personas]] personas, o incluido en cualquier plan de Drenpos. El detalle está en la página del dispositivo de fichaje y en precios.",
  },
];

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Drenpos Tap",
  alternateName: "Terminal de fichaje Drenpos",
  url: CANONICAL,
  image: [abs(`${IMG}/drenpos-tap-og.jpg`), abs(`${IMG}/drenpos-tap-foto.jpg`)],
  description:
    "Drenpos Tap es el terminal de fichaje fabricado por Drenpos: lee llavero y tarjeta RFID y código QR, muestra nombre y foto del empleado, ficha sin internet con reloj propio y se personaliza con el logo del cliente. Placa, firmware y carcasa propios.",
  brand: { "@type": "Brand", name: "Drenpos" },
  manufacturer: { "@id": ORG_ID },
  category: "Terminal de control de presencia",
  video: {
    "@type": "VideoObject",
    name: "Drenpos Tap: fichaje con tarjeta",
    description: "Un empleado ficha con la tarjeta en el terminal Drenpos Tap. La pantalla pasa de Disponible a Fichaje iniciado.",
    thumbnailUrl: abs(`${VID}/tap-tarjeta.webp`),
    contentUrl: abs(`${VID}/tap-tarjeta.mp4`),
    uploadDate: PAGE_PUBLISHED,
  },
  offers: {
    "@type": "Offer",
    price: decimal(valor("terminal")),
    priceCurrency: "EUR",
    priceValidUntil: "2027-12-31",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
    url: abs("/dispositivo-fichaje"),
    valueAddedTaxIncluded: false,
    seller: { "@id": ORG_ID },
  },
};

const jsonLd = [
  breadcrumb([
    { name: "Control horario", path: "/control-horario" },
    { name: "Drenpos Tap", path: PATH },
  ]),
  productSchema,
  faqPage(faqs),
];

const flecha = `<span class="icon-wrapper"><span class="icon"><svg width="19" height="12" viewBox="0 0 19 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12.5 1L17.5 6L12.5 11M1.5 6H17.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="icon" aria-hidden="true"><svg width="19" height="12" viewBox="0 0 19 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12.5 1L17.5 6L12.5 11M1.5 6H17.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span></span>`;
---

<Base
  title="Drenpos Tap · Terminal de fichaje fabricado por Drenpos"
  meta_title="Drenpos Tap: terminal de fichaje en 2 segundos | Drenpos"
  description="Drenpos Tap es el terminal de fichaje que fabricamos nosotros: llavero, tarjeta o QR, nombre y foto en pantalla, ficha sin internet y lleva tu logo. Míralo en 360°."
  canonical={CANONICAL}
  image={`${IMG}/drenpos-tap-og.jpg`}
  published_date={PAGE_PUBLISHED}
  modified_date={PAGE_UPDATED}
  author={AUTOR}
>
  <JsonLd data={jsonLd} />

  <!-- ═══════════════════════ HERO · parallax ═══════════════════════ -->
  <section class="tap-hero relative overflow-hidden" id="tap-hero">
    <div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true">
      <img src="/images/grainy.svg" alt="" width="1440" height="900" class="w-full h-full object-cover opacity-[.08]" />
    </div>
    <div class="tap-glow" aria-hidden="true"></div>

    <div class="container relative z-10">
      <nav aria-label="Migas de pan" class="pt-6 text-sm text-dark/55">
        <a href="/" class="hover:text-primary">Inicio</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <a href="/control-horario" class="hover:text-primary">Control horario</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-primary font-medium">Drenpos Tap</span>
      </nav>

      <div class="row gx-0 items-center min-h-[calc(100svh-6rem)] py-10 lg:py-0">
        <div class="lg:col-6 order-2 lg:order-1" data-aos="fade-up-sm">
          <p class="tap-kicker">
            <span class="tap-dot" aria-hidden="true"></span>
            Drenpos Tap · terminal de fichaje · fabricado por Drenpos
          </p>
          <h1 class="tap-h1 mb-6">
            Acercas el llavero.<br />
            <span class="text-primary">Ya has fichado.</span>
          </h1>
          <p class="text-lg lg:text-xl text-dark/72 max-w-xl mb-6">
            Dos segundos, cronometrados. Sin móvil, sin huella, sin cola en la puerta.
            La pantalla enseña tu nombre y tu foto y la jornada queda registrada en
            Drenpos con hora sellada. Si se cae internet, ficha igual.
          </p>
          <div class="mb-8">
            <LandingMeta updated={PAGE_UPDATED} published={PAGE_PUBLISHED} compact class="mb-0" />
          </div>
          <ul class="flex flex-wrap gap-4 mb-10">
            <li>
              <a href="#demo-form" class="btn btn-dark">
                Quiero verlo en mi empresa
                <Fragment set:html={flecha} />
              </a>
            </li>
            <li>
              <a href="#giro" class="btn btn-light">Verlo en 360°</a>
            </li>
          </ul>
          <ul class="flex flex-wrap gap-x-7 gap-y-3 text-sm text-dark/62">
            <li class="flex items-center gap-2"><span class="tap-tick" aria-hidden="true">✓</span>Llavero, tarjeta o QR</li>
            <li class="flex items-center gap-2"><span class="tap-tick" aria-hidden="true">✓</span>Ficha sin internet</li>
            <li class="flex items-center gap-2"><span class="tap-tick" aria-hidden="true">✓</span>Sin datos biométricos</li>
            <li class="flex items-center gap-2"><span class="tap-tick" aria-hidden="true">✓</span>Tu logo en el frontal</li>
          </ul>
        </div>

        <div class="lg:col-6 order-1 lg:order-2">
          <div
            class="tap-stage"
            id="tap-parallax"
            data-tap={`${IMG}/tap.webp`}
            data-tarjeta={`${IMG}/tarjeta.webp`}
            data-llavero={`${IMG}/llavero.webp`}
          >
            <!-- Sin JS o con movimiento reducido se ve esta composición fija -->
            <div class="tap-static" aria-hidden="true">
              <img src={`${IMG}/tarjeta.webp`} alt="" width="1235" height="616" class="tap-static-tarjeta" loading="eager" />
              <img src={`${IMG}/tap.webp`} alt="Drenpos Tap, terminal de fichaje con pantalla de estado y lector RFID y QR" width="639" height="1200" class="tap-static-tap" loading="eager" fetchpriority="high" />
              <img src={`${IMG}/llavero.webp`} alt="" width="455" height="351" class="tap-static-llavero" loading="eager" />
            </div>
            <p class="tap-hint" aria-hidden="true">Mueve el ratón</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ CRONÓMETRO ═══════════════════════ -->
  <section class="pb-20 lg:pb-28" id="como-funciona">
    <div class="container">
      <div class="tap-chrono" id="tap-chrono">
        <div class="tap-chrono-head">
          <p class="tap-kicker">Así ficha tu equipo</p>
          <p class="tap-chrono-num text-dark"><span data-chrono>0,0</span><span class="text-primary"> s</span></p>
        </div>
        <ol class="tap-steps">
          {pasos.map((p, i) => (
            <li class="tap-step" data-step={i}>
              <span class="tap-step-t">{p.t}</span>
              <h2 class="tap-step-h text-dark">{p.titulo}</h2>
              <p class="tap-step-p">{p.texto}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ GIRO 360 · scroll ═══════════════════════ -->
  <section class="tap-spin-section" id="giro">
    <div class="tap-spin-sticky">
      <div class="container h-full">
        <div class="tap-spin-layout">
          <div class="tap-spin-copy">
            <p class="tap-kicker">Míralo por fuera</p>
            <h2 class="tap-h2 text-dark">Placa, firmware y carcasa: nuestros.</h2>
            <p class="text-dark/65 max-w-md">
              No revendemos un terminal genérico. Lo que ves aquí sale de nuestro taller
              en Solana de los Barros. Baja para girarlo.
            </p>
            <p class="tap-spin-progress" aria-hidden="true"><span data-spin-deg>0</span>°</p>
          </div>

          <div class="tap-spin-stage" id="tap-spin" data-frames={SPIN_FRAMES} data-base={`${IMG}/spin/tap-`}>
            <img
              src={spinFrames[0]}
              alt="Drenpos Tap visto de frente, de lado y por detrás: pantalla, lector, rejilla y anclajes de pared"
              width="388"
              height="720"
              class="tap-spin-img"
              id="tap-spin-img"
              decoding="async"
            />
            {etiquetas.map((e) => (
              <div class={`tap-callout tap-callout-${e.lado}`} data-desde={e.desde} data-hasta={e.hasta}>
                <span class="tap-callout-line" aria-hidden="true"></span>
                <strong>{e.titulo}</strong>
                <span>{e.texto}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ VÍDEOS REALES ═══════════════════════ -->
  <section class="section bg-body" id="en-accion">
    <div class="container">
      <div class="max-w-2xl mb-12">
        <p class="tap-kicker">Grabado con el terminal real</p>
        <h2 class="tap-h2 text-dark">Tres formas de fichar, el mismo gesto.</h2>
        <p class="text-dark/65 text-lg">
          Sin pantalla que tocar y sin app que abrir. El lector coge el llavero o la tarjeta
          antes de apoyarlos y la pantalla confirma con nombre, foto y hora.
        </p>
      </div>
      <div class="row g-4">
        {videos.map((v, i) => (
          <div class="md:col-4" data-aos="fade-up-sm" data-aos-delay={i * 100}>
            <figure class="tap-video">
              <video
                class="tap-video-el"
                muted
                loop
                playsinline
                preload="none"
                poster={`${VID}/${v.src}.webp`}
                width="720"
                height="900"
                aria-label={`Drenpos Tap: ${v.titulo.toLowerCase()}`}
              >
                <source src={`${VID}/${v.src}.mp4`} type="video/mp4" />
              </video>
              <figcaption>
                <strong>{v.titulo}</strong>
                <span>{v.texto}</span>
              </figcaption>
            </figure>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ VENTAJAS ═══════════════════════ -->
  <section class="section pt-0 bg-body" id="por-que">
    <div class="container">
      <div class="tap-bento">
        <div class="tap-bento-big">
          <p class="tap-kicker">Sin cobertura</p>
          <h2 class="tap-h2 text-dark">Ficha en la obra, sincroniza en la nave.</h2>
          <p class="text-dark/70 max-w-lg mb-6">
            Alimentado al mechero de la furgoneta, el Tap va donde va la cuadrilla. Cada fichaje
            se guarda con la hora de su reloj integrado y, al coger la WiFi de vuelta, se sube
            a Drenpos con su hora original. Nadie tiene que hacer nada.
          </p>
          <a href="/dispositivo-fichaje#sin-conexion" class="text-primary font-medium hover:underline">Cómo funciona el modo sin conexión</a>
        </div>
        {ventajas.map((v) => (
          <div class="tap-bento-card">
            <h3>{v.titulo}</h3>
            <p>{v.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ A MEDIDA · HUELLA ═══════════════════════ -->
  <section class="section pt-0" id="a-medida">
    <div class="container">
      <div class="row gx-0 gy-10 items-center">
        <div class="lg:col-5">
          <p class="tap-kicker">Este no está en el catálogo</p>
          <h2 class="tap-h2 text-dark">Nos pidieron huella. Lo fabricamos.</h2>
          <p class="text-dark/70 mb-5">
            El Tap de serie ficha con llavero, tarjeta o QR y no trata datos biométricos. Un
            cliente necesitaba huella, y como la placa, el firmware y la carcasa son nuestros,
            hicimos uno con lector. Pones el dedo y has fichado. El dedo de otro, no.
          </p>
          <p class="text-dark/55 text-sm mb-8">
            La huella es un dato de categoría especial. El artículo 9 del RGPD limita su uso y el
            35 pide una evaluación de impacto previa.
            <a href="/blog/fichar-con-huella-aepd-alternativas" class="text-primary hover:underline">Lo explicamos en el blog</a>.
          </p>
          <a href="#demo-form" class="btn btn-dark">
            Cuéntanos tu caso
            <Fragment set:html={flecha} />
          </a>
        </div>
        <div class="lg:col-7">
          <div class="grid grid-cols-2 gap-4 lg:pl-10">
            <figure class="tap-video">
              <video class="tap-video-el" muted loop playsinline preload="none" poster={`${VID}/huella-ok.webp`} width="720" height="900" aria-label="Drenpos Tap con lector de huella: fichaje correcto">
                <source src={`${VID}/huella-ok.mp4`} type="video/mp4" />
              </video>
              <figcaption><strong>Huella correcta</strong><span>Anillo verde y fichaje registrado.</span></figcaption>
            </figure>
            <figure class="tap-video">
              <video class="tap-video-el" muted loop playsinline preload="none" poster={`${VID}/huella-no.webp`} width="720" height="900" aria-label="Drenpos Tap con lector de huella: huella no reconocida">
                <source src={`${VID}/huella-no.mp4`} type="video/mp4" />
              </video>
              <figcaption><strong>Huella de otro</strong><span>Anillo rojo. Ni lo intentes.</span></figcaption>
            </figure>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ LO QUE VE LA EMPRESA ═══════════════════════ -->
  <section class="section bg-body" id="gestion-equipo">
    <div class="container">
      <div class="max-w-2xl mb-10">
        <p class="tap-kicker">Detrás del terminal</p>
        <h2 class="tap-h2 text-dark">El fichaje entra en Drenpos. El resto lo hace el software.</h2>
        <p class="text-dark/65 text-lg">
          Con la licencia de fichaje van incluidos el calendario del equipo, las vacaciones y
          los turnos. El registro queda inalterable los cuatro años que pide la ley y se
          exporta para la asesoría o la Inspección.
        </p>
      </div>
      <div class="row g-4">
        {equipo.map((e) => (
          <div class="md:col-4">
            <a href={e.href} class="tap-link-card">
              <h3>{e.titulo}</h3>
              <p>{e.texto}</p>
              <span class="tap-link-more">Ver cómo funciona</span>
            </a>
          </div>
        ))}
      </div>
      <p class="mt-10 text-dark/60">
        ¿Quieres la ficha técnica completa, la comparativa con otras opciones y el precio al detalle?
        <a href="/dispositivo-fichaje" class="text-primary font-medium hover:underline">Está en la página del dispositivo de fichaje</a>.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════ FAQ ═══════════════════════ -->
  <section class="section pt-0 bg-body" id="faq">
    <div class="container">
      <div class="max-w-3xl mx-auto">
