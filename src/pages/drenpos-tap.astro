<script>
  import * as THREE from "three";

  const reduced = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ── Parallax 2.5D del hero (Three.js, capas con transparencia) ──
  function initParallax() {
    const stage = document.getElementById("tap-parallax") as HTMLElement | null;
    if (!stage || stage.dataset.ready || reduced()) return;
    stage.dataset.ready = "1";

    const canvas = document.createElement("canvas");
    stage.appendChild(canvas);
    let W = stage.offsetWidth;
    let H = stage.offsetHeight;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(50, W / H, 0.1, 100);
    // Con el escenario más estrecho que 0.83 (móvil) la cámara se aleja para que quepan las capas
    const fitZ = () => 6 * Math.max(1, 0.83 / (W / H));
    camera.position.z = fitZ();
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.setSize(W, H);
    renderer.setClearColor(0x000000, 0);
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const loader = new THREE.TextureLoader();
    const loadTex = (src: string) =>
      new Promise<THREE.Texture>((res, rej) =>
        loader.load(
          src,
          (t) => {
            t.colorSpace = THREE.SRGBColorSpace;
            res(t);
          },
          undefined,
          rej,
        ),
      );

    type Layer = THREE.Mesh & { userData: { base: number[]; pFactor: number; scrollFX: number; scrollFY: number; floatA: number; floatS: number } };
    const layers: Layer[] = [];
    const makeLayer = (tex: THREE.Texture, pw: number, aspect: number, pos: number[], pFactor: number, order: number, sfx: number, sfy: number, floatA = 0, floatS = 1) => {
      const geo = new THREE.PlaneGeometry(pw, pw / aspect);
      const mat = new THREE.MeshBasicMaterial({ map: tex, transparent: true, depthWrite: false, depthTest: false });
      const mesh = new THREE.Mesh(geo, mat) as Layer;
      mesh.position.set(pos[0], pos[1], pos[2]);
      mesh.renderOrder = order;
      mesh.userData = { base: pos, pFactor, scrollFX: sfx, scrollFY: sfy, floatA, floatS };
      scene.add(mesh);
      layers.push(mesh);
      return mesh;
    };

    // Halo detrás del terminal: un plano con degradado radial generado en canvas
    const haloCanvas = document.createElement("canvas");
    haloCanvas.width = haloCanvas.height = 256;
    const g = haloCanvas.getContext("2d")!;
    // Colores del tema (pueden cambiar con un tema de temporada), leídos de las variables CSS
    const css = getComputedStyle(document.documentElement);
    const hexA = (hex: string, a: number) => {
      const h = hex.trim().replace("#", "");
      const n = parseInt(h.length === 3 ? h.replace(/(.)/g, "$1$1") : h, 16);
      return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a})`;
    };
    const grad = g.createRadialGradient(128, 128, 10, 128, 128, 128);
    grad.addColorStop(0, hexA(css.getPropertyValue("--color-secondary") || "#8a8a8a", 0.22));
    grad.addColorStop(0.5, hexA(css.getPropertyValue("--color-primary") || "#5a5a5a", 0.12));
    grad.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = grad;
    g.fillRect(0, 0, 256, 256);
    const haloTex = new THREE.CanvasTexture(haloCanvas);
    haloTex.colorSpace = THREE.SRGBColorSpace;
    makeLayer(haloTex, 6.5, 1, [0.2, 0.2, -2], 0.04, 0, 0, 0.05);

    Promise.all([loadTex(stage.dataset.tap!), loadTex(stage.dataset.tarjeta!), loadTex(stage.dataset.llavero!)])
      .then(([tap, tarjeta, llavero]) => {
        // Alturas en unidades de mundo: el escenario mide unos 5 de alto a z=0
        makeLayer(tap, 2.45, 639 / 1200, [0.15, -0.05, 0], 0.16, 1, 0, 0.08);
        const card = makeLayer(tarjeta, 2.2, 1235 / 616, [-1.15, -1.5, 0.7], 0.36, 2, -0.3, 0.18, 0.05, 0.7);
        card.rotation.z = -0.14;
        makeLayer(llavero, 0.9, 455 / 351, [1.35, 1.2, 1.0], 0.46, 3, 0.25, 0.32, 0.07, 1.1);
        stage.classList.add("is-3d");
      })
      .catch(() => {});

    let tX = 0, tY = 0, cX = 0, cY = 0;
    const onMove = (e: MouseEvent) => {
      tX = (e.clientX / innerWidth - 0.5) * 2;
      tY = -(e.clientY / innerHeight - 0.5) * 2;
    };
    document.addEventListener("mousemove", onMove, { passive: true });
    // En móvil, el giroscopio sustituye al ratón si el navegador lo permite sin pedir permiso
    window.addEventListener(
      "deviceorientation",
      (e) => {
        if (e.gamma == null || e.beta == null) return;
        tX = Math.max(-1, Math.min(1, e.gamma / 30));
        tY = Math.max(-1, Math.min(1, -(e.beta - 45) / 30));
      },
      { passive: true },
    );

    let scrollProg = 0, smooth = 0;
    const updateScroll = () => {
      const r = stage.getBoundingClientRect();
      const vh = innerHeight;
      const mid = r.top + r.height / 2;
      scrollProg = Math.max(-1.4, Math.min(1.4, (vh / 2 - mid) / (vh / 2 + r.height / 2)));
    };
    window.addEventListener("scroll", updateScroll, { passive: true });
    updateScroll();

    const ro = new ResizeObserver(() => {
      W = stage.offsetWidth;
      H = stage.offsetHeight;
      camera.aspect = W / H;
      camera.position.z = fitZ();
      camera.updateProjectionMatrix();
      renderer.setSize(W, H);
    });
    ro.observe(stage);

    let raf = 0;
    let visible = true;
    new IntersectionObserver((en) => (visible = en[0].isIntersecting), { threshold: 0 }).observe(stage);
    const t0 = performance.now();
    const animate = () => {
      raf = requestAnimationFrame(animate);
      if (!visible) return;
      const t = (performance.now() - t0) / 1000;
      cX += (tX - cX) * 0.06;
      cY += (tY - cY) * 0.06;
      smooth += (scrollProg - smooth) * 0.06;
      camera.rotation.y = cX * 0.04;
      camera.rotation.x = cY * 0.03;
      for (const l of layers) {
        const u = l.userData;
        l.position.x = u.base[0] + cX * u.pFactor + u.scrollFX * smooth;
        l.position.y = u.base[1] + cY * u.pFactor + u.scrollFY * smooth + Math.sin(t * u.floatS) * u.floatA;
      }
      renderer.render(scene, camera);
    };
    animate();

    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(raf);
        document.removeEventListener("mousemove", onMove);
        ro.disconnect();
        renderer.dispose();
      },
      { once: true },
    );
  }

  // ── Cronómetro: cuenta de 0,0 a 2,0 s al entrar en pantalla y enciende cada paso ──
  function initChrono() {
    const box = document.getElementById("tap-chrono");
    if (!box || box.dataset.ready) return;
    box.dataset.ready = "1";
    const num = box.querySelector("[data-chrono]") as HTMLElement;
    const steps = Array.from(box.querySelectorAll<HTMLElement>(".tap-step"));
    const marks = [0, 0.8, 2.0];
    const run = () => {
      if (reduced()) {
        num.textContent = "2,0";
        steps.forEach((s) => s.classList.add("is-on"));
        return;
      }
      const start = performance.now();
      const dur = 2000;
      const tick = () => {
        const p = Math.min(1, (performance.now() - start) / dur);
        const v = p * 2;
        num.textContent = v.toFixed(1).replace(".", ",");
        steps.forEach((s, i) => s.classList.toggle("is-on", v >= marks[i] - 0.01));
        if (p < 1) requestAnimationFrame(tick);
      };
      tick();
    };
    const io = new IntersectionObserver(
      (en) => {
        if (en[0].isIntersecting) {
          run();
          io.disconnect();
        }
      },
      { threshold: 0.4 },
    );
    io.observe(box);
  }

  // ── Giro 360 ligado al scroll ──
  function initSpin() {
    const section = document.getElementById("giro");
    const stage = document.getElementById("tap-spin") as HTMLElement | null;
    const img = document.getElementById("tap-spin-img") as HTMLImageElement | null;
    if (!section || !stage || !img || stage.dataset.ready) return;
    stage.dataset.ready = "1";
    const n = Number(stage.dataset.frames);
    const base = stage.dataset.base!;
    const src = (i: number) => `${base}${String(i).padStart(2, "0")}.webp`;
    const deg = section.querySelector("[data-spin-deg]") as HTMLElement | null;
    const callouts = Array.from(stage.querySelectorAll<HTMLElement>(".tap-callout"));

    if (reduced()) {
      callouts.forEach((c) => c.classList.add("is-on"));
      return;
    }

    // Precarga de los fotogramas para que el giro no parpadee
    const frames: HTMLImageElement[] = [];
    for (let i = 0; i < n; i++) {
      const im = new Image();
      im.decoding = "async";
      im.src = src(i);
      frames.push(im);
    }

    let current = 0;
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = section.getBoundingClientRect();
      const total = r.height - innerHeight;
      const p = Math.max(0, Math.min(1, -r.top / total));
      const idx = Math.min(n - 1, Math.floor(p * n));
      if (idx !== current) {
        current = idx;
        img.src = frames[idx].src;
      }
      if (deg) deg.textContent = String(Math.round(p * 360));
      for (const c of callouts) {
        const a = Number(c.dataset.desde), b = Number(c.dataset.hasta);
        c.classList.toggle("is-on", p >= a && p <= b);
      }
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
    document.addEventListener("astro:before-swap", () => window.removeEventListener("scroll", onScroll), { once: true });
  }

  // ── Vídeos: se reproducen solos al entrar en pantalla y se paran al salir ──
  function initVideos() {
    const vids = Array.from(document.querySelectorAll<HTMLVideoElement>(".tap-video-el"));
    if (!vids.length) return;
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            if (v.preload === "none") v.preload = "auto";
            v.play().catch(() => {});
          } else v.pause();
        }
      },
      { threshold: 0.35 },
    );
    vids.forEach((v) => io.observe(v));
  }

  const init = () => {
    initParallax();
    initChrono();
    initSpin();
    initVideos();
  };
  init();
  document.addEventListener("astro:page-load", init);
</script>
