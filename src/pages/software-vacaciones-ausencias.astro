---
export const prerender = true;
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import ClientLogosStrip from "@/partials/ClientLogosStrip.astro";
import DemoForm from "@/partials/DemoForm.astro";
import LandingMeta from "@/partials/LandingMeta.astro";
import { existsSync } from "node:fs";
import { join } from "node:path";

const hasImg = (p: string) => existsSync(join(process.cwd(), "public", p));

// ════════════════════════════════════════════════════════════════════════
//  Software de vacaciones y ausencias · landing dedicada (plan SEO/AEO
//  2026-10-07, tarea 1.2, clúster "gestión de equipo")
//  Intención de búsqueda objetivo:
//    - "software de gestión de vacaciones y ausencias"
//    - "gestor de vacaciones" / "app vacaciones empleados"
//    - "programa vacaciones pyme" / "software ausencias y permisos"
//  Diferenciación:
//    - /control-horario es el hub del módulo de fichajes (sección #vacaciones
//      resumida). Esta landing vende la gestión de vacaciones y ausencias.
//    - /blog/gestion-vacaciones-permisos-pymes-sin-excel explica la ley y el
//      cálculo. Aquí solo se cita lo imprescindible y se enlaza al post.
//  Fuente de producto: context/products_modules.md (Módulo de Fichajes:
//  Vacaciones y permisos, App PWA de fichajes, Planificación anual) y
//  context/pricing.md.
//  Capturas:
//    10-vacaciones-calendario.png (hero), 07-calendario-asignacion.png,
//    06-calendario-laboral.png: existentes.
//    15-app-vacaciones-saldo.png (pantalla de vacaciones de la app, saldo y
//    solicitud) y 13-planificacion-anual-equipo.png: opcionales, solo se
//    pintan si existen en /public (existsSync). Captura 11 pendiente.
// ════════════════════════════════════════════════════════════════════════

const CANONICAL = "https://www.drenpos.com/software-vacaciones-ausencias";

const IMG_DIR = "/images/funcionalidades/control-horario";
const VAC_IMG = `${IMG_DIR}/10-vacaciones-calendario.png`;
const CAL_IMG = `${IMG_DIR}/06-calendario-laboral.png`;
const ASIG_IMG = `${IMG_DIR}/07-calendario-asignacion.png`;
const APP_IMG = `${IMG_DIR}/15-app-vacaciones-saldo.png`;
const PLAN_IMG = `${IMG_DIR}/13-planificacion-anual-equipo.png`;

const HERO_IMG = hasImg(VAC_IMG) ? VAC_IMG : CAL_IMG;
const appImg = hasImg(APP_IMG);
const planImg = hasImg(PLAN_IMG);
const asigImg = hasImg(ASIG_IMG);
const calImg = hasImg(CAL_IMG);

// Fuentes citadas (verificadas en docs/keywords-intenciones-2026-09.md, 5.1)
const ET_URL = "https://www.boe.es/buscar/act.php?id=BOE-A-2015-11430";
const ABSENTISMO_URL =
  "https://www.elespanol.com/invertia/economia/empleo/20260611/cifras-absentismo-empresa-deja-euros-ano-trabajador-ausencias-sin-justificar/1003744281355_0.html";
const WOFFU_URL = "https://www.woffu.com/es/precios/";
const HOLDED_URL = "https://www.holded.com/es/blog/mejores-softwares-gestion-vacaciones";
const FACTORIAL_URL = "https://controlhorario.com/software/precio/";

// Cápsulas citables (50 a 80 palabras, sin enlaces) bajo cada H2
const cap = {
  definicion:
    "Un software de gestión de vacaciones y ausencias es el programa donde cada trabajador pide sus días libres, el responsable los aprueba y el sistema lleva el saldo de cada persona sin cuentas a mano. Sabe cuántos días le tocan a cada uno según la política de la empresa, cuántos ha gastado y quién falta cada día. En Drenpos va dentro del módulo de fichajes, así que las ausencias salen en el mismo informe que las horas.",
  sintomas:
    "Son las cuatro razones por las que una pyme acaba buscando un programa de vacaciones. Ninguna es grave por sí sola, pero juntas se comen horas de quien lleva el personal y generan discusiones que no hacían falta. Todas tienen el mismo origen: las peticiones, los saldos y el calendario del equipo están en sitios distintos y nadie los ve a la vez.",
  ley:
    "El Estatuto de los Trabajadores fija un mínimo de 30 días naturales de vacaciones retribuidas al año, que no se pueden cambiar por dinero mientras dure el contrato. Las fechas se pactan entre empresa y trabajador, y este tiene que conocerlas al menos dos meses antes. Los permisos retribuidos, como el de matrimonio o el de hospitalización de un familiar, tienen sus causas y sus días tasados en la ley o en el convenio.",
  noHace:
    "No es un planificador que reparte la plantilla según la demanda: aplica el calendario y las reglas que tú defines. Tampoco interpreta tu convenio ni sustituye a tu asesor laboral, así que si el convenio da 23 días o un permiso más largo, lo configuras así. Y no es una suite de recursos humanos con evaluación del desempeño o selección de personal; las nóminas las sigue haciendo tu gestoría con el informe.",
  comparativa:
    "Hay cuatro caminos habituales en una pyme: seguir con Excel o papel, contratar una aplicación de recursos humanos aparte, activar el módulo de personal de tu programa de facturación o llevar las vacaciones en el mismo sistema que los fichajes y el resto del negocio. Ninguno es el mejor para todos. Depende de cuántos sois, de si trabajáis a turnos y de dónde tienes ya la facturación.",
  casos:
    "Tres situaciones típicas en las que el Excel de vacaciones deja de dar abasto: un almacén con turnos donde no pueden faltar dos personas del mismo turno, un bar con turnos partidos y temporada alta en verano, y una oficina pequeña donde parte del equipo teletrabaja. En los tres casos las reglas se configuran una vez y el día a día se lleva desde el móvil.",
  precio:
    "Nada aparte: las vacaciones y los permisos van incluidos en la licencia de fichaje, que cuesta 1 € por usuario y mes sin IVA, junto con los calendarios laborales, los turnos rotativos y el control de entrada y salida. Quien aprueba vacaciones necesita licencia aunque no fiche. El terminal de fichaje es opcional y parte de 140 € sin IVA, con llaveros personalizados para la plantilla inicial.",
  faq:
    "Estas son las dudas típicas de una empresa que quiere dejar la hoja de cálculo: cuánto cuesta, cómo se calculan los días de quien entra a mitad de año, qué pasa con los que sobran en diciembre y quién aprueba qué. Las respuestas son cortas y describen cómo funciona Drenpos hoy, en octubre de 2026, con los precios sin IVA.",
  hermanas:
    "La misma licencia de 1 € por usuario y mes cubre el registro de jornada, los calendarios laborales y rotativos, el control de entrada y salida y la planificación anual. Cada página explica una parte desde el problema que resuelve. Todas trabajan sobre los mismos datos, así que lo que configuras para las vacaciones sirve también para los turnos y las horas extra.",
  lecturas:
    "La ley de vacaciones y permisos, la tabla de permisos retribuidos y el cálculo paso a paso de prorrateos y arrastres están en el blog, con sus fuentes. Esta página explica qué hace el programa; los artículos explican qué dice la norma y cómo se hacen las cuentas. Si vas a cambiar de herramienta, conviene leer primero el de vacaciones sin Excel.",
};

// Síntomas
const sintomas = [
  {
    icon: "📊",
    title: "El Excel de vacaciones vive en el ordenador de una persona",
    body: "Las peticiones llegan por WhatsApp, de palabra o en un pósit, y alguien las pasa a la hoja cuando puede. Si esa persona se va de vacaciones, nadie sabe quién ha pedido qué.",
  },
  {
    icon: "🔀",
    title: "Dos del mismo turno, la misma quincena",
    body: "Cada uno lo pidió a un responsable distinto y los dos dijeron que sí. Te enteras el lunes, cuando falta gente para abrir o para cargar el camión.",
  },
  {
    icon: "🗓️",
    title: "El que entra en septiembre",
    body: "No le tocan los días de un año entero, pero ¿cuántos? Cada uno hace la cuenta a su manera y luego hay que explicar por qué a su compañero le salía otra cifra.",
  },
  {
    icon: "❓",
    title: "«¿Cuántos días me quedan?»",
    body: "La pregunta llega cada semana. Para contestarla hay que sumar lo pedido, lo aprobado, lo cancelado y lo que pasó del año anterior, y casi nunca cuadra a la primera.",
  },
];

// Bloques de producto: H2 en pregunta + cápsula citable + detalles
const bloques = [
