// Comparación de precio (fuentes consultadas el 23/09/2026)
const preciosCompetencia = [
  {
    nombre: "Woffu",
    texto: "Parte de 1,50 € por usuario activo y mes en el plan Lite. Las reglas de coincidencia y varias políticas de ausencia quedan para los planes Pro y Enterprise.",
