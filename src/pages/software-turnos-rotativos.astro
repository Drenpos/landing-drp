                <div class="text-3xl mb-4">{c.icon}</div>
                <h3 class="h6 font-bold mb-2">{c.title}</h3>
                <p class="text-sm" style="color: rgba(16,25,40,0.68);">{c.body}</p>
              </div>
            </div>
