  <section id="como-se-monta" class="section pt-0 overflow-hidden scroll-mt-24">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-12" data-aos="fade-up-sm">
        <h2 class="h3 font-bold mb-4">¿Cómo se monta un cuadrante rotativo en Drenpos?</h2>
        <p class="text-lg leading-relaxed mb-0" style="color: rgba(16,25,40,0.72);">{capsulas.montaje}</p>
      </div>

      <div class="row g-5 items-start">
        <div class="lg:col-6" data-aos="fade-up-sm">
          <ol class="space-y-4 list-none p-0">
            {pasos.map((p) => (
              <li class="flex items-start gap-4 rounded-[20px] border p-6" style="border-color: rgba(16,25,40,0.1); background: #fff;">
                <span class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 font-bold text-white" style="background: #791b46;">{p.n}</span>
                <div>
                  <h3 class="h6 font-semibold mb-2">{p.title}</h3>
                  <p class="text-sm leading-relaxed mb-0" style="color: rgba(16,25,40,0.65);">{p.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div class="lg:col-6 space-y-6" data-aos="fade-up-sm" data-aos-delay="150">
          {previewImg && (
            <figure class="rounded-2xl overflow-hidden" style="box-shadow: 0 20px 60px rgba(0,0,0,0.14); border: 1px solid rgba(16,25,40,0.08);">
              <img src={PREVIEW_IMG} alt="Vista previa del mes de un calendario rotativo en Drenpos con los días de trabajo y de descanso del ciclo" width="1280" height="800" class="w-full h-auto block" loading="lazy" />
            </figure>
          )}
          <figure class="rounded-2xl overflow-hidden" style="box-shadow: 0 20px 60px rgba(0,0,0,0.14); border: 1px solid rgba(16,25,40,0.08);">
            <img src={ASIGNACION_IMG} alt="Pantalla de Drenpos para asignar calendarios laborales a varias personas a la vez" width="1280" height="800" class="w-full h-auto block" loading="lazy" />
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       LO QUE NO HACE
  ═══════════════════════════════════════════════════════════════════ -->
  <section id="lo-que-no-hace" class="section pt-0 overflow-hidden scroll-mt-24">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-10">
          <div class="rounded-3xl p-8 lg:p-12 text-white" style="background: #101928;" data-aos="fade-up-sm">
            <h2 class="h3 font-bold mb-4 text-white">¿Qué no hace el software de turnos de Drenpos?</h2>
            <p class="text-lg leading-relaxed mb-0" style="color: rgba(255,255,255,0.82);">{capsulas.noHace}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       QUÉ TIENE QUE RESPETAR EL CICLO
  ═══════════════════════════════════════════════════════════════════ -->
  <section id="que-respetar" class="section pt-0 overflow-hidden scroll-mt-24">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-10">
          <div class="rounded-3xl border border-dark/10 bg-body p-7 lg:p-10" data-aos="fade-up-sm">
            <h2 class="h4 font-bold mb-4">¿Qué tiene que respetar un turno rotativo?</h2>
            <p class="text-lg leading-relaxed mb-5" style="color: rgba(16,25,40,0.75);">{capsulas.ley}</p>
            <p class="text-sm leading-relaxed" style="color: rgba(16,25,40,0.7);">
              Fuente:
              <a href={`${ET_URL}#a34`} class="text-primary underline" rel="noopener" target="_blank">artículos 34.1 y 34.3</a>
              y
              <a href={`${ET_URL}#a37`} class="text-primary underline" rel="noopener" target="_blank">37.1 del Estatuto de los Trabajadores</a>.
              Tres cuadrantes de ejemplo con sus cuentas de horas en
              <a href="/blog/cuadrante-turnos-rotativos-4x4-ejemplos-estatuto" class="text-primary underline">cuadrante de turnos rotativos: ejemplos 4x4, 5/2 y 6/3</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

