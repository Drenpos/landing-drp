---
export const prerender = true;
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import ClientLogosStrip from "@/partials/ClientLogosStrip.astro";
import DemoForm from "@/partials/DemoForm.astro";
import LandingMeta from "@/partials/LandingMeta.astro";
import { existsSync } from "node:fs";
import { join } from "node:path";

const hasImg = (p: string) => existsSync(join(process.cwd(), "public", p));

// ════════════════════════════════════════════════════════════════════════
//  Programa de gestión para tiendas de recambios y repuestos (SEO/AEO 2026)
//  Intención de búsqueda objetivo (Search Console, julio a octubre de 2026):
//    - "programa de gestión tienda de recambios" / "programa gestion tienda repuestos"
//    - "software gestion tienda" / "programas para tiendas" / "software para tiendas"
//    - "sistema gestion almacen recambios" / "software punto de venta retail"
//  Hoy esas consultas aterrizan en /software-almacen-tienda en página 2 y 3.
//  Diferenciación: esa página es la general de almacén + TPV para cualquier
//  tienda; esta habla el idioma del mostrador de recambios y dice con claridad
//  lo que no hace (sin catálogo TecDoc ni búsqueda por matrícula).
//  Fuente de las funciones: context/products_modules.md y pricing.md.
// ════════════════════════════════════════════════════════════════════════

const CANONICAL = "https://www.drenpos.com/software-tienda-recambios";

const HERO_IMG = "/images/funcionalidades/almacen-tienda/03-tpv-tienda.png";
const UBICACIONES_IMG = "/images/funcionalidades/almacen-tienda/01-almacen-ubicaciones.png";
const PISTOLA_IMG = "/images/funcionalidades/almacen-tienda/04-pistola-traslados.png";
const LOTES_IMG = "/images/funcionalidades/almacen-tienda/02-lotes-caducidad.png";

// Síntomas (con lo que se busca "programa de gestión para tienda de recambios")
const sintomas = [
  {
    icon: "🔍",
    title: "«Espera, que miro si lo tengo»",
    body: "El cliente está delante y tú vas a la estantería o llamas al almacén. A veces el papel dice que hay y no hay, y otras la pieza está pero nadie sabe en qué hueco.",
  },
  {
    icon: "📦",
    title: "El pedido al proveedor sale tarde",
    body: "La referencia que más vendes se acaba un viernes y el pedido se hace el lunes. Lo que hay que reponer depende de que alguien repase la estantería y se acuerde.",
  },
  {
    icon: "🏷️",
    title: "La referencia que no aparece",
    body: "Buscas la pieza y no sale porque se dio de alta con otro nombre o no se dio de alta. Acabas vendiendo una línea suelta y el stock deja de cuadrar.",
  },
  {
    icon: "🧮",
    title: "El cierre de caja, a mano",
    body: "Al final del día sumas tickets, efectivo y tarjeta en un papel. Si no cuadra, no hay forma rápida de saber qué venta falta.",
  },
];

// Bloques de producto: H2 en pregunta + cápsula citable (50 a 80 palabras, sin enlaces) + detalles
type Bloque = {
  id: string;
  icon: string;
  h2: string;
  capsula: string;
  bullets: string[];
  img?: string;
  alt?: string;
};

const bloques: Bloque[] = [
  {
    id: "ficha-articulo",
    icon: "🏷️",
    h2: "¿Cómo se organiza cada referencia en el programa?",
    capsula:
      "Cada recambio es un artículo con su código, su nombre y su grupo, que puede ser la familia con la que ya ordenas la tienda. Admite varios códigos de barras, uno por unidad de medida, así que la pistola distingue si lees una unidad o la caja entera. También lleva su almacén y su ubicación por defecto, su stock mínimo y máximo y, si hace falta, control por lote o por número de serie.",
    bullets: [
      "Código, nombre y grupo en la ficha de cada artículo",
      "Varios códigos de barras por artículo, uno por cada unidad de medida, cada una con su precio",
      "Lista de precios asignada al artículo o al cliente, con listas que heredan de otras con un porcentaje",
      "Artículos, grupos y listas de precios cargados desde plantillas de Excel",
      "Una referencia que ya no se vende se desactiva sin perder su histórico",
    ],
    img: LOTES_IMG,
    alt: "Ficha de artículo en Drenpos con control por lote y fecha para recambios que lo necesitan",
  },
  {
    id: "reposicion",
    icon: "🔔",
    h2: "¿Cómo sabe el programa qué recambios hay que pedir?",
    capsula:
      "Pones un stock mínimo y un máximo a cada referencia y Drenpos avisa en el panel cuando una baja del mínimo. La propuesta de compra va más allá: combina esos límites con el consumo real de los últimos meses, lo reservado para encargos de clientes y lo que ya viene pedido. Revisas las cantidades y generas el pedido al proveedor con un clic, con el último proveedor ya puesto.",
    bullets: [
      "Aviso de bajo mínimos y de exceso de stock en el panel de notificaciones",
      "Alertas de pedidos: lo vendido pendiente de servir frente al stock físico",
      "Lo pedido que aún no ha llegado se descuenta de la propuesta",
      "Nunca compra sola: siempre revisas tú antes de pedir",
    ],
  },
  {
    id: "mostrador",
    icon: "🛒",
    h2: "¿Cómo se vende en el mostrador con el TPV?",
    capsula:
      "El TPV de tienda enseña tus grupos de artículos y tiene un buscador global para añadir cualquier referencia que no esté a la vista. Puedes dejar una cuenta en espera mientras atiendes a otro cliente, cambiar precio o cantidad en cada línea y calcular el cambio. Cada venta descuenta el stock en el momento, el ticket sale en modalidad Verifactu y al final del turno el cierre de caja te dice cuánto debería haber.",
    bullets: [
      "Líneas manuales para una pieza que todavía no está dada de alta",
      "Métodos de pago configurables y asistente de cambio",
      "Cierre de caja con desglose por método de pago y reporte imprimible",
      "Historial de tickets y reimpresión de cualquiera de ellos",
      "Albaranes y facturas a talleres y empresas, enviados por WhatsApp o por correo",
    ],
    img: HERO_IMG,
    alt: "TPV de tienda de Drenpos con grupos de artículos para vender recambios en el mostrador",
  },
  {
    id: "almacen-y-tienda",
    icon: "📍",
    h2: "¿Puedo llevar el almacén y la tienda en el mismo programa?",
    capsula:
      "Sí: Drenpos trabaja con varios almacenes, cada uno con sus ubicaciones (estantes, pasillos o zonas), y la tienda puede ser uno más. Cada ubicación lleva un QR imprimible que se pega en la estantería. Para reponer la tienda desde el almacén se hace un traslado con pistola: escaneas origen, producto, cantidad y destino, y el stock baja en un sitio y sube en el otro, con el movimiento registrado.",
    bullets: [
      "Stock por almacén y por ubicación en la ficha de cada referencia",
      "Pantalla de contenido de una ubicación con lo reservado y lo disponible",
      "Un pedido confirmado deja la pieza reservada para ese cliente",
      "Varios usuarios a la vez, sin límite de sesiones simultáneas",
    ],
    img: UBICACIONES_IMG,
    alt: "Almacenes y ubicaciones con QR en Drenpos para el stock de una tienda de recambios",
  },
  {
    id: "pistola",
    icon: "🔫",
    h2: "¿Para qué sirve la pistola lectora en una tienda de repuestos?",
    capsula:
      "Para no teclear códigos: en cada dispositivo eliges pistola externa o la cámara del móvil u ordenador. Con ella recibes la mercancía del proveedor comparando lo pedido con lo que llega, mueves stock entre ubicaciones y haces recuentos por zonas. En cada recuento el sistema compara con el stock teórico y regulariza la diferencia con una entrada o una salida, y te deja un informe de diferencias.",
    bullets: [
      "Recepción contra pedido con incidencias por línea: faltas, roturas o mercancía no pedida",
      "Al cerrar la recepción se genera el albarán de compra",
      "Etiquetas GS1 al recibir, en hoja A4 o en rollo",
      "Líneas de albaranes y facturas añadidas leyendo el código de barras",
    ],
    img: PISTOLA_IMG,
    alt: "Traslado de stock con pistola lectora entre almacén y tienda en Drenpos",
  },
  {
    id: "proveedores",
    icon: "🚚",
    h2: "¿Cómo se gestionan los pedidos y las facturas de proveedor?",
    capsula:
      "El pedido de compra sale de la propuesta o se hace a mano, y sigue el mismo circuito que las ventas: pedido, albarán y factura, con los datos arrastrados de un documento al siguiente. Si el proveedor te da la factura en papel, el OCR lee la foto, detecta las líneas y el proveedor y genera el documento. El análisis de costes enseña cómo ha cambiado el precio de compra de cada pieza mes a mes.",
    bullets: [
      "Ficha de proveedor con NIF, direcciones, contactos y forma de pago por defecto",
      "Si el proveedor no existe, el OCR lo crea con los datos de la factura",
      "Reporte de gestoría: ZIP con facturas de compra y venta y un Excel resumen",
      "Remesas SEPA para cobrar a los clientes que pagan por domiciliación",
    ],
  },
  {
    id: "informes",
    icon: "📊",
    h2: "¿Qué informes te dicen qué referencias se venden y cuáles no?",
    capsula:
      "En una tienda de recambios el dinero se queda parado en piezas que nadie pide. El informe de productos sin movimiento dice qué stock lleva meses quieto, dónde está y cuánto vale. El de rotación ordena lo que más sale por unidades y por valor, con la cobertura en días, y la analítica de ventas da el ticket medio, los productos más vendidos y los mejores clientes, todo exportable a Excel.",
    bullets: [
      "Inmovilizado con su valor y su ubicación",
      "Rotación con cobertura de stock en días",
      "Auditoría de stock: cada movimiento de una referencia con el documento que lo originó",
      "Con el conector de IA (6 €/mes sin IVA) preguntas a ChatGPT o Claude qué está bajo mínimos",
    ],
  },
];

// Lo que no hace (honestidad: nada de esto está en el producto)
const noHace = [
  "No trae catálogo de recambios ni está conectado a TecDoc u otros catálogos de fabricantes",
  "No busca piezas por matrícula ni por número de bastidor",
  "No guarda equivalencias entre referencias de distintas marcas",
  "No incluye tienda online propia",
  "No tiene datáfono propio: cobras con el de tu banco y el TPV registra el método de pago",
];

// Tabla de decisión: cuatro vías
const comparativa = [
  {
    opcion: "Excel y libreta",
    stock: "A mano, se desfasa en días",
    mostrador: "Caja registradora aparte",
    compras: "A ojo",
    catalogo: "No",
    verifactu: "No: hace falta otro programa para facturar",
    precio: "Sin licencia, se paga en horas y descuadres",
  },
  {
    opcion: "Programa de recambios de nicho",
    stock: "Sí",
    mostrador: "Normalmente sí",
    compras: "Normalmente sí",
    catalogo: "Suele incluirlo o conectarse a uno",
    verifactu: "Depende del fabricante",
    precio: "Cuota más alta: pregunta también por la implantación",
  },
  {
    opcion: "TPV genérico",
    stock: "Básico, sin ubicaciones",
    mostrador: "Sí",
    compras: "Pocas veces asistidas",
    catalogo: "No",
    verifactu: "Depende del TPV",
    precio: "Cuota baja, con el almacén fuera",
  },
  {
    opcion: "Drenpos",
    stock: "Por almacén y ubicación, con mínimos y alertas",
    mostrador: "TPV de tienda con cierre de caja",
    compras: "Propuesta de compra y pedido en un clic",
    catalogo: "No: tus referencias, cargadas desde Excel",
    verifactu: "Sí, en cada factura y cada ticket",
    precio: "Pro 29 €/mes o Full con TPV 39 €/mes, sin IVA",
    destacado: true,
  },
];

// Casos de uso (sin nombres de clientes)
const casos = [
  {
    tag: "Recambios de automoción",
    icon: "🚗",
    title: "Un mostrador con talleres de la zona como clientes",
    body: "Cada taller tiene su lista de precios asignada, así que nadie tiene que acordarse del descuento que le toca. Lo que se lleva durante el mes sale en albaranes y a fin de mes se juntan todos en una factura que se manda por WhatsApp. Las referencias que más rotan tienen su mínimo y la propuesta de compra prepara el pedido al distribuidor.",
  },
  {
    tag: "Repuestos de electrodomésticos",
    icon: "🔧",
    title: "Piezas que se piden para un cliente concreto",
    body: "Cuando un cliente encarga una pieza que no hay, se crea su pedido y la propuesta de compra la incluye porque hay demanda sin stock detrás. Al recibirla con la pistola, la recepción avisa de que hay un pedido esperándola, así que sale directa sin pasar por la estantería. Las piezas que lo necesitan se controlan por número de serie, una a una.",
  },
  {
    tag: "Ferretería y suministro industrial",
    icon: "🔩",
    title: "Tornillería por cajas, venta suelta y almacén detrás",
    body: "La tornillería entra en cajas y se vende por unidades: cada formato tiene su precio y su código de barras, y el stock se lleva siempre en la unidad base. La tienda se repone desde el almacén con un traslado hecho con pistola. El informe de productos sin movimiento dice qué referencias llevan meses paradas y cuánto dinero suponen.",
  },
];

const faqs = [
  {
    q: "¿Sirve Drenpos para una tienda de recambios de coche?",
    a: "Sí, para llevar el stock de cada referencia, vender en el mostrador, cuadrar la caja y comprar a tus proveedores. Lo que no hace es identificar la pieza a partir del vehículo: no tiene catálogo TecDoc ni búsqueda por matrícula o bastidor. Si ya consultas un catálogo de piezas, lo sigues usando y en Drenpos llevas el stock, las ventas y las compras.",
  },
  {
    q: "¿Busca por referencia del fabricante o por código de barras?",
    a: "Cada artículo tiene su código, su nombre y uno o varios códigos de barras, uno por unidad de medida, que se leen con pistola o con la cámara del móvil. En el mostrador, el TPV tiene un buscador global para añadir cualquier artículo del catálogo. Lo que no guarda son equivalencias entre referencias de distintos fabricantes.",
  },
  {
    q: "¿Tiene catálogo de recambios?",
    a: "No. Drenpos no trae un catálogo de piezas ni está conectado a TecDoc ni a otros catálogos de fabricantes. Tus artículos, grupos y listas de precios se cargan desde plantillas de Excel, así que la tarifa que tengas en una hoja de cálculo se adapta a la plantilla y entra de una vez.",
  },
  {
    q: "¿Cuánto cuesta un programa de gestión para tienda de recambios con Drenpos?",
    a: "Con mostrador, el plan Full: 39 €/mes sin IVA con almacén, TPV de tienda, facturación con Verifactu, informes, correo y WhatsApp, 5 usuarios y fichaje para 5 personas. Sin TPV, el plan Pro cuesta 29 €/mes sin IVA con 3 usuarios. Cada usuario adicional son 5 €/mes y cada fichaje adicional 1 €/usuario/mes, sin IVA, sin permanencia ni coste de instalación.",
  },
  {
    q: "¿Puedo vender en el mostrador y llevar el almacén a la vez?",
    a: "Sí, es el mismo sistema. El TPV descuenta del inventario cada venta, el almacén y la tienda pueden ser dos almacenes con sus ubicaciones y la tienda se repone con un traslado hecho con pistola. Un pedido confirmado reserva la pieza para ese cliente, y en todas las pantallas ves el stock físico y el disponible.",
  },
  {
    q: "¿Cumple Verifactu?",
    a: "Sí: cada factura y cada ticket llevan su huella encadenada y su QR verificable en la AEAT, sin que tengas que configurar nada. Hacienda anunció el 5 de octubre de 2026 que la obligación pasa a octubre de 2028 para todos, pendiente de publicarse en el BOE; hasta entonces la fecha legal sigue siendo la del RDL 15/2025. Drenpos ya funciona en modalidad Verifactu hoy.",
  },
  {
    q: "¿Funciona con pistola lectora?",
    a: "Sí. En cada dispositivo eliges si lees con una pistola externa o con la cámara del móvil u ordenador. Se escanea para añadir líneas a albaranes y facturas, recibir pedidos de proveedor, hacer traslados entre almacén y tienda y contar el inventario, y cada ubicación lleva su QR para saber de dónde sale y dónde entra cada pieza.",
  },
  {
    q: "¿Cuánto se tarda en empezar a usarlo?",
    a: "La puesta en marcha se cuenta en días, no en meses. Los artículos, grupos, almacenes, listas de precios, clientes y proveedores se cargan desde plantillas de Excel, y el stock de partida entra como una entrada de inventario inicial. Antes puedes pedir una demo de 20 minutos con tu forma de trabajar delante.",
  },
];

// Landings hermanas
const hermanas = [
  {
    url: "/software-almacen-tienda",
    title: "Programa de gestión para tiendas",
    body: "La visión general de almacén y TPV para cualquier tienda: alimentación, ferretería o tienda con almacén detrás.",
  },
  {
    url: "/software-control-stock",
    title: "Control de stock e inventario",
    body: "Mínimos y máximos con alertas, propuesta de compra, inventarios por zonas y valoración del stock.",
