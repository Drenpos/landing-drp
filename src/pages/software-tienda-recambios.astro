    body: "Huella encadenada, QR y envío a la AEAT en cada factura y cada ticket, sin configurar nada.",
  },
  {
    url: "/control-horario",
    title: "Control horario del equipo",
    body: "El fichaje de quien atiende el mostrador, con vacaciones y turnos, desde 1 €/usuario/mes sin IVA.",
  },
];

const articulos = [
  { t: "Control de stock: cómo evitar roturas y recuperar margen", s: "control-de-stock-sin-roturas" },
  { t: "Cómo organizar el almacén de una pyme", s: "como-organizar-almacen-pyme" },
  { t: "ERP para pymes: cuándo dejar de usar Excel", s: "erp-para-pymes-vs-excel" },
  { t: "Verifactu para pymes: guía práctica", s: "verifactu-pymes-guia-2026" },
  { t: "Enviar facturas por WhatsApp de forma automática", s: "enviar-facturas-por-whatsapp-automaticamente" },
  { t: "¿SGA aparte o ERP con almacén? Qué necesita una pyme", s: "sga-o-erp-con-almacen-que-necesita-una-pyme" },
];

// ── Datos estructurados (JSON-LD) ──────────────────────────────────────
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: "https://www.drenpos.com/" },
    { "@type": "ListItem", position: 2, name: "Funcionalidades", item: "https://www.drenpos.com/funcionalidades" },
    { "@type": "ListItem", position: 3, name: "Programa para tienda de recambios", item: CANONICAL },
