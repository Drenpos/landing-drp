---
export const prerender = true;
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import Faq from "@/partials/Faq.astro";
import PageHeader from "@/partials/PageHeader.astro";
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";

const contact = (await getEntry(
  "contact",
  "-index",
)) as CollectionEntry<"contact">;

const { contact_form_action }: { contact_form_action: string } = config.params;
const { title, description, meta_title, contact_section } = contact.data;

// El aviso de "mensaje enviado" se resuelve en cliente: la página se
// prerenderiza, así que aquí no se puede leer el ?sended=true real.
const SITE_KEY =
  import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY ||
  "6LebRrwqAAAAAB-QwrsbY4HNQGli2N28aoFNrn1R";

// Debug: verificar que la clave existe
if (!SITE_KEY && import.meta.env.MODE === "production") {
  console.error(
    "⚠️ PUBLIC_RECAPTCHA_SITE_KEY no está configurada en producción",
  );
}
---

<Base title={title} meta_title={meta_title} description={description}>
  <PageHeader
    title={contact_section.title}
    description={contact_section.description}
  />

  <section class="section-up">
    <div class="container">
      <div class="row g-5 space-x-4 justify-center">
        <div
          class="col-11 md:col-5 border border-dark/10 rounded-[30px] bg-light!"
          data-aos="fade-left-sm"
        >
          <div class="p-7">
            <h3 set:html={markdownify(contact_section.form.title)} />
            <p
              class="pt-5 pb-14"
              set:html={markdownify(contact_section.form.description)}
            />

            <div class="space-y-4">
              {
                contact_section.list?.map(
                  (item: {
                    title: string;
                    description: string;
                    icon: string;
                  }) => (
                    <div class="flex items-center gap-4 pt-5 first:pt-0">
                      <div class="w-[60px] h-[60px] rounded-full">
                        <Icon name={item.icon} class={"w-full h-full"} />
                      </div>

                      <div>
                        <h3
                          class="h6 font-medium"
                          set:html={markdownify(item.title)}
                        />
                        <p set:html={markdownify(item.description, true)} />
                      </div>
                    </div>
                  ),
                )
              }
            </div>
          </div>
        </div>

        <div
          class="col-11 md:col-5 border rounded-[30px] bg-dark text-text-light"
          data-aos-delay="200"
        >
          {
            /* La página es prerenderizada, así que los dos bloques se
               emiten siempre y el script decide cuál se ve según la URL. */
          }
          <div
            id="contact-success"
            class="p-8 text-center hidden"
            role="status"
            aria-live="polite"
          >
            <div class="mb-6">
              <Icon
                name="random/circleCheck"
                class="w-20 h-20 mx-auto text-green-500"
              />
            </div>
            <h3 class="text-2xl font-bold mb-4 text-primary">
              ¡Mensaje enviado con éxito!
            </h3>
            <p class="text-lg mb-6">
              Gracias por contactarnos. Hemos recibido tu mensaje y nuestro
              equipo se pondrá en contacto contigo.
            </p>
            <a
              href="/contact"
              class="inline-block bg-primary text-text-dark py-3 px-8 rounded-full font-medium transition hover:opacity-80"
            >
              Enviar otro mensaje
            </a>
          </div>

          <form
            id="contact-form"
            action={contact_form_action}
            method="POST"
            class="p-8"
          >
                <div class="mb-6">
                  <label for="name" class="form-label">
                    Nombre completo <span class="text-red-500">*</span>
                  </label>
                  <input
                    id="name"
                    name="name"
                    class="form-input"
                    placeholder="Juan Pérez"
                    type="text"
                    required
                  />
                </div>
                <div class="mb-6">
                  <label for="email" class="form-label">
                    Correo electrónico <span class="text-red-500">*</span>
                  </label>
                  <input
                    id="email"
                    name="email"
                    class="form-input"
                    placeholder="juan.perez@email.com"
                    type="email"
                    required
                  />
                </div>
                <div class="mb-6">
                  <label for="phone" class="form-label">
                    Teléfono <span class="text-red-500">*</span>
                  </label>
                  <input
                    id="phone"
                    name="phone"
                    class="form-input"
                    placeholder="600 000 000"
                    type="tel"
                    inputmode="tel"
                    autocomplete="tel"
                    required
                  />
                </div>
                <div class="mb-6">
                  <label for="company" class="form-label">
                    Empresa
                  </label>
                  <input
                    id="company"
                    name="company"
                    class="form-input"
                    placeholder="Nombre de tu empresa"
                    type="text"
                    autocomplete="organization"
                  />
                </div>
                <div class="mb-6">
                  <label for="interest" class="form-label">
                    ¿Qué te interesa?
                  </label>
                  <select id="interest" name="interest" class="form-input">
                    <option value="almacen">Almacén e inventario</option>
                    <option value="fichaje">Control horario y fichaje</option>
                    <option value="tpv">TPV de tienda</option>
                    <option value="hosteleria">
                      TPV de bar o restaurante
                    </option>
                    <option value="verifactu">Facturación Verifactu</option>
                    <option value="mcp">
                      Conector MCP para ChatGPT o Claude
                    </option>
                    <option value="todo" selected>
                      Todo el sistema
                    </option>
                  </select>
                </div>
                <div class="mb-6">
                  <label for="message" class="form-label">
                    Cuéntanos más sobre tu consulta{" "}
                    <span class="text-red-500">*</span>
                  </label>
                  <textarea
                    id="message"
                    name="message"
                    class="form-input"
                    placeholder="Escribe tu mensaje aquí..."
                    style={{ resize: "none" }}
                    required
                    rows="4"
                  />
                </div>
                <button
                  id="btnSubmit"
                  type="submit"
                  data-sitekey={SITE_KEY}
                  data-callback="onContactSubmit"
                  data-action="submit"
                  class="g-recaptcha inline-flex w-full items-center justify-center rounded-full px-6 py-3 text-base font-semibold text-white bg-primary transition hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2"
                >
                  Enviar
                </button>

                <input type="hidden" name="source_page" value="" />
                <input type="hidden" name="gclid" value="" />
                <input type="hidden" name="utm_source" value="" />
                <input type="hidden" name="utm_medium" value="" />
                <input type="hidden" name="utm_campaign" value="" />
          </form>
        </div>
      </div>
    </div>
  </section>

  <Faq />
  <CallToAction />
</Base>

<script>
  // Función callback de reCAPTCHA v2 Invisible
  function onContactSubmit(token) {
    console.log("reCAPTCHA validado correctamente");
    // Medición: el envío se confirma aquí, ya validado el reCAPTCHA
    window.dataLayer = window.dataLayer || [];
    const interes = document.getElementById("interest");
    window.dataLayer.push({
      event: "contact_form_submit",
      interest: interes ? interes.value : "",
      page: window.location.pathname,
    });
    // Enviar el formulario después de la validación
    document.querySelector("form").submit();
  }

  // Rellena los ocultos de atribución con lo que guardó el script global
  // de Base.astro (localStorage.drp_attr). Si no hay nada, van vacíos.
  function fillAttribution() {
    const form = document.querySelector("form");
    if (!form) return;

    const sourcePage = form.querySelector('input[name="source_page"]');
    if (sourcePage) sourcePage.value = window.location.pathname;

    try {
      const raw = window.localStorage.getItem("drp_attr");
      if (!raw) return;
      const attr = JSON.parse(raw);
      ["gclid", "utm_source", "utm_medium", "utm_campaign"].forEach((key) => {
        const input = form.querySelector(`input[name="${key}"]`);
        if (input && attr[key]) input.value = attr[key];
      });
    } catch (e) {
      // localStorage bloqueado: el formulario se envía igual
    }
  }

  // Confirmación de envío: la página vuelve con ?sended=true
  function trackSent() {
    const form = document.getElementById("contact-form");
    const success = document.getElementById("contact-success");

    if (window.location.search.indexOf("sended=true") === -1) {
      // Vuelta al formulario limpio: el próximo envío sí debe contarse
      form?.classList.remove("hidden");
      success?.classList.add("hidden");
      try {
        window.sessionStorage.removeItem("drp_contact_sent");
      } catch (e) {}
      return;
    }

    // Enviado: se enseña el aviso y se esconde el formulario
    form?.classList.add("hidden");
    success?.classList.remove("hidden");

    try {
      if (window.sessionStorage.getItem("drp_contact_sent") === "1") return;
      window.sessionStorage.setItem("drp_contact_sent", "1");
    } catch (e) {
      // sin sessionStorage medimos igual, asumiendo el riesgo de duplicado
    }
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: "contact_form_sent",
      page: window.location.pathname,
    });
  }

  // Hacer la función global para que reCAPTCHA pueda llamarla
  window.onContactSubmit = onContactSubmit;

  // Cargar reCAPTCHA dinámicamente solo si hay una clave válida
  function loadRecaptcha() {
    const btnSubmit = document.getElementById("btnSubmit");
    const siteKey = btnSubmit?.getAttribute("data-sitekey");

    // Verificar si la clave existe
    if (!siteKey || siteKey === "") {
      console.error(
        "❌ ERROR: data-sitekey está vacío. Configura PUBLIC_RECAPTCHA_SITE_KEY en Cloudflare Pages",
      );
      console.error(
        "👉 Dashboard: https://dash.cloudflare.com/ → Workers & Pages → landing-drp → Settings → Environment variables",
      );
      // Deshabilitar el botón si no hay clave
      if (btnSubmit) {
        btnSubmit.disabled = true;
        btnSubmit.textContent = "⚠️ reCAPTCHA no configurado";
        btnSubmit.classList.add("opacity-50", "cursor-not-allowed");
      }
      return;
    }

    console.log(
      "✅ reCAPTCHA Site Key encontrada:",
      siteKey.substring(0, 10) + "...",
    );

    // Cargar el script de reCAPTCHA dinámicamente
    const script = document.createElement("script");
    script.src = "https://www.google.com/recaptcha/api.js";
    script.async = true;
    script.defer = true;
    script.onload = () => {
      console.log("✅ reCAPTCHA cargado correctamente");
    };
    script.onerror = () => {
      console.error("❌ Error al cargar reCAPTCHA");
    };
    document.head.appendChild(script);
  }

  function initContactPage() {
    loadRecaptcha();
    fillAttribution();
    trackSent();
  }

  // Ejecutar cuando el DOM esté listo
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initContactPage);
  } else {
    initContactPage();
  }
</script>
