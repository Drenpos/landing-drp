---
import { decimal, eur, P, valor } from "@/lib/precios";
import { abs, AUTOR, EMPRESA, ORG_ID } from "@/lib/site";
import { breadcrumb, faqPage } from "@/lib/schema";
import JsonLd from "@/components/JsonLd.astro";
export const prerender = true;
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import DemoForm from "@/partials/DemoForm.astro";
import LandingMeta from "@/partials/LandingMeta.astro";

// ════════════════════════════════════════════════════════════════════════
//  Programa Empresa Nueva ("Drenpos Arranca")
//  Intención: "software de gestión para empresas nuevas", "programa de
//  facturación para autónomo que empieza", "descuento ERP startup".
//  Condiciones = sección 11 del plan del 20/10/2026 (proyecto landing-drp).
// ════════════════════════════════════════════════════════════════════════

const PATH = "/empresas-nuevas";
const CANONICAL = abs(PATH);
const PAGE_PUBLISHED = "2026-10-20";
const PAGE_UPDATED = "2026-10-22";

const condiciones = [
  { k: "Quién puede pedirlo", v: "Empresas y autónomos dados de alta hace menos de dos años que hayan facturado menos de [[p:nuevas_facturacion_max]] en los últimos doce meses." },
  { k: "Qué descuento es", v: "La mitad de la cuota del plan y de los módulos que añadas, durante tres meses. Vale para cualquier plan y para Drenpos Equipo." },
  { k: "Cuándo se alarga", v: "Si en esos tres meses has hecho al menos [[n:nuevas_documentos]] documentos de venta, o [[n:nuevas_dias_fichaje]] días de fichajes si solo usas el control horario, y sigues por debajo de [[p:nuevas_facturacion_prorroga_max]] al año, tienes otros tres meses a mitad. Lo miramos en tus propios datos, no tienes que mandarnos nada." },
  { k: "Qué hay que enseñar", v: "La fecha de alta en Hacienda o de la escritura, y marcar una casilla en el alta diciendo que cumples las condiciones." },
  { k: "Qué no entra", v: "No se suma al descuento del pago anual y se puede pedir una vez por NIF. Si vienes de parte de una gestoría o de un partner, el descuento se mantiene igual." },
  { k: "Y luego", v: "A partir del séptimo mes pagas el precio normal del plan. Un mes antes te mandamos un resumen de lo que has hecho en el programa para que decidas si sigues." },
];

const planes = [
  { nombre: P.planes.facturacion.nombre, precio: valor("facturacion"), para: "Facturar y llevar los cobros" },
  { nombre: P.planes.tienda.nombre, precio: valor("tienda"), para: "Cobrar en caja, en tienda o en bar" },
  { nombre: P.planes.almacen.nombre, precio: valor("almacen"), para: "Stock, lotes y ubicaciones" },
  { nombre: P.planes.produccion.nombre, precio: valor("produccion"), para: "Órdenes de trabajo y coste real" },
];

const faqs = [
  {
    q: "¿Qué descuento tiene Drenpos para empresas nuevas?",
    a: "La mitad de la cuota durante tres meses en cualquier plan, y otros tres si en ese tiempo usas el programa y sigues facturando menos de [[p:nuevas_facturacion_prorroga_max]] al año. Pueden pedirlo empresas y autónomos con menos de dos años de alta y menos de [[p:nuevas_facturacion_max]] facturados en los últimos doce meses, una vez por NIF.",
  },
  {
    q: "¿Cómo demuestro que mi empresa es nueva?",
    a: "Con la fecha de alta en Hacienda (036 o 037) o la de la escritura, y marcando en el alta que cumples las condiciones. No pedimos cuentas ni más papeles. Para alargarlo miramos los datos que ya tienes en Drenpos.",
  },
  {
    q: "¿Qué pasa cuando se acaban los seis meses?",
    a: "Pasas al precio normal del plan que tengas. Como no hay permanencia, puedes cambiar de plan o darte de baja cuando quieras. Un mes antes te mandamos un resumen de lo que has hecho en el programa.",
  },
  {
    q: "¿Se puede juntar con el pago anual?",
    a: "No. El pago anual ya trae dos meses gratis y los dos descuentos no se suman. Si vienes recomendado por una gestoría o un partner, el descuento para empresas nuevas se mantiene.",
  },
];

const faqSchema = faqPage(faqs);
const breadcrumbSchema = breadcrumb([
  { name: "Precios", path: "/pricing" },
  { name: "Empresas nuevas", path: PATH },
]);
const offerSchema = {
  "@context": "https://schema.org",
  "@type": "Offer",
  name: "Drenpos para empresas nuevas: mitad de cuota los primeros meses",
  url: CANONICAL,
  priceCurrency: "EUR",
  price: decimal(valor("desde*nuevas_descuento/100")),
  description: "La mitad de la cuota durante tres meses, que se puede alargar a seis, en cualquier plan de Drenpos para empresas y autónomos con menos de dos años y menos de [[p:nuevas_facturacion_max]] de facturación.",
  eligibleCustomerType: "https://schema.org/Business",
  availability: "https://schema.org/InStock",
  validFrom: "2026-11-01",
  seller: { "@id": ORG_ID },
};
---

<Base
  title="Drenpos para empresas nuevas"
  meta_title="Programa de gestión para empresas nuevas | Drenpos"
  description="Si tu empresa tiene menos de dos años y factura menos de [[p:nuevas_facturacion_max]], tienes la mitad de la cuota de Drenpos durante tres meses, y otros tres si lo usas."
  canonical={CANONICAL}
  published_date={PAGE_PUBLISHED}
  modified_date={PAGE_UPDATED}
  author={AUTOR}
>
  <JsonLd data={[breadcrumbSchema, offerSchema, faqSchema]} />

  <section class="section-sm pb-0 relative z-10 overflow-hidden">
    <div class="absolute inset-0 z-0 pointer-events-none">
      <img src="/images/grainy.svg" alt="" width="1440" height="900" class="w-full h-full object-cover opacity-[.08]" />
    </div>
    <div class="container relative z-10">
      <nav aria-label="Migas de pan" class="mb-6 text-sm text-dark/55">
        <a href="/" class="hover:text-primary">Inicio</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <a href="/pricing" class="hover:text-primary">Precios</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-primary font-medium">Empresas nuevas</span>
      </nav>
      <div class="row justify-center">
        <div class="lg:col-9 text-center" data-aos="fade-up-sm">
          <span class="text-primary bg-primary/10 px-4 py-1.5 inline-flex items-center gap-2 rounded-full uppercase text-sm font-medium mb-6">Empresas nuevas</span>
          <h1 class="mb-5 text-h3 lg:text-h1 font-bold leading-tight">
            Si acabas de montar la empresa, <span class="text-primary">empieza ya con un programa en condiciones</span>
          </h1>
          <p class="text-lg mb-6 max-w-2xl mx-auto text-dark/72">
            Los primeros meses de una empresa son los peores para cambiar de programa, y los mejores para empezar bien.
            Por eso, si llevas menos de dos años y facturas menos de [[p:nuevas_facturacion_max]], te dejamos Drenpos a mitad de cuota
            mientras arrancas.
          </p>
          <LandingMeta updated={PAGE_UPDATED} published={PAGE_PUBLISHED} class="mb-8 justify-center" />
          <ul class="flex flex-wrap gap-4 justify-center mb-10">
            <li><a href={`${EMPRESA.app.acceso}auth`} class="btn btn-dark">Darme de alta</a></li>
            <li><a href="#condiciones" class="btn btn-outline-dark">Ver las condiciones</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section pb-0">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-10" data-aos="fade-up-sm">
          <h2 class="h3 font-bold mb-3 text-center">Lo que pagas los primeros meses</h2>
          <p class="text-center mb-8 text-dark/65">Sin IVA. Después, el precio normal del plan.</p>
          <div class="overflow-x-auto rounded-2xl border border-dark/10">
            <table class="w-full text-left">
              <thead class="bg-primary/6">
                <tr>
                  <th scope="col" class="px-6 py-4 font-semibold">Plan</th>
                  <th scope="col" class="px-6 py-4 font-semibold">Para qué</th>
                  <th scope="col" class="px-6 py-4 font-semibold text-right">Precio normal</th>
                  <th scope="col" class="px-6 py-4 font-semibold text-right">Los primeros meses</th>
                </tr>
              </thead>
              <tbody>
                {planes.map((p) => (
                  <tr class="border-t border-dark/8">
                    <td class="px-6 py-4 font-semibold">{p.nombre}</td>
                    <td class="px-6 py-4 text-dark/72">{p.para}</td>
                    <td class="px-6 py-4 text-right">{eur(p.precio)}/mes</td>
                    <td class="px-6 py-4 text-right font-bold text-primary">{eur(p.precio * valor("nuevas_descuento") / 100)}/mes</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="condiciones">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-10" data-aos="fade-up-sm">
          <h2 class="h3 font-bold mb-8 text-center">Condiciones</h2>
          <div class="grid gap-4 md:grid-cols-2">
            {condiciones.map((c) => (
              <div class="rounded-2xl border bg-white p-6 border-dark/10">
                <h3 class="font-semibold text-base mb-2">{c.k}</h3>
                <p class="mb-0 text-base leading-relaxed text-dark/72">{c.v}</p>
              </div>
            ))}
          </div>
          <p class="mt-8 text-center text-dark/65">
            Lo hacemos porque el programa con el que empiezas suele ser el que tienes diez años después. Preferimos que
            empieces con las facturas, la caja y los fichajes bien montados a que lo hagas en un Excel que luego toque pasar a otro sitio.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section pt-0">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-10 text-center mb-10" data-aos="fade-up-sm">
          <h2 class="h3 font-bold mb-3">Preguntas</h2>
        </div>
        <div class="lg:col-10">
          <div class="flex flex-col gap-3">
            {faqs.map((f, i) => (
              <details class="group rounded-2xl border bg-white border-dark/10" data-aos="fade-up-sm" data-aos-delay={i * 40}>
                <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none">
                  <h3 class="font-semibold text-base lg:text-lg mb-0">{f.q}</h3>
                  <span class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 transition-transform duration-200 group-open:rotate-45 text-xl leading-none bg-primary/10 text-primary" aria-hidden="true">+</span>
                </summary>
                <div class="px-6 pb-6 -mt-2">
                  <p class="text-base leading-relaxed mb-0 text-dark/72">{f.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <DemoForm interes="todo" />
  <CallToAction />
</Base>
