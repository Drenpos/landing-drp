---
export const prerender = true;
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import ClientLogosStrip from "@/partials/ClientLogosStrip.astro";
import DemoForm from "@/partials/DemoForm.astro";

// ════════════════════════════════════════════════════════════════════════
//  Software de facturación Verifactu · landing comercial
//  Intención de búsqueda objetivo:
//    - "software verifactu" / "programa de facturación verifactu" (principal)
//    - "software adaptado a verifactu" / "facturación verifactu pymes"
//  Hechos verificados que se pueden usar aquí: RD 1007/2023,
//  Orden HAC/1177/2024, RDL 15/2025 (1 de enero y 1 de julio de 2027),
//  modalidad Verifactu de Drenpos (huella encadenada, QR con leyenda,
//  remisión a la AEAT, panel de envíos), sanciones del art. 201 bis LGT.
//  Contenido largo y normativa: /blog/verifactu-pymes-guia-2026
//  Imágenes: /public/images/blog/verifactu/
// ════════════════════════════════════════════════════════════════════════

const CANONICAL = "https://www.drenpos.com/software-verifactu";
const IMG = "/images/blog/verifactu";

const pasos = [
  {
    n: "1",
    title: "Emites la factura como siempre",
    body: "Desde el módulo financiero o desde el TPV, con tus series y tu numeración. No hay una pantalla aparte de Verifactu ni un paso extra que recordar.",
  },
  {
    n: "2",
    title: "Drenpos crea el registro de facturación",
    body: "Cada factura genera su registro con huella (hash) encadenada con la anterior, y la factura sale con el código QR y la leyenda VERI*FACTU impresos.",
  },
  {
    n: "3",
    title: "El registro viaja a la AEAT",
    body: "La remisión se hace desde el propio sistema y queda anotada en el panel de envíos, donde ves qué se ha enviado y qué está pendiente. Tú no configuras nada.",
  },
];

// Qué incluye, en formato ficha (AEO)
const ficha = [
  { k: "Modalidad", v: "Verifactu: Drenpos remite los registros de facturación a la AEAT, sin que el cliente tenga que elegir ni configurar la modalidad" },
  { k: "Registro", v: "Un registro de facturación por factura, con huella (hash) encadenada con el registro anterior" },
  { k: "En la factura", v: "Código QR y la leyenda VERI*FACTU, tanto en el PDF como en el ticket impreso" },
  { k: "Control", v: "Panel de envíos para ver el estado de las remisiones a la AEAT" },
  { k: "Tipos de factura", v: "Facturas completas, simplificadas y rectificativas" },
  { k: "Series", v: "Series y numeración configurables con auto incremento" },
  { k: "Entrega al cliente", v: "Envío de la factura por correo electrónico y por WhatsApp desde el propio sistema" },
  { k: "Planes", v: "Incluido en todos los planes, desde 19 €/mes sin IVA (plan Essential)" },
];

const ventajas = [
  {
    icon: "🔗",
    title: "Huella encadenada, factura a factura",
    body: "Cada registro de facturación se encadena con el anterior mediante su huella. Si alguien intentase alterar una factura ya emitida, la cadena dejaría de cuadrar.",
  },
  {
    icon: "🔳",
    title: "QR y leyenda en cada documento",
    body: "La factura sale con su código QR y con la leyenda VERI*FACTU, que es lo que permite a tu cliente comprobar el documento en la sede electrónica de la AEAT.",
  },
  {
    icon: "📡",
    title: "Remisión a la AEAT desde el sistema",
    body: "Los registros se remiten a la Agencia Tributaria sin que instales certificados en cada ordenador ni contrates un intermediario aparte.",
  },
  {
    icon: "🧭",
    title: "Panel de envíos",
    body: "Una pantalla donde ver el estado de las remisiones. Si un día falla la conexión, el envío queda pendiente y se reenvía, y tú lo ves sin tener que fiarte de la intuición.",
  },
  {
    icon: "🧾",
    title: "Rectificativas y simplificadas",
    body: "El ticket simplificado del mostrador y la factura rectificativa del cliente que devuelve mercancía entran en el mismo circuito que la factura completa.",
  },
  {
    icon: "⚙️",
    title: "Sin configuración por tu parte",
    body: "No hay un asistente de activación ni una casilla que se te pueda olvidar. Drenpos opera en modalidad Verifactu desde la primera factura que emites.",
  },
];

// Comparativa de decisión (AEO)
const comparativa = [
  {
    opcion: "Papel, Word o Excel",
    registro: "No genera registro de facturación",
    envio: "No",
    qr: "No",
    riesgo: "No cumple el RD 1007/2023",
  },
  {
    opcion: "Programa antiguo sin actualizar",
    registro: "Depende de que el fabricante lo adapte",
    envio: "Solo si el fabricante lo implementa",
    qr: "Solo si el fabricante lo implementa",
    riesgo: "Pregunta a tu proveedor por su declaración responsable",
  },
  {
    opcion: "Sistema no verificable",
    registro: "Sí, conservado por el propio software",
    envio: "No remite los registros",
    qr: "Sí, sin la leyenda VERI*FACTU",
    riesgo: "Tú cargas con la integridad, la conservación y la trazabilidad",
  },
  {
    opcion: "Drenpos en modalidad Verifactu",
    registro: "Sí, con huella encadenada",
    envio: "Sí, con panel de envíos",
    qr: "Sí, con la leyenda VERI*FACTU",
    riesgo: "Incluido en todos los planes, desde 19 €/mes sin IVA",
    destacado: true,
  },
];

const casos = [
  {
    tag: "Autónomos y profesionales",
    icon: "🧑‍💻",
    title: "Facturar sin pensar en el reglamento",
    body: "Emites tus facturas, las mandas por correo o por WhatsApp y el registro sale hacia la AEAT solo. Tu fecha límite es el 1 de julio de 2027, pero el sistema ya funciona así hoy.",
  },
  {
    tag: "Comercio con TPV",
    icon: "🛒",
    title: "Tickets simplificados del mostrador",
    body: "Cada venta en caja genera su registro y su QR, y el stock se descuenta del inventario en el mismo movimiento. La factura completa se emite después desde el ticket si el cliente la pide.",
  },
  {
    tag: "Distribución y almacén",
    icon: "🚚",
    title: "De albarán a factura sin retoques",
    body: "Agrupas los albaranes del mes en una factura y esa factura entra en el circuito de Verifactu con su serie y su numeración. Las rectificativas siguen el mismo camino.",
  },
  {
    tag: "Hostelería",
    icon: "🍽️",
    title: "Verifactu en cada cuenta de mesa",
    body: "El cierre de caja y la cuenta de cada mesa se apoyan en el mismo motor de facturación, así que el local no necesita un programa aparte para cumplir con el reglamento.",
  },
];

const faqs = [
  {
    q: "¿Qué es Verifactu?",
    a: "Verifactu es la modalidad de los sistemas informáticos de facturación en la que el programa genera un registro de facturación por cada factura emitida y lo remite a la Agencia Tributaria. El marco lo fijan el Real Decreto 1007/2023 y la Orden HAC/1177/2024, que definen el formato de los registros, la huella encadenada, el código QR de la factura y la forma de envío. En esta modalidad la factura lleva además la leyenda VERI*FACTU, que indica que todos los registros se están remitiendo.",
  },
  {
    q: "¿Desde cuándo es obligatorio Verifactu?",
    a: "El Real Decreto-ley 15/2025 trasladó la obligación a 2027: las sociedades, es decir los contribuyentes del Impuesto sobre Sociedades, deben tener el sistema adaptado el 1 de enero de 2027, y los autónomos, profesionales y el resto de obligados el 1 de julio de 2027. El aplazamiento cambió el calendario, no los requisitos técnicos del Real Decreto 1007/2023 ni de la Orden HAC/1177/2024.",
  },
  {
    q: "¿Qué diferencia hay entre Verifactu y un sistema no verificable?",
    a: "En modalidad Verifactu el software remite los registros de facturación a la AEAT y la factura lleva QR y la leyenda VERI*FACTU. Un sistema no verificable no remite nada, y a cambio tiene que garantizar por su cuenta la integridad, la conservación y la trazabilidad de los registros. Drenpos opera en modalidad Verifactu, así que esa carga no recae en tu negocio.",
  },
  {
    q: "¿Qué pasa si sigo con mi programa de facturación actual?",
    a: "Depende de que su fabricante lo adapte y publique su declaración responsable. Conviene preguntárselo por escrito y con tiempo, porque quien fabrica o comercializa software no conforme se expone a una multa de hasta 150.000 € por ejercicio y por tipo de sistema, y quien lo tiene o lo usa a una de hasta 50.000 € por ejercicio, según el artículo 201 bis de la Ley General Tributaria.",
  },
  {
    q: "¿Cómo se envían mis facturas a la AEAT con Drenpos?",
    a: "El envío lo hace el propio sistema. Al emitir la factura se genera su registro de facturación con la huella encadenada y ese registro se remite a la Agencia Tributaria, sin que tú actives nada ni instales certificados en cada ordenador. En el panel de envíos ves el estado de cada remisión, y si hubo una incidencia de conexión el envío queda anotado como pendiente.",
  },
  {
    q: "¿Sirve para autónomos?",
    a: "Sí. Un autónomo que emite facturas con un programa informático entra en el reglamento igual que una sociedad, con fecha límite del 1 de julio de 2027. El plan Essential parte de 19 €/mes sin IVA e incluye la facturación con Verifactu, el envío de las facturas por correo y por WhatsApp y los informes.",
  },
  {
    q: "¿Incluye TPV para tienda o restaurante?",
    a: "El TPV está en el plan Full, desde 39 €/mes sin IVA, y también como módulo suelto. Los tickets simplificados y las facturas que salen del TPV pasan por el mismo motor de facturación, con su registro, su QR y su remisión a la AEAT. Puedes verlo en la página de software de almacén y tienda.",
  },
  {
    q: "¿Qué hago con mis facturas antiguas?",
    a: "Se quedan donde están. La obligación afecta a las facturas que emitas con el nuevo sistema, no a las que ya emitiste: esas se conservan según las reglas de siempre. Cuando empiezas a facturar con Drenpos, la numeración continúa en la serie que le indiques y solo las facturas nuevas generan registro y se remiten a la AEAT.",
  },
];

const noHacemos = [
  "No llevamos tu contabilidad: Drenpos factura, no sustituye a tu asesoría.",
  "No presentamos modelos ante la AEAT en tu nombre, más allá de la remisión de los registros de facturación.",
  "No somos una solución de factura electrónica B2B de la Ley Crea y Crece: eso es otra obligación distinta.",
];

const siHacemos = [
  "Generamos el reporte para la gestoría con compras, ventas y rectificativas, en ZIP con un Excel resumen.",
  "Preparamos el modelo 347 con los datos que ya están en el sistema.",
  "Guardamos la traza de cada envío en el panel, para que tu asesor vea lo que se remitió y cuándo.",
];

// ── Datos estructurados (JSON-LD) ──────────────────────────────────────
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: "https://www.drenpos.com/" },
    { "@type": "ListItem", position: 2, name: "Funcionalidades", item: "https://www.drenpos.com/funcionalidades" },
    { "@type": "ListItem", position: 3, name: "Software de facturación Verifactu", item: CANONICAL },
  ],
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Drenpos · Facturación Verifactu",
  url: CANONICAL,
  applicationCategory: "BusinessApplication",
  applicationSubCategory: "Software de facturación",
  operatingSystem: "Web (navegador)",
  image: [
    `https://www.drenpos.com${IMG}/verifactu-qr.webp`,
    `https://www.drenpos.com${IMG}/verifactu-drenpos-traza.webp`,
  ],
  description:
    "Software de facturación en modalidad Verifactu para pymes y autónomos: registro de facturación con huella encadenada, código QR con la leyenda VERI*FACTU, remisión a la AEAT y panel de envíos, sin configuración por parte del cliente. Incluye facturas completas, simplificadas y rectificativas, series y numeración propias y envío al cliente por correo y WhatsApp.",
  publisher: { "@type": "Organization", name: "Drenpos Tech SL", url: "https://www.drenpos.com" },
  inLanguage: "es-ES",
  featureList: [
    "Registro de facturación con huella (hash) encadenada",
    "Código QR y leyenda VERI*FACTU en la factura",
    "Remisión de los registros a la AEAT",
    "Panel de envíos",
    "Facturas completas, simplificadas y rectificativas",
    "Series y numeración configurables",
    "Envío de facturas por correo y WhatsApp",
  ],
  offers: {
    "@type": "Offer",
    price: "19.00",
    priceCurrency: "EUR",
    priceValidUntil: "2027-12-31",
    availability: "https://schema.org/InStock",
    url: "https://www.drenpos.com/pricing",
    valueAddedTaxIncluded: false,
    description: "Facturación Verifactu incluida en todos los planes. Plan Essential desde 19 €/mes sin IVA, sin permanencia.",
    seller: { "@type": "Organization", name: "Drenpos Tech SL" },
  },
};
---

<Base
  title="Software de Facturación Verifactu · Drenpos"
  meta_title="Software de Facturación Verifactu para Pymes | Drenpos"
  description="Programa de facturación adaptado a Verifactu para pymes y autónomos: huella encadenada, QR, remisión a la AEAT y panel de envíos. Desde 19 €/mes sin IVA."
  canonical={CANONICAL}
  image={`${IMG}/verifactu-cover.webp`}
>
  <!-- Datos estructurados -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ═══════════════════════════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section-sm pb-0 relative z-10 overflow-hidden">
    <div class="absolute inset-0 z-0 pointer-events-none">
      <img src="/images/grainy.svg" alt="" width="1440" height="900" class="w-full h-full object-cover opacity-[.08]" />
    </div>

    <div class="container relative z-10">
      <nav aria-label="Migas de pan" class="mb-6 text-sm" style="color: rgba(16,25,40,0.55);">
        <a href="/" class="hover:text-primary">Inicio</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <a href="/funcionalidades" class="hover:text-primary">Funcionalidades</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-primary font-medium">Facturación Verifactu</span>
      </nav>

      <div class="row gx-0 gy-12 lg:gy-0 items-center">
        <div class="lg:col-6" data-aos="fade-up-sm">
          <span class="text-primary bg-primary/10 px-4 py-1.5 inline-flex items-center gap-2 rounded-full uppercase text-sm font-medium mb-6">
            <span class="w-2 h-2 rounded-full" style="background: #16a34a;" aria-hidden="true"></span>
            Modalidad Verifactu · RD 1007/2023
          </span>

          <h1 class="mb-5 text-h3 lg:text-h1 font-bold leading-tight">
            <span class="text-primary">Software de facturación Verifactu</span> para pymes, listo para 2027
          </h1>
          <p class="text-lg mb-8 max-w-xl" style="color: rgba(16,25,40,0.72);">
            Drenpos emite tus facturas en <strong>modalidad Verifactu</strong>:
            cada una genera su registro de facturación con
            <strong>huella encadenada</strong>, sale con el
            <strong>código QR</strong> y la leyenda VERI*FACTU, y el registro se
            <strong>remite a la AEAT</strong> desde el propio sistema. Tú no
            configuras nada, y lo ves todo en el panel de envíos.
          </p>

          <ul class="flex flex-wrap gap-4 mb-10">
            <li data-aos="fade-up-sm" data-aos-delay="100">
              <a href="#demo-form" class="btn btn-dark">
                Pedir demo gratuita
                <span class="icon-wrapper">
                  <span class="icon">
                    <svg width="19" height="12" viewBox="0 0 19 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12.5 1L17.5 6L12.5 11M1.5 6H17.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                  <span class="icon" aria-hidden="true">
                    <svg width="19" height="12" viewBox="0 0 19 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12.5 1L17.5 6L12.5 11M1.5 6H17.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                </span>
              </a>
            </li>
            <li data-aos="fade-up-sm" data-aos-delay="150">
              <a href="/pricing" class="btn btn-light">Ver precios</a>
            </li>
          </ul>

          <div class="flex flex-wrap gap-x-8 gap-y-3 text-sm" style="color: rgba(16,25,40,0.62);">
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 text-white text-[10px] font-bold" style="background: #16a34a;">✓</span>
              Incluido en todos los planes
            </div>
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 text-white text-[10px] font-bold" style="background: #16a34a;">✓</span>
              Desde 19 €/mes sin IVA
            </div>
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 text-white text-[10px] font-bold" style="background: #16a34a;">✓</span>
              Sin configuración por tu parte
            </div>
          </div>
        </div>

        <div class="lg:col-6" data-aos="fade-up-sm" data-aos-delay="200">
          <div class="relative px-4 lg:px-0 pt-10 pb-10">
            <div class="absolute -top-10 -right-10 w-80 h-80 rounded-full blur-3xl -z-10 pointer-events-none" style="background: rgba(121,27,70,0.10);"></div>
            <div class="absolute bottom-0 left-0 w-56 h-56 rounded-full blur-2xl -z-10 pointer-events-none" style="background: rgba(211,167,118,0.12);"></div>

            <div class="rounded-2xl overflow-hidden relative z-10 mx-auto" style="box-shadow: 0 30px 80px rgba(0,0,0,0.18), 0 6px 20px rgba(0,0,0,0.08); border: 1px solid rgba(16,25,40,0.08);">
              <img
                src={`${IMG}/verifactu-qr.webp`}
                alt="Detalle de una factura emitida con Drenpos con el código QR y la leyenda VERI*FACTU"
                width="1200"
                height="800"
                class="w-full h-auto block"
                fetchpriority="high"
              />
            </div>

            <div class="absolute -bottom-5 -left-2 lg:-left-8 rounded-2xl px-4 py-3 flex items-center gap-3" style="background: white; box-shadow: 0 8px 32px rgba(0,0,0,0.13); border: 1px solid rgba(16,25,40,0.07);" data-aos="zoom-in-up-sm" data-aos-delay="500">
              <div class="w-9 h-9 rounded-full flex items-center justify-center text-base flex-shrink-0 font-bold" style="background: #dcfce7; color: #16a34a;">✓</div>
              <div>
                <p class="text-xs font-bold text-dark">Registro remitido</p>
                <p class="text-xs" style="color: #9ca3af;">Huella encadenada con la factura anterior</p>
              </div>
            </div>

            <div class="absolute -top-5 -right-2 lg:-right-6 rounded-2xl px-4 py-3 flex items-center gap-2.5" style="background: white; box-shadow: 0 8px 32px rgba(0,0,0,0.13); border: 1px solid rgba(16,25,40,0.07);" data-aos="fade-up-sm" data-aos-delay="450">
              <div class="w-8 h-8 rounded-xl flex items-center justify-center text-lg flex-shrink-0" style="background: #fef3c7;">📅</div>
              <div>
                <p class="text-xs font-bold text-dark">1 de enero de 2027</p>
                <p class="text-xs" style="color: #9ca3af;">Sociedades. Autónomos, 1 de julio</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ClientLogosStrip />

  <!-- ═══════════════════════════════════════════════════════════════════
       DEFINICIÓN CITABLE (AEO / featured snippet)
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section-sm pb-0">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-9 text-center" data-aos="fade-up-sm">
          <h2 class="h4 font-bold mb-4">¿Qué es un software de facturación Verifactu?</h2>
          <p class="text-lg leading-relaxed" style="color: rgba(16,25,40,0.72);">
            Un <strong>software Verifactu</strong> es un programa de facturación
            que, por cada factura que emites, genera un
            <strong>registro de facturación</strong> con una huella (hash)
            encadenada con el registro anterior, imprime en la factura un
            <strong>código QR</strong> junto a la leyenda VERI*FACTU y
            <strong>remite ese registro a la Agencia Tributaria</strong>. Los
            requisitos los fijan el Real Decreto 1007/2023 y la Orden
            HAC/1177/2024. Drenpos funciona así desde la primera factura, sin
            que el cliente tenga que activar ni configurar nada.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       CÓMO FUNCIONA (3 pasos)
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section-sm">
    <div class="container">
      <div class="text-center mb-12" data-aos="fade-up-sm">
        <h2 class="h3 font-bold mb-4">Cómo funciona Verifactu en Drenpos</h2>
        <p class="text-lg" style="color: rgba(16,25,40,0.65);">
          Tres pasos, y dos de ellos los hace el sistema.
        </p>
      </div>
      <div class="row g-4 justify-center">
        {
          pasos.map((p, i) => (
            <div class="md:col-6 lg:col-4" data-aos="fade-up-sm" data-aos-delay={i * 100}>
              <div class="h-full rounded-3xl border border-dark/10 bg-body p-7 hover:shadow-xl transition-shadow duration-300">
                <div class="w-11 h-11 rounded-2xl flex items-center justify-center text-lg font-bold text-white mb-4" style="background: #791b46;">{p.n}</div>
                <h3 class="h6 font-bold mb-3 leading-snug">{p.title}</h3>
                <p class="text-sm" style="color: rgba(16,25,40,0.65);">{p.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       SHOWCASE OSCURO: capturas reales + ventajas
  ═══════════════════════════════════════════════════════════════════ -->
  <section id="como-lo-ves" class="section pt-0 overflow-hidden scroll-mt-24">
