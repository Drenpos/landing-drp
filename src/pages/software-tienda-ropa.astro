---
import { abs, AUTOR } from "@/lib/site";
import { breadcrumb, faqPage, softwareApp } from "@/lib/schema";
import JsonLd from "@/components/JsonLd.astro";
export const prerender = true;
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import ClientLogosStrip from "@/partials/ClientLogosStrip.astro";
import DemoForm from "@/partials/DemoForm.astro";
import LandingMeta from "@/partials/LandingMeta.astro";
import { existsSync } from "node:fs";
import { join } from "node:path";

const hasImg = (p: string) => existsSync(join(process.cwd(), "public", p));

// ════════════════════════════════════════════════════════════════════════
//  Programa para tiendas de ropa, calzado y complementos (SEO/AEO, 06/11/2026)
//  Intención de búsqueda objetivo:
//    - "programa tienda de ropa" / "programa para tienda de ropa"
//    - "TPV tienda de ropa tallas y colores"
//    - "software tienda de moda stock tallas"
//  SERP consultada el 06/11/2026: comparadores (SoftDoit, Capterra), TPV de
//  moda de nicho y guías de Odoo. Casi nadie dice qué no hace su programa
//  ni explica cómo se migra desde un programa de moda. Aquí sí.
//  Fuente de las funciones: context/products_modules.md («Variantes por
//  atributos», «TPV Tienda», «Etiquetas», «Importación desde Excel»).
// ════════════════════════════════════════════════════════════════════════

const PATH = "/software-tienda-ropa";
const CANONICAL = abs(PATH);

const HERO_IMG = "/images/funcionalidades/almacen-tienda/03-tpv-tienda.png";
const UBICACIONES_IMG = "/images/funcionalidades/almacen-tienda/01-almacen-ubicaciones.png";
const PISTOLA_IMG = "/images/funcionalidades/almacen-tienda/04-pistola-traslados.png";

const sintomas = [
  {
    icon: "👕",
    title: "Veinte fichas para una camiseta",
    body: "Cada talla y cada color es un artículo suelto con su nombre. Cambiar el precio o la familia del modelo es repetir lo mismo veinte veces, y siempre se escapa alguna.",
  },
  {
    icon: "📏",
    title: "«¿Te queda una M en azul?»",
    body: "El cliente pregunta y la respuesta depende de ir al almacén. El programa sabe cuántas camisetas hay, pero no cuántas de cada talla.",
  },
  {
    icon: "🧾",
    title: "El pedido de temporada, a mano",
    body: "El pedido al proveedor llega por tallas y colores y se teclea línea a línea. En la recepción pasa igual, y el error de una talla se descubre en el probador.",
  },
  {
    icon: "🏷️",
    title: "Etiquetas que no cuadran",
    body: "Las etiquetas se hacen por modelo y la talla se escribe a boli, o se imprimen de más. En caja, el código no distingue la S de la L.",
  },
];

type Bloque = {
  id: string;
  icon: string;
  h2: string;
  capsula: string;
  bullets: string[];
  img?: string;
  alt?: string;
};

const bloques: Bloque[] = [
  {
    id: "variantes",
    icon: "🎨",
    h2: "¿Cómo se dan de alta las tallas y los colores?",
    capsula:
      "Se crea un modelo, por ejemplo «Camiseta básica», y en su pestaña Variantes se eligen los atributos y sus valores: cinco tallas y cuatro colores. El programa avisa de que se crearán 20 variantes y las genera de una vez. Cada variante es un artículo normal con su stock, su código de barras y su etiqueta; el modelo solo las agrupa y no tiene stock propio.",
    bullets: [
      "Catálogo de atributos propio: talla, color, número de calzado, acabado, con orden y muestra de color",
      "Código de cada variante generado solo: MODELO-valor-valor",
      "Rejilla talla × color en la ficha con el stock, el precio y el código de barras de cada celda",
      "Familia, impuestos, unidades y etiqueta se cambian en el modelo y pasan a todas sus variantes",
      "El precio se hereda del modelo, salvo la variante que lleve el suyo (la XXL más cara, por ejemplo)",
    ],
  },
  {
    id: "compras",
    icon: "📦",
    h2: "¿Cómo se hace el pedido al proveedor por tallas?",
    capsula:
      "En el pedido de compra eliges el modelo y se abre una rejilla con las tallas en un eje y los colores en el otro. Rellenas las cantidades de cada celda y entra una línea por variante, sin teclearlas una a una. La recepción usa la misma rejilla o la pistola, así que lo que llega se compara con lo pedido talla por talla.",
    bullets: [
      "La rejilla sale en pedidos, albaranes y facturas de compra y de venta",
      "También en recepción, recuentos de inventario, reservas y etiquetas",
      "Escanear el código de una variante la añade directa, sin pasar por la rejilla",
      "Stock por almacén: la tienda y la trastienda pueden ser dos almacenes con sus ubicaciones",
    ],
    img: PISTOLA_IMG,
    alt: "Lectura con pistola en Drenpos para recibir prendas por talla y color sin teclear",
  },
  {
    id: "tpv",
    icon: "🛍️",
    h2: "¿Cómo se vende una talla y un color en el TPV?",
    capsula:
      "En el TPV de tienda, tocar el modelo lo abre como un grupo con un botón por variante, del tipo «Azul · M», con su foto y su stock. La dependienta toca el botón y la línea entra con su precio. Si la prenda lleva etiqueta, se escanea y la variante se añade directa. Cada ticket sale en modalidad Verifactu y descuenta la talla vendida.",
    bullets: [
      "Varias cuentas abiertas a la vez, con un cliente en espera mientras se atiende a otro",
      "Buscador global para lo que no está en los grupos de la pantalla",
      "Asistente de cambio y métodos de pago configurables",
      "Cierre de caja con desglose por método de pago y reporte imprimible",
      "Historial de tickets con reimpresión",
    ],
    img: HERO_IMG,
    alt: "TPV de tienda de Drenpos con grupos de artículos para vender prendas por talla y color",
  },
  {
    id: "etiquetas",
    icon: "🏷️",
    h2: "¿Se imprime una etiqueta por talla y color?",
    capsula:
      "Sí. Cada variante tiene su código de barras y su etiqueta, así que la S y la L no se confunden en caja. Desde el Centro de etiquetas añades variantes con el buscador, con la rejilla o escaneando, ajustas cuántas de cada una o pones «= stock» para etiquetar todo lo recibido, y eliges rollo térmico u hoja A4.",
    bullets: [
      "Etiqueta de precio con código de barras para tienda, entre los diseños de serie",
      "Impresión también desde la recepción y desde los documentos de compra",
      "Hoja A4 empezando en la posición que quieras, para aprovechar hojas ya empezadas",
      "Vista previa antes de imprimir; la impresión va por PDF desde el navegador",
    ],
  },
  {
    id: "online",
    icon: "🌐",
    h2: "¿Se conecta con la tienda online?",
    capsula:
      "Con WooCommerce y con Faire, sí. El modelo se publica como producto variable con sus atributos, y el stock y el precio salen de Drenpos. También se pueden traer desde la tienda online los productos variables que ya tengas publicados, una opción que viene apagada de fábrica. Los pedidos de la web entran en Drenpos para prepararlos.",
    bullets: [
      "Conectores con WooCommerce y Faire sin coste aparte",
      "Faire, para marcas de moda que venden al por mayor a otras tiendas",
      "Con otras plataformas, la integración se estudia caso a caso",
    ],
    img: UBICACIONES_IMG,
    alt: "Almacenes y ubicaciones en Drenpos de donde salen el stock de la tienda física y de la online",
  },
  {
    id: "migrar",
    icon: "📑",
    h2: "¿Cómo se pasa el catálogo desde otro programa de moda?",
    capsula:
      "Con la plantilla de Excel de artículos, que tiene una hoja Variantes: una fila por variante con su modelo y hasta tres atributos. Sacas el listado de tu programa actual, lo adaptas a las columnas y lo cargas de una vez. La exportación hace lo contrario: una fila por variante, para revisar precios o stock en una hoja de cálculo.",
    bullets: [
      "Clientes, proveedores, familias, listas de precios y stock inicial también desde Excel",
      "Filtro por modelo en el listado de artículos y en los informes",
      "Puesta en marcha en días: hay quien carga su catálogo solo y quien prefiere que lo hagamos nosotros",
    ],
  },
];

// Lo que no hace (context/products_modules.md, «Variantes por atributos», Ser honesto)
const noHace = [
  "Un artículo que ya tiene movimientos no se convierte en modelo: se crea un modelo nuevo",
  "No hay variantes de variantes (una talla dentro de un color dentro de otro modelo)",
  "La rejilla enseña dos ejes; si hay un tercer atributo, se elige en un selector",
  "En la tienda online se publica el modelo completo, no una variante suelta",
  "No trae tienda online propia: se conecta a WooCommerce o Faire",
];

const comparativa = [
  {
    opcion: "Excel y caja registradora",
    tallas: "Una fila por talla, a mano",
    tpv: "Sin botones por talla",
    compras: "Pedido tecleado",
    online: "No",
    verifactu: "No: hace falta otro programa",
  },
  {
    opcion: "TPV de moda de nicho",
    tallas: "Sí, suele ser su fuerte",
    tpv: "Sí",
    compras: "Normalmente sí",
    online: "Depende del fabricante",
    verifactu: "Depende del fabricante",
  },
  {
    opcion: "TPV genérico",
    tallas: "Pocas veces: una ficha por talla",
    tpv: "Sí, sin agrupar tallas",
    compras: "Básicas",
    online: "Depende",
    verifactu: "Depende del TPV",
  },
  {
    opcion: "Drenpos",
    tallas: "Modelo con variantes y rejilla talla × color",
    tpv: "Botón por variante con foto y stock",
    compras: "Pedido y recepción en rejilla o con pistola",
    online: "WooCommerce y Faire",
    verifactu: "Sí, en cada factura y cada ticket",
    destacado: true,
  },
];

const casos = [
  {
    tag: "Tienda de ropa",
    icon: "👕",
    title: "Camisetas en cinco tallas y cuatro colores",
    body: "Pongamos una tienda con 300 modelos. Da de alta «Camiseta» con cinco tallas y cuatro colores y salen 20 variantes en un clic. El pedido de temporada y la recepción se rellenan en la rejilla, las etiquetas salen por variante y en el TPV la dependienta toca «Camiseta» y luego «Azul · M».",
  },
  {
    tag: "Zapatería",
    icon: "👟",
    title: "Del 36 al 46, con dos colores por modelo",
    body: "El atributo es el número, no la talla de letra. Cada número de cada color es una variante con su código de barras, así que en el recuento con pistola se sabe cuántos pares quedan del 42 en negro. La rejilla del pedido tiene los números en un eje y los colores en el otro.",
  },
  {
    tag: "Complementos y hogar",
    icon: "💡",
    title: "No solo ropa: color y potencia",
    body: "Las variantes no están atadas a la moda. Una tienda de iluminación o de estufas usa color × potencia, y una de bolsos, color × acabado. El modelo agrupa, cada variante vende y descuenta su propio stock, y la tienda online publica el producto con todas sus opciones.",
  },
];

const faqs = [
  {
    q: "¿Qué programa necesita una tienda de ropa?",
    a: "Uno que lleve las tallas y los colores como variantes de un mismo modelo, con stock por variante, un TPV que las enseñe agrupadas, pedidos y recepciones por rejilla, etiquetas con código de barras por talla y facturación Verifactu. Drenpos hace todo eso. Si además vendes por internet, que se conecte con tu tienda online para que el stock sea el mismo.",
  },
  {
    q: "¿Cómo se lleva el stock por talla y color?",
    a: "Cada combinación de talla y color es una variante con su propio stock, su código de barras y su etiqueta. El modelo las agrupa y no tiene stock. En la ficha del modelo ves una rejilla talla × color con el stock de cada celda, y cada venta, compra o recuento mueve solo la variante afectada.",
  },
  {
    q: "¿Sirve para zapaterías o tiendas de complementos?",
    a: "Sí. Los atributos los define la tienda: número de calzado, color, acabado, potencia o voltaje. Una zapatería usa número × color; una tienda de iluminación, color × potencia. Admite hasta tres atributos por modelo; la rejilla enseña dos y el tercero se elige en un selector.",
  },
  {
    q: "¿Puedo importar mi catálogo de tallas y colores desde Excel?",
    a: "Sí. La plantilla de artículos tiene una hoja Variantes con una fila por variante: el modelo y hasta tres atributos. Se sacan los datos del programa que uses hoy, se adaptan a las columnas y se cargan de una vez. La exportación saca también una fila por variante.",
  },
  {
    q: "¿Se conecta con WooCommerce?",
    a: "Sí, y también con Faire. El modelo se publica como producto variable con sus atributos, y el precio y el stock salen de Drenpos. Se pueden importar desde la tienda los productos variables que ya tengas publicados, con una opción que viene apagada de fábrica. En la tienda online se publica el modelo completo, no una variante suelta.",
  },
  {
    q: "¿Cuánto cuesta un programa para tienda de ropa con Drenpos?",
    a: "Si quieres llevar el stock por talla y color, con pedidos, recepción, recuentos y propuesta de compra, el plan es Almacén con TPV: [[p:almacen_tpv]]/mes sin IVA con [[n:almacen_usuarios]] usuarios. Si solo necesitas vender y facturar con el TPV, el plan Tienda y Hostelería cuesta [[p:tienda]]/mes sin IVA con [[n:tienda_usuarios]] usuarios: el TPV también marca el stock de cada talla, pero no lleva el módulo de inventario (pedidos a proveedor, recepción, recuentos ni propuesta de compra). Sin permanencia.",
  },
  {
    q: "¿Qué no hace Drenpos con las variantes?",
    a: "Un artículo con movimientos no se convierte en modelo: se crea uno nuevo. No hay variantes de variantes. La rejilla enseña dos ejes y el tercero va en un selector. Y en la tienda online se publica el modelo, no una variante suelta. Tampoco trae tienda online propia: se conecta a WooCommerce o a Faire.",
  },
];

const hermanas = [
  {
    url: "/software-almacen-tienda",
    title: "Programa de gestión para tiendas",
    body: "La visión general de almacén y TPV para cualquier tienda: alimentación, ferretería o tienda con almacén detrás.",
  },
  {
    url: "/software-control-stock",
    title: "Control de stock e inventario",
    body: "Mínimos y máximos con alertas, propuesta de compra, inventarios por zonas y valoración del stock.",
  },
  {
    url: "/software-tienda-recambios",
    title: "Tienda de recambios y repuestos",
    body: "Stock por referencia, mostrador con TPV y pedidos a proveedor, sin catálogo de piezas integrado.",
  },
  {
    url: "/software-verifactu",
    title: "Facturación Verifactu",
    body: "Huella encadenada, QR y envío a la AEAT en cada factura y cada ticket, sin configurar nada.",
  },
  {
    url: "/control-horario",
    title: "Control horario del equipo",
    body: "El fichaje de las dependientas, con vacaciones y turnos, incluido en el plan.",
  },
];

const articulos = [
  { t: "Stock por talla y color sin duplicar artículos", s: "tallas-colores-stock-tienda-ropa" },
  { t: "Tarifas sobre coste: actualizar precios cuando sube el proveedor", s: "tarifas-sobre-coste-actualizar-precios" },
  { t: "Stock mínimo, stock de seguridad y punto de pedido", s: "stock-minimo-punto-de-pedido" },
  { t: "Control de stock: qué es, métodos y cómo evitar roturas", s: "control-de-stock-sin-roturas" },
  { t: "Inventario cíclico: contar el almacén sin cerrarlo", s: "inventario-ciclico-almacen" },
  { t: "Recepción de mercancía: qué comprobar y cómo registrarla", s: "recepcion-mercancia-almacen" },
  { t: "Exportar las facturas a A3 con el fichero SUENLACE.DAT", s: "exportar-facturas-a3-suenlace" },
  { t: "VERI*FACTU: qué es y cómo adaptarte antes de octubre de 2028", s: "verifactu-pymes-guia-2026" },
];

const breadcrumbSchema = breadcrumb([
  { name: "Funcionalidades", path: "/funcionalidades" },
  { name: "Programa para tienda de ropa", path: PATH },
]);

const productSchema = softwareApp({
  name: "Drenpos · Programa para tiendas de ropa, calzado y complementos",
  path: PATH,
  description:
    "Programa de gestión para tiendas de ropa, zapaterías y tiendas de complementos: modelos con variantes por talla y color (o cualquier atributo), stock por variante, rejilla de cantidades en compras, recepción, recuentos y etiquetas, TPV de tienda con un botón por variante, etiquetas con código de barras por talla, conectores con WooCommerce y Faire, importación desde Excel y facturación Verifactu.",
  plan: "tienda",
  offerDescription:
    "Plan Tienda y Hostelería [[p:tienda]]/mes sin IVA; con stock por talla y color, plan Almacén con TPV [[p:almacen_tpv]]/mes sin IVA. Sin permanencia.",
  featureList: [
    "Modelos con variantes por atributos: talla, color, número, acabado",
    "Generación de todas las variantes de una vez con código propio",
    "Rejilla talla × color con stock, precio y código de barras",
    "Rejilla de cantidades en pedidos, albaranes, recepción, recuentos, reservas y etiquetas",
    "TPV de tienda con botón por variante, foto y stock",
    "Etiquetas con código de barras por variante",
    "Conectores con WooCommerce y Faire como producto variable",
    "Importación y exportación de variantes desde Excel",
    "Facturación y tickets en modalidad Verifactu",
  ],
});

const faqSchema = faqPage(faqs);

const PAGE_PUBLISHED = "2026-11-06";
const PAGE_UPDATED = "2026-11-06";
---

<Base
  title="Programa para Tienda de Ropa · Drenpos"
  meta_title="Programa para Tienda de Ropa con Tallas y Colores | Drenpos"
  description="Programa para tienda de ropa, calzado y complementos: stock por talla y color, TPV con un botón por variante, etiquetas, WooCommerce y Verifactu."
  canonical={CANONICAL}
  image={HERO_IMG}
  published_date={PAGE_PUBLISHED}
  modified_date={PAGE_UPDATED}
  author={AUTOR}
>
  <JsonLd data={[breadcrumbSchema, productSchema, faqSchema]} />

  <!-- ═══════════════════════════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section-sm pb-0 relative z-10 overflow-hidden">
    <div class="absolute inset-0 z-0 pointer-events-none">
      <img src="/images/grainy.svg" alt="" width="1440" height="900" class="w-full h-full object-cover opacity-[.08]" />
    </div>

    <div class="container relative z-10">
      <nav aria-label="Migas de pan" class="mb-6 text-sm text-dark/55">
        <a href="/" class="hover:text-primary">Inicio</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <a href="/funcionalidades" class="hover:text-primary">Funcionalidades</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-primary font-medium">Tienda de ropa</span>
      </nav>

      <div class="row gx-0 gy-12 lg:gy-0 items-center">
        <div class="lg:col-6" data-aos="fade-up-sm">
          <span class="text-primary bg-primary/10 px-4 py-1.5 inline-flex items-center gap-2 rounded-full uppercase text-sm font-medium mb-6">
            <span class="w-2 h-2 rounded-full bg-success" aria-hidden="true"></span>
            Ropa, calzado y complementos
          </span>

          <h1 class="mb-5 text-h3 lg:text-h1 font-bold leading-tight">
            Programa para <span class="text-primary">tienda de ropa</span>: tallas y colores, stock por variante y TPV en el mismo sistema
          </h1>
          <p class="text-lg mb-8 max-w-xl text-dark/72">
            Das de alta el modelo una vez y el programa crea todas sus
            <strong>tallas y colores</strong>. Cada variante lleva su stock, su
            código de barras y su etiqueta, el pedido al proveedor se rellena en
            una <strong>rejilla</strong> y en el <strong>TPV</strong> se vende con
            un botón por talla. Vale para ropa, zapatería, complementos o
            cualquier producto con opciones.
          </p>

          <LandingMeta updated={PAGE_UPDATED} published={PAGE_PUBLISHED} class="-mt-4 mb-8" />

          <ul class="flex flex-wrap gap-4 mb-10">
            <li data-aos="fade-up-sm" data-aos-delay="100">
              <a href="#demo-form" class="btn btn-dark">
                Pedir demo gratuita
                <span class="icon-wrapper">
                  <span class="icon">
                    <svg width="19" height="12" viewBox="0 0 19 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12.5 1L17.5 6L12.5 11M1.5 6H17.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                  <span class="icon" aria-hidden="true">
                    <svg width="19" height="12" viewBox="0 0 19 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12.5 1L17.5 6L12.5 11M1.5 6H17.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                </span>
              </a>
            </li>
            <li data-aos="fade-up-sm" data-aos-delay="150">
              <a href="/pricing" class="btn btn-light">Ver precios</a>
            </li>
          </ul>

          <div class="flex flex-wrap gap-x-8 gap-y-3 text-sm text-dark/62">
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 text-white text-[10px] font-bold bg-success">✓</span>
              Stock por talla y color
            </div>
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 text-white text-[10px] font-bold bg-success">✓</span>
              Rejilla en compras
            </div>
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 text-white text-[10px] font-bold bg-success">✓</span>
              TPV con Verifactu
            </div>
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 text-white text-[10px] font-bold bg-success">✓</span>
              Sin permanencia
            </div>
          </div>
        </div>

        <div class="lg:col-6" data-aos="fade-up-sm" data-aos-delay="200">
          <div class="relative px-4 lg:px-0 pt-10 pb-10">
            <div class="absolute -top-10 -right-10 w-80 h-80 rounded-full blur-3xl -z-10 pointer-events-none bg-primary/10"></div>
            <div class="absolute bottom-0 left-0 w-56 h-56 rounded-full blur-2xl -z-10 pointer-events-none bg-secondary/12"></div>

            <div class="rounded-2xl overflow-hidden relative z-10 border border-dark/8" style="box-shadow: 0 30px 80px rgba(0,0,0,0.18), 0 6px 20px rgba(0,0,0,0.08);">
              <img
                src={HERO_IMG}
                alt="Punto de venta de Drenpos para el mostrador de una tienda de ropa"
                width="720"
                height="480"
                class="w-full h-auto block"
                fetchpriority="high"
              />
            </div>

            <div class="absolute -bottom-5 -left-2 lg:-left-8 rounded-2xl px-4 py-3 flex items-center gap-3 border border-dark/7" style="background: white; box-shadow: 0 8px 32px rgba(0,0,0,0.13);" data-aos="zoom-in-up-sm" data-aos-delay="500">
              <div class="w-9 h-9 rounded-full flex items-center justify-center text-base flex-shrink-0 font-bold bg-success-light text-success">20</div>
              <div>
                <p class="text-xs font-bold text-dark">Se crearán 20 variantes</p>
                <p class="text-xs text-muted">Camiseta · 5 tallas × 4 colores</p>
              </div>
            </div>

            <div class="absolute -top-5 -right-2 lg:-right-6 rounded-2xl px-4 py-3 flex items-center gap-2.5 border border-dark/7" style="background: white; box-shadow: 0 8px 32px rgba(0,0,0,0.13);" data-aos="fade-up-sm" data-aos-delay="450">
              <div class="w-8 h-8 rounded-xl flex items-center justify-center text-lg flex-shrink-0 bg-accent-light">👕</div>
              <div>
                <p class="text-xs font-bold text-dark">Azul · M</p>
                <p class="text-xs text-muted">Quedan 3 en tienda</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ClientLogosStrip />

  <!-- ═══════════════════════════════════════════════════════════════════
       DEFINICIÓN CITABLE (AEO)
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section-sm pb-0">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-9 text-center" data-aos="fade-up-sm">
          <h2 class="h4 font-bold mb-4">¿Qué es un programa para tienda de ropa?</h2>
          <p class="text-lg leading-relaxed text-dark/72">
            Un <strong>programa para tienda de ropa</strong> es el software que
            agrupa cada prenda en un modelo con sus tallas y colores, lleva el
            stock de cada combinación, vende en el mostrador con un TPV que
            enseña las tallas agrupadas y prepara pedidos y etiquetas por
            variante. Sustituye a la hoja de cálculo con una fila por talla y a
            la caja registradora que no sabe qué talla vendió.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       SÍNTOMAS
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section-sm">
    <div class="container">
      <div class="text-center mb-12" data-aos="fade-up-sm">
        <h2 class="h3 font-bold mb-4">¿Te pasa alguna de estas en la tienda?</h2>
        <p class="text-lg text-dark/65">
          Son las cuatro razones por las que una tienda de moda cambia de programa.
        </p>
      </div>
      <div class="row g-4 justify-center">
        {
          sintomas.map((s, i) => (
            <div class="md:col-6 lg:col-3" data-aos="fade-up-sm" data-aos-delay={i * 100}>
              <div class="h-full rounded-3xl border border-dark/10 bg-body p-6 hover:shadow-xl transition-shadow duration-300">
                <div class="text-3xl mb-4">{s.icon}</div>
                <h3 class="h6 font-bold mb-3 leading-snug">{s.title}</h3>
                <p class="text-sm text-dark/65">{s.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       CÓMO FUNCIONA, POR BLOQUES
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section pt-0 overflow-hidden">
    <div class="container">
      {
        bloques.map((b, i) => (
          <div id={b.id} class={`row gy-8 items-start scroll-mt-24 ${i > 0 ? "mt-16 lg:mt-24" : ""}`}>
            <div class="lg:col-6" data-aos="fade-up-sm">
              <div class="text-3xl mb-4">{b.icon}</div>
              <h2 class="h4 mb-4 font-bold leading-tight">{b.h2}</h2>
              <p class="text-lg leading-relaxed mb-4 text-dark/75">{b.capsula}</p>
            </div>
            <div class="lg:col-6" data-aos="fade-up-sm" data-aos-delay="150">
              {b.img && hasImg(b.img) && (
                <figure class="rounded-2xl overflow-hidden mb-6 border border-dark/8" style="box-shadow: 0 20px 60px rgba(0,0,0,0.14);">
                  <img src={b.img} alt={b.alt} width="640" height="420" class="w-full h-auto block" loading="lazy" />
                </figure>
              )}
              <div class="rounded-3xl border border-dark/10 bg-body p-7">
                <ul class="space-y-3">
                  {b.bullets.map((t) => (
                    <li class="flex items-start gap-3">
                      <span class="w-5 h-5 mt-0.5 rounded-full flex items-center justify-center flex-shrink-0 text-white text-[10px] font-bold bg-success">✓</span>
                      <span class="text-sm text-dark/75">{t}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       QUÉ NO HACE (honestidad)
  ═══════════════════════════════════════════════════════════════════ -->
  <section id="que-no-hace" class="section pt-0 overflow-hidden scroll-mt-24">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-10">
          <div class="rounded-3xl p-8 lg:p-12 text-white bg-dark" data-aos="fade-up-sm">
            <h2 class="h3 font-bold mb-4 text-white">¿Qué no hace Drenpos con las tallas y colores?</h2>
            <p class="text-lg leading-relaxed mb-8 text-white/82">
              Un artículo que ya tiene ventas o compras no se convierte en
              modelo: se crea un modelo nuevo y se dejan de usar las fichas
              sueltas. No hay variantes de variantes, la rejilla enseña dos ejes
              y en la tienda online se publica el modelo completo, nunca una
              talla suelta. Conviene saberlo antes de migrar.
            </p>
            <div class="row g-6 items-start">
              <div class="md:col-6">
                <ul class="space-y-3">
                  {
                    noHace.map((t) => (
                      <li class="flex items-start gap-3">
                        <span class="w-5 h-5 mt-0.5 rounded-full flex items-center justify-center flex-shrink-0 text-[11px] font-bold bg-white/12 text-accent-light" aria-hidden="true">✕</span>
                        <span class="text-sm text-white/80">{t}</span>
                      </li>
                    ))
                  }
                </ul>
              </div>
              <div class="md:col-6">
                <p class="text-sm leading-relaxed mb-4 text-white/72">
                  Si vienes de un programa de moda con cada talla como artículo
                  suelto, lo práctico es cargar los modelos nuevos desde la hoja
                  Variantes del Excel y dar de baja las fichas antiguas. Su
                  histórico no se pierde: un artículo desactivado sale de
                  informes y propuestas, pero conserva sus movimientos.
                </p>
                <p class="text-sm leading-relaxed text-white/72">
                  Si vendes por internet con una plataforma que no sea
                  WooCommerce ni Faire, la integración se estudia a medida:
                  <a href="/contact" class="underline text-accent-light">cuéntanos qué usas</a>.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       TABLA DE DECISIÓN
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section pt-0 overflow-hidden">
    <div class="container">
      <div class="text-center mb-10" data-aos="fade-up-sm">
        <h2 class="h3 font-bold mb-4">¿Excel, un TPV de moda, un TPV genérico o Drenpos?</h2>
        <p class="text-lg max-w-3xl mx-auto text-dark/65">
          Las cuatro formas habituales de llevar una tienda de ropa, comparadas
          en lo que se nota con las tallas. Lo de los TPV de nicho y genéricos
          varía según el fabricante: pide detalle antes de decidir.
        </p>
      </div>
      <div class="overflow-x-auto" data-aos="fade-up-sm">
        <table class="w-full text-sm border-collapse min-w-[900px]">
          <thead>
            <tr class="bg-dark text-white">
              <th class="text-left p-4 rounded-tl-2xl">Opción</th>
              <th class="text-left p-4">Tallas y colores</th>
              <th class="text-left p-4">Venta en el TPV</th>
              <th class="text-left p-4">Pedido y recepción</th>
              <th class="text-left p-4">Tienda online</th>
              <th class="text-left p-4 rounded-tr-2xl">Verifactu</th>
            </tr>
          </thead>
          <tbody>
            {
              comparativa.map((r) => (
                <tr class={r.destacado ? "bg-primary/5 font-medium" : "border-b border-dark/5"}>
                  <td class={`p-4 ${r.destacado ? "text-primary font-bold" : "font-medium"}`}>{r.opcion}</td>
                  <td class="p-4">{r.tallas}</td>
                  <td class="p-4">{r.tpv}</td>
                  <td class="p-4">{r.compras}</td>
                  <td class="p-4">{r.online}</td>
                  <td class="p-4">{r.verifactu}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="text-center mt-6 text-sm max-w-3xl mx-auto text-dark/60" data-aos="fade-up-sm">
        Un TPV de moda de nicho tiene sentido si solo vendes ropa y no necesitas
        más. Si además tienes almacén, vendes a otras tiendas o quieres el stock
        de la web en el mismo sitio, Drenpos lo lleva junto.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       CASOS DE USO
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section pt-0 overflow-hidden">
