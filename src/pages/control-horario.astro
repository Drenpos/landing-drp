          </div>
          <div class="lg:col-6">
            <ul class="flex flex-col gap-4">
              {requisitos.map((item, i) => (
                <li class="flex items-start gap-4 p-4 rounded-2xl" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08);" data-aos="fade-up-sm" data-aos-delay={i * 50}>
                  <span class="w-7 h-7 rounded-full flex items-center justify-center flex-shrink-0 font-bold text-sm" style="background: #16a34a; color: white;">✓</span>
                  <span style="color: rgba(255,255,255,0.92);">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <DemoForm interes="fichaje" />

  <!-- ═══════════════════════════════════════════════════════════════════
       FAQ
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section pt-0">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-10 text-center mb-12" data-aos="fade-up-sm">
          <span class="text-primary bg-primary/10 px-3 py-1 inline-block rounded-full uppercase text-sm font-medium mb-4">Preguntas frecuentes</span>
          <h2 class="h3 font-bold mb-3">Control horario: lo que más nos preguntan</h2>
          <p class="text-lg" style="color: rgba(16,25,40,0.65);">
            Si tu duda no está aquí, <a href="/contact" class="text-primary font-semibold underline">escríbenos</a>.
          </p>
        </div>
        <div class="lg:col-10">
          <div class="flex flex-col gap-3">
            {faqs.map((f, i) => (
              <details class="group rounded-2xl border bg-white" style="border-color: rgba(16,25,40,0.1);" data-aos="fade-up-sm" data-aos-delay={i * 40}>
                <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none">
                  <span class="font-semibold text-base lg:text-lg">{f.q}</span>
                  <span class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 transition-transform duration-200 group-open:rotate-45 text-xl leading-none" style="background: rgba(121,27,70,0.10); color: #791b46;" aria-hidden="true">+</span>
                </summary>
                <div class="px-6 pb-6 -mt-2">
                  <p class="text-base leading-relaxed mb-0" style="color: rgba(16,25,40,0.72);">{f.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

