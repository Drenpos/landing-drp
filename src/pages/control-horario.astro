  ═══════════════════════════════════════════════════════════════════ -->
  <section id="calendarios" class="section pt-0 overflow-hidden scroll-mt-24">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-12" data-aos="fade-up-sm">
        <span class="text-primary bg-primary/10 px-3 py-1 inline-block rounded-full uppercase text-sm font-medium mb-4">Calendarios, turnos rotativos, festivos y horas extra</span>
        <h2 class="h3 font-bold mb-4">¿Cómo se calculan las horas extra con el calendario laboral y los festivos?</h2>
        <p class="text-lg leading-relaxed mb-0" style="color: rgba(16,25,40,0.72);">
          Drenpos saca las horas esperadas de cada día del calendario laboral
          de la persona (entrada, salida y pausa) y descuenta sus festivos y
          sus ausencias. Las horas extra son lo trabajado por encima de lo
          esperado, día a día, y la semana o el mes son la suma de los días.
          Es la misma cuenta en pantalla, en las incidencias y en el informe
          PDF, así que nunca tienes dos cifras distintas.
        </p>
      </div>

      <div class="row g-5 items-center">
        {showCalImg && (
          <div class="lg:col-6" data-aos="fade-up-sm">
            <figure class="relative px-4 lg:px-0 mb-0">
              <div class="absolute -top-10 -left-10 w-72 h-72 rounded-full blur-3xl -z-10 pointer-events-none" style="background: rgba(211,167,118,0.14);"></div>
              <div class="rounded-2xl overflow-hidden" style="box-shadow: 0 24px 64px rgba(0,0,0,0.13), 0 4px 16px rgba(0,0,0,0.07); border: 1px solid rgba(16,25,40,0.08);">
                <img src={CAL_IMG} alt="Pantalla de personas y calendarios de Drenpos con el calendario laboral, los festivos nacionales y autonómicos y la fecha de contratación de cada persona" width="1280" height="800" class="w-full h-auto block" loading="lazy" />
              </div>
            </figure>
          </div>
        )}
        <div class={showCalImg ? "lg:col-6" : "col-12"}>
