          <ul class="flex flex-wrap gap-2 mb-6 list-none p-0">
            {incidenciasTipos.map((t) => (
              <li class="text-sm px-3 py-1.5 rounded-full" style="background: rgba(211,167,118,0.15); color: #7c4a14;">{t}</li>
