          <div class={showIncImg ? "grid sm:grid-cols-2 gap-4" : "grid sm:grid-cols-2 lg:grid-cols-4 gap-4"}>
            {entradaSalida.map((e, i) => (
              <div class="border rounded-[20px] p-6 h-full" style="border-color: rgba(16,25,40,0.1); background: #fff;" data-aos="fade-up-sm" data-aos-delay={i * 80}>
                <div class="w-11 h-11 rounded-xl flex items-center justify-center text-xl mb-4" style="background: rgba(121,27,70,0.08);">{e.icon}</div>
                <h3 class="h6 font-semibold mb-2">{e.title}</h3>
                <p class="text-sm leading-relaxed mb-0" style="color: rgba(16,25,40,0.65);">{e.body}</p>
