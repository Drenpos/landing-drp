              <p class="text-base leading-relaxed mb-0" style="color: rgba(16,25,40,0.7);">{c.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       CUMPLIMIENTO LEGAL · checklist
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section pt-0">
    <div class="container">
      <div class="rounded-[28px] overflow-hidden" style="background: rgba(16,25,40,0.97);">
        <div class="row gx-0 gy-10 lg:gy-0 items-center p-10 lg:p-16">
          <div class="lg:col-6 lg:pe-10">
            <span class="text-white bg-white/10 px-3 py-1 inline-block rounded-full uppercase text-xs font-medium mb-5 tracking-wide" data-aos="fade-up-sm">Cumplimiento legal</span>
            <h2 class="h3 font-bold mb-5 text-white leading-tight" data-aos="fade-up-sm">
              Cumples la ley <span style="color: #f9b27c;">desde el primer fichaje</span>
            </h2>
            <p class="text-lg leading-relaxed mb-4" style="color: rgba(255,255,255,0.78);" data-aos="fade-up-sm">
              Drenpos cubre lo que exige hoy el registro de jornada y ya lo lleva
              en digital, con pausas, horas extra y la traza de cada cambio. No
              tienes que configurar nada para estar al día.
            </p>
            <p class="text-sm leading-relaxed mb-0" style="color: rgba(255,255,255,0.62);" data-aos="fade-up-sm">
              A fecha de 23 de septiembre de 2026, el real decreto que haría
              obligatorio el registro digital sigue sin aprobarse ni publicarse
              en el BOE. Cuando salga, revisaremos esta página con lo que diga
