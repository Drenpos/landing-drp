    "Todas las pantallas de palets en móvil y tablet, a pie de cámara",
    "Trazabilidad total con informe de recall en PDF",
    "OCR de albaranes y facturas con alta automática de lotes",
    "Despiece y transformación con lote nuevo, caducidad propia y merma explícita",
    "Depósito de terceros con tarifario por palet/día y kg/día",
    "Posición del depositante en vivo, simulador e informe del periodo en PDF",
    "Preparación de pedidos con semáforo, oleadas y asistente móvil",
    "Informes de rotación e inmovilizado del stock en frío",
  ],
  provider: { "@type": "Organization", name: "Drenpos", url: "https://www.drenpos.com" },
};
---

<Base
  title="Software de Almacén Frigorífico · Drenpos"
  meta_title="Software Almacén Frigorífico y Congelados | Drenpos"
  description="Software de almacén frigorífico para congelados y refrigerados: lotes con FEFO, palets con etiqueta SSCC, trazabilidad y depósito. Desde 19,90 €/mes."
  canonical={CANONICAL}
  image="/images/funcionalidades/almacen-tienda/02-lotes-caducidad.png"
>
  <!-- Datos estructurados -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ═══════════════════════════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════════════════════════ -->
