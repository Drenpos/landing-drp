    ],
  },
  {
    icon: "🔎",
    tag: "Trazabilidad y recall",
    title: "Informe de retirada en PDF listo para Sanidad",
    body: "Pantalla dedicada de trazabilidad que funciona con un lote, un número de serie o un producto sin nada: de qué proveedores entró, a qué clientes salió con sus documentos y cuánto queda vivo y en qué almacén y ubicación. Con un clic, informe PDF listo para presentar a Sanidad o al cliente.",
    bullets: [
      "Accesible también desde la ficha de cada producto",
      "OCR de albaranes y facturas que da de alta los lotes del documento",
      "Etiquetas GS1 con lote o serie impresas desde la propia recepción",
    ],
  },
  {
    icon: "🔪",
    tag: "Despiece y transformación",
    title: "Lote nuevo, caducidad propia y merma registrada",
    body: "Sala de despiece, obrador o envasado: se marca qué sale del palet y qué productos entran a cambio, con su lote nuevo, su caducidad y su destino — el mismo palet, otro, o suelto en cualquier almacén y ubicación. Con borrador en espera para corregir con los kilos reales antes de ejecutar.",
    bullets: [
      "Ejecución en bloque todo o nada: nunca una salida sin su entrada",
      "La merma se registra explícita, como una línea más",
      "Traza de qué cantidades se dedicaron a fabricar qué",
    ],
  },
  {
    icon: "🤝",
    tag: "Depósito de terceros",
    title: "Guardar mercancía de clientes y cobrarla bien",
    body: "Cada palet lleva su propietario y el sistema impide de raíz mezclar mercancía de dueños distintos o vender por error lo que es de un cliente. Tarifas por palet/día, kg/día, entrada, salida, manipulación o bulto preparado, con franquicias, mínimos, vigencias y precios por tipo de soporte.",
    bullets: [
      "Los eventos tarificables se registran solos en cada operación",
      "Posición del cliente en vivo y simulador de coste con desglose",
      "Informe formal del periodo en PDF sin necesidad de facturar",
    ],
  },
];

// Comparativa (tabla AEO — decisión de compra)
const comparativa = [
  {
    opcion: "Excel y papel",
    lotes: "Manual y siempre desfasado",
    palets: "—",
    camara: "Papel y guantes",
    deposito: "—",
    precio: "«Gratis» (se paga en horas y en merma)",
  },
  {
    opcion: "Facturación con inventario básico",
    lotes: "No o muy limitado",
    palets: "No",
    camara: "No",
    deposito: "No",
    precio: "10–30 €/mes",
  },
  {
    opcion: "WMS enterprise",
    lotes: "Sí",
    palets: "Sí, con SSCC",
    camara: "Sí, con terminal propio",
    deposito: "Según módulo y proyecto",
    precio: "Miles de € + proyecto de meses",
  },
  {
    opcion: "Drenpos",
    lotes: "Sí, con FEFO y alertas configurables",
    palets: "Sí, SSCC GS1, pesado y despaletizado",
    camara: "Sí, todas las pantallas de palets en móvil y tablet",
    deposito: "Sí, con tarifario, posición en vivo e informe PDF",
    precio: "Desde 19,90 €/mes",
    destacado: true,
  },
];

// Casos de uso sectoriales
const casos = [
  {
    tag: "Frigorífico de servicio",
    icon: "❄️",
    title: "Cámaras alquiladas a terceros, con liquidación clara",
    body: "Cada palet entra con su propietario y su SSCC. Entradas, salidas y manipulaciones generan su apunte tarificable en la misma operación, la posición de cada depositante se ve en vivo y el informe del periodo sale en PDF, se facture desde Drenpos o desde fuera.",
  },
  {
    tag: "Cárnicas y sala de despiece",
    icon: "🔪",
    title: "De media canal a lomo, panceta y hamburguesas",
    body: "Entra la canal paletizada con su etiqueta SSCC y en la sala de despiece salen productos nuevos con su lote y su caducidad propios. El despiece se ejecuta todo o nada, la merma queda apuntada como una línea más y el vínculo con el lote de origen se mantiene.",
  },
  {
    tag: "Distribución de congelados",
    icon: "🚚",
    title: "Preparación de pedidos sin sacar el género de más",
    body: "El semáforo de preparabilidad dice qué pedidos salen completos hoy, el asistente móvil guía producto a producto con el lote sugerido por FEFO y las oleadas permiten preparar varios pedidos en una sola vuelta. Al expedir, escanear el pedido genera el albarán o la factura.",
  },
  {
    tag: "Hortofrutícola y refrigerado",
    icon: "🥬",
    title: "FEFO en producto de vida corta",
    body: "Con fechas de caducidad muy ajustadas, el sistema propone siempre el lote que antes caduca y avisa con los días de antelación que se configuren, indicando producto, almacén y ubicación. Los informes de rotación e inmovilizado enseñan qué lleva parado demasiado tiempo.",
  },
];

// Normativa citada por nombre exacto (sin articulados ni cifras inventadas)
const normas = [
  {
    nombre: "Reglamento (CE) 178/2002",
    body: "Principios generales de la legislación alimentaria y trazabilidad: poder identificar de dónde vino y a dónde fue cada lote. Es lo que resuelve la pantalla de trazabilidad y el informe de recall en PDF.",
  },
  {
    nombre: "Reglamento (CE) 852/2004",
    body: "Higiene de los productos alimenticios. El registro documental de lotes, movimientos y manipulaciones es la parte que un software puede sostener.",
  },
  {
    nombre: "Reglamento (CE) 853/2004",
    body: "Normas específicas de higiene para alimentos de origen animal, aplicable a cárnicas, pesca y salas de despiece. La identificación por lote y el registro del despiece se apoyan en el sistema.",
  },
  {
    nombre: "Reglamento (UE) 1169/2011",
    body: "Información alimentaria facilitada al consumidor. El sistema mantiene la fecha y el lote asociados a cada producto y a cada salida.",
  },
  {
    nombre: "Sistema APPCC",
    body: "Análisis de Peligros y Puntos de Control Crítico. Drenpos aporta el registro trazable de lotes, caducidades, movimientos, despieces y entregas firmadas que da soporte documental al plan.",
  },
];

const faqs = [
  {
    q: "¿Qué es un software de almacén frigorífico?",
    a: "Es el sistema que controla el stock, la ubicación, el lote, la caducidad y la unidad logística en un almacén donde el hueco cuesta energía todos los días y el producto tiene fecha. Se diferencia de un inventario normal en que no solo sabe cuánto tienes: sabe en qué cámara y en qué ubicación está, de qué lote es, en qué palet viaja, cuándo caduca y cuánta merma se generó al transformarlo. En Drenpos eso incluye FEFO automático, alertas de caducidad, palets con etiqueta SSCC estándar GS1, trazabilidad con informe de recall en PDF y operativa en móvil a pie de cámara.",
  },
  {
    q: "¿Sirve para congelado y refrigerado a la vez?",
    a: "Sí. Drenpos es multialmacén: cada cámara, túnel o zona puede ser un almacén con su stock independiente y sus ubicaciones con QR, y la visión consolidada se mantiene para compras y análisis. El producto de frío negativo y el refrigerado se gestionan con las mismas herramientas — lotes, caducidad, FEFO, palets y traslados — sin duplicar sistemas ni maestros de artículos.",
  },
  {
    q: "¿Cómo controla las caducidades y el FEFO?",
    a: "Cada entrada de un artículo con lotes activados registra su código de lote, su fecha de fabricación y su fecha de caducidad. El método de salida se configura como FIFO, LIFO o FEFO; con FEFO, el sistema selecciona automáticamente el lote que antes caduca, también en el asistente de picking. Las alertas de caducidad avisan los días de antelación que se definan, por artículo o de forma global, y la notificación indica producto, almacén y ubicación.",
  },
  {
    q: "¿Puedo trabajar dentro de la cámara con el móvil?",
    a: "Sí. Todas las pantallas de palets funcionan en móvil y tablet, precisamente para que la operativa se haga a pie de cámara y no en la oficina. El palet se monta con pistola (escanear ubicación, producto y cantidad) o a mano, se cierra y se pesa con bruto, tara y neto, y se mueve entero de ubicación o de almacén en un escaneo. Los traslados tienen además un flujo lineal pensado para operarios con pistola.",
  },
  {
    q: "¿Gestiona palets con etiqueta SSCC?",
    a: "Sí. Cada palet nace con su etiqueta SSCC estándar GS1 imprimible en rollo o A4, y tiene ciclo de vida completo: abierto, cerrado y pesado (bruto, tara y neto), expedido o anulado, con permisos separados por paso. Dentro cabe cualquier mezcla de productos, lotes y series, el despaletizado permite vaciarlo, pasar mercancía a otro palet o partirlo en varios nuevos ya etiquetados, y escanear el SSCC dentro de un albarán o una factura arrastra el palet entero con sus líneas agrupadas y blindadas.",
  },
  {
    q: "¿Puedo alquilar huecos de cámara y facturar el depósito?",
    a: "Sí, con el módulo de depósito de terceros. Cada palet lleva su propietario y el sistema bloquea de raíz mezclar o vender mercancía ajena. Las tarifas admiten palet/día, kg/día, entrada, salida, manipulación o bulto preparado, con días de franquicia, mínimos por liquidación, precios por tipo de soporte y vigencias, y cada concepto elige cómo se cuenta: día a día, foto a fin de mes, pico máximo o aniversario de entrada. La posición del cliente se ve en vivo, hay simulador de coste e informe formal del periodo en PDF sin necesidad de facturar.",
  },
  {
    q: "¿Cómo se registra la merma del despiece?",
    a: "En el despiece se marca qué sale del palet y qué productos entran a cambio, con su lote nuevo y su caducidad. La merma se registra de forma explícita como una línea más: nunca desaparece en silencio. Los despieces se ejecutan en bloque todo o nada, de modo que jamás queda una salida sin su entrada, y queda traza completa de qué cantidades se dedicaron a fabricar qué. Si el palet es de un cliente en depósito, la manipulación genera su apunte de tarifa sola.",
  },
  {
    q: "¿Cuánto cuesta y cuánto se tarda en implantarlo?",
    a: "El módulo de Almacén parte de 19,90 €/mes (sin IVA), con actualizaciones y soporte humano incluidos, sin coste por uso ni permanencia. La implantación estándar se hace en días: importamos los artículos desde Excel o desde el sistema anterior, definimos cámaras, almacenes y ubicaciones, cargamos el stock inicial y formamos al equipo. Para quien necesita que los datos no salgan de la empresa, existe despliegue on-premise en el servidor del cliente, a presupuesto.",
  },
];

// Landings hermanas del clúster de almacén
const hermanas = [
  {
    url: "/software-gestion-almacen",
    title: "Software de gestión de almacén (SGA)",
    body: "La visión completa: multialmacén, ubicaciones QR, lotes, picking, palets y trazabilidad.",
