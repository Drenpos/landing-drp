---
export const prerender = true;
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";

// ════════════════════════════════════════════════════════════════════════
//  Software de almacén frigorífico · landing dedicada (SEO/AEO/GEO 2026)
//  Intención de búsqueda objetivo:
//    - "software almacén frigorífico" (principal)
//    - "software para almacén de congelados" / "gestión de cámaras frigoríficas"
//    - "ERP para frigorífico" / "trazabilidad de la cadena de frío"
//    - long-tail: almacén de frío negativo, cárnicas, pescado congelado
//  Diferenciación con /software-gestion-almacen: esa ataca el SGA genérico;
//  esta ataca frío, congelado, cámara y cadena de frío.
//  Imágenes UI: /public/images/funcionalidades/almacen-tienda/
// ════════════════════════════════════════════════════════════════════════

const CANONICAL = "https://www.drenpos.com/software-almacen-frigorifico";

// Síntomas (dolores reales de un almacén de frío)
const sintomas = [
  {
    icon: "🧊",
    title: "El hueco frío está lleno de género parado y nadie lo sabe",
    body: "Congelar cuesta energía todos los días. Sin informes de rotación e inmovilizado, el palet que lleva meses sin moverse sigue pagando luz como el que entró ayer.",
  },
  {
    icon: "🧤",
    title: "El operario apunta en papel con guantes y luego alguien lo teclea",
    body: "Dos capturas para el mismo dato: la de la cámara y la de la oficina. Entre una y otra se pierden lotes, kilos y ubicaciones — y el descuadre aparece días después.",
  },
  {
    icon: "🗓️",
    title: "Las caducidades se descubren tarde",
    body: "Cuando la fecha se revisa palet a palet, se descubre el problema el día que ya es merma. Sin alertas por lote, la caducidad siempre llega antes que el aviso.",
  },
  {
    icon: "📍",
    title: "Nadie sabe en qué cámara y a qué altura está un lote concreto",
    body: "Localizar un lote significa abrir la cámara, bajar palets y buscar. Y si hay que retirarlo por una incidencia, el reloj corre mientras el equipo mira estanterías.",
  },
];

// Capacidades reales (todas mapeadas 1:1 al módulo de Inventario)
const capacidades = [
  {
    icon: "🗓️",
    tag: "Cadena de frío",
    title: "Lotes, caducidades y FEFO automático con alertas",
    body: "Cada entrada registra su lote, su fecha de fabricación y su fecha de caducidad. El sistema puede servir por FIFO, LIFO o FEFO y, cuando FEFO está configurado, elige el lote solo, sin intervención manual. Las alertas avisan X días antes de que caduque un lote, configurables por artículo o de forma global.",
    bullets: [
      "La alerta dice qué producto, en qué almacén y en qué ubicación",
      "FEFO también en el asistente de picking, con lote sugerido",
      "Números de serie con las mismas garantías que los lotes",
    ],
  },
  {
    icon: "🏷️",
    tag: "Palets y unidades logísticas",
    title: "Etiqueta SSCC estándar GS1 y palet pesado",
    body: "Cada palet nace con su etiqueta SSCC estándar GS1 imprimible en rollo o A4 — la misma que exigen las grandes plataformas logísticas. Ciclo de vida completo: abierto mientras se carga, cerrado y pesado con bruto, tara y neto, expedido o anulado, con permisos separados para cada paso.",
    bullets: [
      "Mover el palet entero de cámara o ubicación en un escaneo",
      "Despaletizado en tres gestos: vaciar, pasar a otro o partir en varios",
      "Mezcla libre de productos, lotes y series, con traza de todo el palet",
    ],
  },
  {
    icon: "📱",
    tag: "Operativa a pie de cámara",
    title: "Móvil y tablet dentro del frío, no en la oficina",
    body: "Todas las pantallas de palets funcionan en móvil y tablet: el palet se monta, se cierra, se pesa y se mueve donde está la mercancía. El montaje admite pistola lectora (escanear ubicación, producto y cantidad) o a mano, y los dos caminos están siempre disponibles.",
    bullets: [
      "Traslados con flujo lineal pensado para pistola, sin tocar pantalla",
      "Vista global de contenido: dónde está este lote, en una pantalla",
