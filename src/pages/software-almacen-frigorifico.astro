  offers: {
    "@type": "Offer",
    price: "19.90",
    priceCurrency: "EUR",
    description: "Módulo Almacén desde 19,90 €/mes (sin IVA). Sin coste por uso ni permanencia.",
    url: "https://www.drenpos.com/pricing",
  },
  featureList: [
    "Multialmacén por cámara, túnel o zona con ubicaciones QR",
    "Lotes con fecha de fabricación y caducidad",
    "Salidas por FIFO, LIFO o FEFO con selección automática de lote",
    "Alertas de caducidad configurables con artículo, almacén y ubicación",
    "Palets con etiqueta SSCC estándar GS1 imprimible en rollo o A4",
    "Ciclo de vida del palet: abierto, cerrado y pesado, expedido o anulado",
    "Pesado de palet con bruto, tara y neto",
