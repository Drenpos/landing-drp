---
// Preguntas frecuentes visibles en acordeón. El JSON-LD (faqPage) lo emite
// la página con las mismas preguntas, para que lo visible y el schema coincidan.
import type { Pregunta } from "@/lib/schema";

interface Props {
  faqs: Pregunta[];
  title: string;
  lead?: string;
}

const { faqs, title, lead } = Astro.props;
---

<section class="section pt-0">
  <div class="container">
    <div class="row justify-center">
      <div class="lg:col-9">
        <h2 class="h3 font-bold mb-3 text-center" data-aos="fade-up-sm">{title}</h2>
        {lead && <p class="text-center mb-10 text-dark/62" data-aos="fade-up-sm">{lead}</p>}
        <div class="space-y-4">
          {
            faqs.map((f, i) => (
              <details class="group rounded-2xl border border-dark/10 bg-body p-5" data-aos="fade-up-sm" data-aos-delay={Math.min(i * 50, 300)}>
                <summary class="cursor-pointer list-none flex items-start justify-between gap-4">
                  <h3 class="h6 font-bold leading-snug">{f.q}</h3>
                  <span class="text-primary text-xl leading-none mt-0.5 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <p class="mt-4 text-sm leading-relaxed text-dark/70">{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
