---
import DynamicIcon from "@/helpers/DynamicIcon";
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";

const { content } = Astro.props;

const pricing = (await getEntry(
  "pricingSection",
  "pricing",
)) as CollectionEntry<"pricingSection">;

let { title, badge, description, plans, plans_labels, help_cta, server_note } =
  pricing.data;

// Override default blog data (Title, Subtitle & Description) with props if provided
if (content) {
  ({ title, badge, description } = content);
}

const {
  isSection = true,
  compact = false,
}: { isSection?: boolean; compact?: boolean } = Astro.props;
---

{
  (
    <section class={`${isSection ? "section pt-0" : ""}`}>
      <div class="container">
        <div class="row">
          {Astro.url.pathname !== "/pricing" && (
            <div class="section-title">
              <div class="col-10 xl:col-8" data-aos="fade-up-sm">
                <p set:html={markdownify(badge)} />
                <h2 set:html={markdownify(title)} />
                <p set:html={markdownify(description)} />
              </div>
            </div>
          )}

          <div class="col-12">
            <div class="row g-4 justify-center">
              <div
                class="col-12 pb-10"
                data-aos="fade-up-sm"
                data-aos-delay="200"
              >
                <div class="flex items-center justify-center gap-x-3">
                  {plans_labels.map((plan, index) => (
                    <span
                      class={`select-none font-medium ${index === 0 ? "order-0" : "order-3"}`}
                      set:html={markdownify(plan)}
                    />
                  ))}
                  <label class="relative inline-block h-8 w-16 cursor-pointer order-1 rounded-full bg-dark/10">
                    <span class="sr-only">Pricing Switcher</span>
                    <input
                      type="checkbox"
                      id="checkbox"
                      class="pricing-check peer absolute inset-0 z-10 h-full w-full cursor-pointer opacity-0"
                    />
                    <span class="pointer-events-none absolute inset-0 before:absolute before:left-1 before:top-1 before:h-6 before:w-6 before:translate-x-0 before:rounded-full before:bg-primary before:transition-all before:delay-75 before:duration-300 peer-checked:before:translate-x-8" />
                  </label>
                </div>
              </div>

              {plans?.map((item, index) => (
                <div
                  class="col-11 md:col-6 lg:col-4"
                  data-aos="fade-up-sm"
                  data-aos-delay={200 + index * 150}
                >
                  <div
                    class={`${(index + 1) % 2 === 0 ? "has-dark-bg bg-dark text-text-light" : "bg-light"} group mb-12 flex min-h-full flex-col items-start gap-8 rounded-xl px-8 py-12 last:mb-0 md:gap-12 md:rounded-[30px] md:px-11`}
                  >
                    <div class="flex flex-wrap items-center gap-4">
                      {item.title && (
                        <h3 class="counter h5 group-[.has-dark-bg]:text-text-light">
                          <span>{markdownify(item.title)}</span>
                        </h3>
                      )}
                      {item.badge?.enable && (
                        <span
                          class="rounded-full bg-body px-5 py-1.5 font-medium text-text-dark"
                          set:html={markdownify(item.badge.label)}
                        />
                      )}
                    </div>
                    {item.description && (
                      <p
                        class="text-lg/[inherit]"
                        set:html={markdownify(item.description)}
                      />
                    )}
                    <div class="flex flex-col gap-1">
                      <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                        {item.price_monthly && item.price_yearly && (
                          <strong class="h2 whitespace-nowrap group-[.has-dark-bg]:text-text-light">
                            {markdownify(item.price_prefix)}
                            <span
                              class="data-count"
                              data-count-yearly={item.price_yearly}
                              data-count-monthly={item.price_monthly}
                              set:html={markdownify(item.price_monthly)}
                            />
                            {item.price_suffix}
                          </strong>
                        )}
                        {item.price_description_monthly &&
                          item.price_description_yearly && (
                            <>
                              <span
                                class="text-monthly text-lg/[inherit] group-[.has-dark-bg]:text-text-light"
                                set:html={markdownify(
                                  item.price_description_monthly,
                                )}
                              />
                              <span
                                class="text-yearly hidden text-lg/[inherit] group-[.has-dark-bg]:text-text-light"
                                set:html={markdownify(
                                  item.price_description_yearly,
                                )}
                              />
                            </>
                          )}
                      </div>
                      {item.price_monthly &&
                        item.price_monthly !== "Personalizado" && (
                          <p class="text-sm opacity-40 group-[.has-dark-bg]:text-text-light">
                            * No incluye IVA
                          </p>
                        )}
                    </div>

                    {!compact && item.features && (
                      <ul
                        class={`list ${(index + 1) % 2 === 0 ? "list-dark " : "list-tertiary"}`}
                      >
                        {item.features.map((feature) => (
                          <li
                            class="mb-2 text-lg/[inherit]"
                            set:html={markdownify(feature)}
                          />
                        ))}
                      </ul>
                    )}

                    {!compact && item.button && item.button.enable && (
                      <a
                        class={`${(index + 1) % 2 === 0 ? "btn-light" : "btn-dark"} btn mt-auto`}
                        href={item.button.link}
                      >
                        {item.button.label}
                        <span class="icon-wrapper">
                          <span class="icon">
                            <DynamicIcon icon={"FaArrowRight"} />
                          </span>
                          <span class="icon" aria-hidden="true">
                            <DynamicIcon icon={"FaArrowRight"} />
                          </span>
                        </span>
                      </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
            {compact && (
              <div class="col-12 mt-8 text-center" data-aos="fade-up-sm">
                <a class="btn btn-dark" href="/pricing">
                  Ver todos los detalles
                  <span class="icon-wrapper">
                    <span class="icon">
                      <DynamicIcon icon={"FaArrowRight"} />
                    </span>
                    <span class="icon" aria-hidden="true">
                      <DynamicIcon icon={"FaArrowRight"} />
                    </span>
                  </span>
                </a>
              </div>
            )}
            {!compact && server_note?.enable && (
              <div class="col-12 mt-12" data-aos="fade-up-sm">
                <div class="flex flex-col gap-4 rounded-3xl border border-dark/10 px-8 py-8 md:flex-row md:items-start md:gap-6 md:px-12">
                  <span class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary text-xl">
                    <DynamicIcon icon={"FaServer"} />
                  </span>
                  <div>
                    <h3 class="h5 mb-2" set:html={markdownify(server_note.title)} />
                    <p class="text-lg/[inherit] mb-3" set:html={markdownify(server_note.description)} />
                    <a class="font-medium text-primary underline underline-offset-4" href={server_note.link}>
                      {server_note.link_label}
                    </a>
                  </div>
                </div>
              </div>
            )}
            {!compact && help_cta?.enable && (
              <div
                class="col-12 mt-12"
                data-aos="fade-up-sm"
                data-aos-delay="300"
              >
                <div class="bg-light rounded-3xl px-8 py-10 md:px-12 md:py-12 text-center">
                  <h3 class="h4 mb-4" set:html={markdownify(help_cta.title)} />
                  <p
                    class="text-lg mb-6"
                    set:html={markdownify(help_cta.description)}
                  />
                  <a class="btn btn-dark" href={help_cta.button.link}>
                    {help_cta.button.label}
                    <span class="icon-wrapper">
                      <span class="icon">
                        <DynamicIcon icon={"FaArrowRight"} />
                      </span>
                      <span class="icon" aria-hidden="true">
                        <DynamicIcon icon={"FaArrowRight"} />
                      </span>
                    </span>
                  </a>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  // Los data-count-* llegan ya resueltos desde src/config/precios.json
  // ("19", "15,83"): se leen con coma decimal y se pintan igual.
  function leer(valor: string | null): number {
    return valor ? parseFloat(valor.replace(/\./g, "").replace(",", ".")) : NaN;
  }

  function pintar(n: number, decimales: boolean): string {
    return n.toLocaleString("es-ES", {
      minimumFractionDigits: decimales ? 2 : 0,
      maximumFractionDigits: decimales ? 2 : 0,
    });
  }

  function animar(el: HTMLElement, fin: number) {
    const decimales = fin % 1 !== 0;
    const duracion = 250;
    let inicio: number | null = null;
    function paso(t: number) {
      if (inicio === null) inicio = t;
      const progreso = Math.min((t - inicio) / duracion, 1);
      el.textContent = pintar(fin * progreso, decimales);
      if (progreso < 1) requestAnimationFrame(paso);
      else el.textContent = pintar(fin, decimales);
    }
    requestAnimationFrame(paso);
  }

  function aplicar(anual: boolean) {
    document.querySelectorAll<HTMLElement>(".data-count").forEach((el) => {
      const texto = el.getAttribute(
        anual ? "data-count-yearly" : "data-count-monthly",
      );
      const n = leer(texto);
      if (isNaN(n)) el.textContent = texto ?? "";
      else animar(el, n);
    });
    document
      .querySelectorAll(".text-yearly")
      .forEach((el) => el.classList.toggle("hidden", !anual));
    document
      .querySelectorAll(".text-monthly")
      .forEach((el) => el.classList.toggle("hidden", anual));
  }

  function pricingInit() {
    const toggle = document.querySelector<HTMLInputElement>(".pricing-check");
    if (!toggle || toggle.dataset.listo) return;
    toggle.dataset.listo = "1";
    toggle.addEventListener("change", () => aplicar(toggle.checked));
    // Si el navegador restauró el checkbox marcado (atrás/adelante).
    if (toggle.checked) aplicar(true);
  }

  // En dev el script puede cargar después de astro:page-load; se arranca
  // también en el acto. El data-listo evita enlazarlo dos veces.
  pricingInit();
  document.addEventListener("astro:page-load", pricingInit);
</script>
