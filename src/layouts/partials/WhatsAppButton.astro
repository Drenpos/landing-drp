---
// ════════════════════════════════════════════════════════════════════════
//  WhatsAppButton · botón flotante de contacto
//  Va en Base.astro, justo antes del cierre del body, así que aparece en
//  todas las páginas. El clic lo mide el script global de atribución
//  (evento "whatsapp_click" en dataLayer), no hace falta nada aquí.
//  En móvil sube a 88 px para no tapar los CTA que quedan al pie.
// ════════════════════════════════════════════════════════════════════════
const WHATSAPP_URL =
  "https://wa.me/34640315259?text=Hola%2C%20quiero%20informaci%C3%B3n%20sobre%20Drenpos";
---

<a
  class="dp-whatsapp-fab"
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener"
  aria-label="Escríbenos por WhatsApp"
  title="Escríbenos por WhatsApp"
>
  <svg
    width="30"
    height="30"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35Z"
    ></path>
    <path
      d="M12.04 2.5c-5.24 0-9.5 4.26-9.5 9.5 0 1.67.44 3.3 1.27 4.74L2.5 21.5l4.9-1.28a9.46 9.46 0 0 0 4.64 1.2h.01c5.23 0 9.49-4.26 9.49-9.5 0-2.54-.99-4.92-2.78-6.71a9.42 9.42 0 0 0-6.72-2.71Zm5.57 15.07a7.87 7.87 0 0 1-5.57 2.31h-.01c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a7.85 7.85 0 0 1-1.21-4.2c0-4.35 3.55-7.89 7.9-7.89 2.11 0 4.09.82 5.58 2.31a7.83 7.83 0 0 1 2.31 5.59c0 4.35-3.55 7.89-7.9 7.89Z"
    ></path>
  </svg>
</a>

<style is:global>
  .dp-whatsapp-fab {
    position: fixed;
    right: 20px;
    bottom: 88px;
    z-index: 40;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 9999px;
    background: #25d366;
    color: #fff;
    box-shadow:
      0 10px 30px rgba(37, 211, 102, 0.35),
      0 2px 8px rgba(0, 0, 0, 0.15);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .dp-whatsapp-fab:hover,
  .dp-whatsapp-fab:focus-visible {
    transform: scale(1.06);
    box-shadow:
      0 14px 36px rgba(37, 211, 102, 0.45),
      0 3px 10px rgba(0, 0, 0, 0.18);
  }

  .dp-whatsapp-fab:focus-visible {
    outline: 3px solid #101928;
    outline-offset: 3px;
  }

  @media (min-width: 992px) {
    .dp-whatsapp-fab {
      right: 24px;
      bottom: 24px;
    }
  }

  @media print {
    .dp-whatsapp-fab {
      display: none;
    }
  }
</style>
