---
// Adornos del tema "halloween" (src/config/temas.json). Solo se ven con
// html[data-tema="halloween"]; prueba con ?tema=halloween.
const murcielagos = [
  { right: "6%", top: "86px", size: 34, delay: "0s" },
  { right: "13%", top: "118px", size: 24, delay: "-1.2s" },
  { right: "20%", top: "92px", size: 18, delay: "-2.1s" },
];
---

<div class="tema-halloween pointer-events-none absolute inset-x-0 top-0 z-30 h-0 overflow-visible">
  {
    murcielagos.map((m) => (
      <svg
        class="murcielago absolute hidden text-dark/80 sm:block"
        style={`right:${m.right};top:${m.top};width:${m.size}px;animation-delay:${m.delay}`}
        viewBox="0 0 64 32"
        fill="currentColor"
      >
        <path d="M32 9c1.5-3 3-4 3-4s.5 3 0 5c4-3 10-4 14-2-3 1-4 3-4 5 3-1 7 0 10 2-4 0-7 2-9 5-2-2-5-3-8-2-2 1-4 4-6 7-2-3-4-6-6-7-3-1-6 0-8 2-2-3-5-5-9-5 3-2 7-3 10-2 0-2-1-4-4-5 4-2 10-1 14 2-.5-2 0-5 0-5s1.5 1 3 4z" />
      </svg>
    ))
  }
</div>

<style>
  .murcielago {
    animation: aleteo 3.2s ease-in-out infinite;
    transform-origin: 50% 0;
  }
  @keyframes aleteo {
    0%, 100% { transform: translateY(0) rotate(-4deg); }
    50% { transform: translateY(8px) rotate(4deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .murcielago { animation: none; }
  }
</style>
